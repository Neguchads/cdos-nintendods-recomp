+bool parse_bool_ini(const std::string& val, bool* out) {
+    const std::string n = lower_trim_token(val);
+    if (n == "1" || n == "true" || n == "on" || n == "yes") {
+        *out = true;
+        return true;
+    }
+    if (n == "0" || n == "false" || n == "off" || n == "no") {
+        *out = false;
+        return true;
+    }
+    return false;
+}
+
+bool parse_int_range(const std::string& val, int lo, int hi, int* out) {
+    char* end = nullptr;
+    const long v = std::strtol(val.c_str(), &end, 10);
+    if (!end || *end != '\0' || v < lo || v > hi) return false;
+    *out = static_cast<int>(v);
+    return true;
+}
+
+const char* layout_to_ini_name(NdsScreenLayout layout) {
+    switch (layout) {
+        case NdsScreenLayout::Separate: return "separate";
+        case NdsScreenLayout::PictureInPicture: return "pip";
+        case NdsScreenLayout::BottomOnly: return "bottom-only";
+        case NdsScreenLayout::TopOnly: return "top-only";
+        case NdsScreenLayout::SideBySide: return "side-by-side";
+        case NdsScreenLayout::SideBySideBig: return "side-by-side-big";
+        default: return "stacked";
+    }
+}
+
+bool layout_from_ini_name(const std::string& val, NdsScreenLayout* out) {
+    const std::string n = lower_trim_token(val);
+    if (n == "stacked") *out = NdsScreenLayout::Stacked;
+    else if (n == "separate") *out = NdsScreenLayout::Separate;
+    else if (n == "pip") *out = NdsScreenLayout::PictureInPicture;
+    else if (n == "bottom-only" || n == "bottom") *out = NdsScreenLayout::BottomOnly;
+    else if (n == "top-only" || n == "top") *out = NdsScreenLayout::TopOnly;
+    else if (n == "side-by-side" || n == "horizontal") *out = NdsScreenLayout::SideBySide;
+    else if (n == "side-by-side-big" || n == "hybrid") *out = NdsScreenLayout::SideBySideBig;
+    else return false;
+    return true;
+}
+
+bool corner_from_ini_name(const std::string& val, NdsPipCorner* out) {
+    const std::string n = lower_trim_token(val);
+    if (n == "top-left") *out = NdsPipCorner::TopLeft;
+    else if (n == "top-right") *out = NdsPipCorner::TopRight;
+    else if (n == "bottom-left") *out = NdsPipCorner::BottomLeft;
+    else if (n == "bottom-right") *out = NdsPipCorner::BottomRight;
+    else return false;
+    return true;
+}
+
+const char* corner_to_ini_name(NdsPipCorner corner) {
+    switch (corner) {
+        case NdsPipCorner::TopLeft: return "top-left";
+        case NdsPipCorner::TopRight: return "top-right";
+        case NdsPipCorner::BottomLeft: return "bottom-left";
+        default: return "bottom-right";
+    }
+}
