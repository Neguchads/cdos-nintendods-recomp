+bool ensure_screen_texture(FrontendPresentation& presentation, int screen,
+                           int w, int h, bool linear) {
+    SDL_Renderer* renderer = presentation.renderers[screen];
+    if (!renderer || w <= 0 || h <= 0) return false;
+    if (!presentation.textures[screen] ||
+        presentation.texture_widths[screen] != w ||
+        presentation.texture_heights[screen] != h) {
+        if (presentation.textures[screen]) {
+            SDL_DestroyTexture(presentation.textures[screen]);
+            presentation.textures[screen] = nullptr;
+        }
+        presentation.textures[screen] = SDL_CreateTexture(
+            renderer, SDL_PIXELFORMAT_ARGB8888, SDL_TEXTUREACCESS_STREAMING, w, h);
+        if (!presentation.textures[screen]) return false;
+        presentation.texture_widths[screen] = w;
+        presentation.texture_heights[screen] = h;
+        presentation.force_upload[screen] = true;
+    }
+    return set_texture_scale_mode(presentation.textures[screen], linear);
+}
+
+bool ensure_hud_texture(FrontendPresentation& presentation,
+                        SDL_Renderer* renderer, int w, int h) {
+    if (!renderer || w <= 0 || h <= 0) return false;
+    int tw = 0, th = 0;
+    if (presentation.hud_texture) {
+#if defined(NDS_HAVE_SDL3)
+        float fw = 0.0f, fh = 0.0f;
+        SDL_GetTextureSize(presentation.hud_texture, &fw, &fh);
+        tw = static_cast<int>(fw);
+        th = static_cast<int>(fh);
+#else
+        SDL_QueryTexture(presentation.hud_texture, nullptr, nullptr, &tw, &th);
+#endif
+        if (tw != w || th != h) {
+            SDL_DestroyTexture(presentation.hud_texture);
+            presentation.hud_texture = nullptr;
+            presentation.hud_uploaded_revision = 0;
+        }
+    }
+    if (!presentation.hud_texture) {
+        presentation.hud_texture = SDL_CreateTexture(
+            renderer, SDL_PIXELFORMAT_ARGB8888, SDL_TEXTUREACCESS_STREAMING, w, h);
+        if (!presentation.hud_texture) return false;
+        SDL_SetTextureBlendMode(presentation.hud_texture, SDL_BLENDMODE_BLEND);
+        set_texture_scale_mode(presentation.hud_texture, true);
+        presentation.hud_uploaded_revision = 0;
+    }
+    return true;
+}
