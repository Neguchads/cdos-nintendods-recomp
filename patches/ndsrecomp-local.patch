+template <typename EnumT, size_t N>
+int find_enum_index(const std::array<EnumT, N>& table, EnumT v, int fallback = 0) {
+    for (size_t i = 0; i < N; ++i) {
+        if (table[i] == v) return static_cast<int>(i);
+    }
+    return fallback;
+}
+
+template <typename EnumT, size_t N>
+bool combo_enum(const char* label, EnumT* value, const std::array<EnumT, N>& table,
+                const std::array<DosStrId, N>& names, DosLanguage lang) {
+    int idx = find_enum_index(table, *value);
+    const char* preview = dos_tr(lang, names[static_cast<size_t>(idx)]);
+    bool changed = false;
+    if (ImGui::BeginCombo(label, preview)) {
+        for (size_t i = 0; i < N; ++i) {
+            const bool selected = (static_cast<int>(i) == idx);
+            if (ImGui::Selectable(dos_tr(lang, names[i]), selected)) {
+                if (table[i] != *value) {
+                    *value = table[i];
+                    changed = true;
+                }
+            }
+            if (selected) ImGui::SetItemDefaultFocus();
+        }
+        ImGui::EndCombo();
+    }
+    return changed;
+}
+
+bool contains_icase(const char* haystack, const char* needle) {
+    if (!haystack || !needle) return false;
+    const std::string h(haystack);
+    const std::string n(needle);
+    auto it = std::search(h.begin(), h.end(), n.begin(), n.end(),
+                          [](unsigned char a, unsigned char b) {
+                              return std::tolower(a) == std::tolower(b);
+                          });
+    return it != h.end();
+}
