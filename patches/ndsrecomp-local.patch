+
+bool dos_intro_validate_mp4_file(const std::string& path, std::string* error_out) {
+    if (path.empty()) {
+        if (error_out) *error_out = "intro video path is empty";
+        return false;
+    }
+    std::error_code ec;
+    if (!std::filesystem::is_regular_file(path, ec)) {
+        if (error_out) *error_out = "intro video file not found";
+        return false;
+    }
+    std::ifstream in(path, std::ios::binary);
+    if (!in) {
+        if (error_out) *error_out = "could not open intro video file";
+        return false;
+    }
+    char header[12]{};
+    in.read(header, sizeof(header));
+    if (in.gcount() < 12 || std::memcmp(header + 4, "ftyp", 4) != 0) {
+        if (error_out) *error_out = "file is not a valid MP4 (missing ftyp box)";
+        return false;
+    }
+    return true;
+}
+
+#if defined(_WIN32) && defined(NDS_HAVE_SDL3)
