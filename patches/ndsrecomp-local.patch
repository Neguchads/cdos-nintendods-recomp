+    if (opt->dos.aspect_mode == DosAspectMode::SmartCrop16x9) {
+        int crop_y = static_cast<int>(opt->dos.widescreen_crop_offset_y);
+        if (ImGui::SliderInt(dos_tr(lang, DosStrId::LblWidescreenCropY), &crop_y, -24, 24, "%+d px")) {
+            opt->dos.widescreen_crop_offset_y = static_cast<int8_t>(crop_y);
+            mark_dirty(ctx, true);
