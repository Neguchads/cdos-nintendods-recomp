+void test_frame_processor() {
+    std::vector<uint32_t> src(64 * 64, 0xFF102030u);
+    for (int y = 8; y < 56; ++y) {
+        src[y * 64 + y] = 0xFFF0D0A0u;
+        src[y * 64 + (63 - y)] = 0xFF40C0FFu;
+    }
+
+    DosFrameProcessor proc;
+    int ow = 0, oh = 0;
+
+    // Fast bypass returns exact source pointer.
+    const uint32_t* bypass = proc.process(src.data(), 64, 64,
+                                          DosHdFilter::Nearest, DosColorMode::Native,
+                                          DosSharpenMode::Off, DosPostFx::Off,
+                                          &ow, &oh);
+    assert(bypass == src.data() && ow == 64 && oh == 64);
+
+    for (DosHdFilter f : {DosHdFilter::SharpBilinear, DosHdFilter::Scale2x, DosHdFilter::Xbr2x}) {
+        const uint32_t* out = proc.process(src.data(), 64, 64, f,
+                                           DosColorMode::VividHd, DosSharpenMode::Subtle,
+                                           DosPostFx::ScanlinesLight, &ow, &oh);
+        assert(out != nullptr && out != src.data());
+        assert(ow == 128 && oh == 128);
+        assert((out[0] & 0xFF000000u) == 0xFF000000u);
+        assert(out[10 * 128 + 10] != out[11 * 128 + 10]);  // scanlines modulate odd rows
+    }
+
+    // Tiny edge-case frame 1x1 must not crash.
+    uint32_t single = 0xFF804020u;
+    uint32_t* mut = proc.process_mutable(&single, 1, 1, DosHdFilter::Xbr2x,
+                                         DosColorMode::DsAuthentic, DosSharpenMode::Strong,
+                                         DosPostFx::Crt, &ow, &oh);
+    assert(mut != nullptr && ow == 2 && oh == 2);
+}
