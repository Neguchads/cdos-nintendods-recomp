+// Parser simples para music.json opcional:
+// {
+//   "jukebox": { "enabled": false, "shuffle": false, "playlist": ["rock.mp3"] },
+//   "tracks": { "11": { "file": "remix.ogg", "loop": true, "loop_start_ms": -1, "loop_end_ms": -1, "gain_db": 0.0 } }
+// }
+void parse_optional_music_manifest(
+    const fs::path& music_dir,
+    std::unordered_map<uint8_t, DosCustomTrackBinding>* manifest_tracks,
+    std::unordered_map<uint8_t, DosCustomTrackBinding>* bindings,
+    JukeboxManifestConfig* jukebox_out) {
+    const fs::path manifest = music_dir / "music.json";
+    std::error_code ec;
+    if (!fs::is_regular_file(manifest, ec)) return;
+    std::ifstream in(manifest, std::ios::binary);
+    if (!in) return;
+    std::ostringstream ss;
+    ss << in.rdbuf();
+    const std::string text = ss.str();
+
+    auto make_reader = [&](size_t start_pos) {
+        return start_pos;
+    };
+    (void)make_reader;
+
+    auto skip_ws_at = [&](size_t& pos) {
+        while (pos < text.size() && (std::isspace(static_cast<unsigned char>(text[pos])) ||
+                                     text[pos] == ',' || text[pos] == ':')) {
+            ++pos;
+        }
+    };
+    auto read_str_at = [&](size_t& pos, std::string* dst) -> bool {
+        skip_ws_at(pos);
+        if (pos >= text.size() || text[pos] != '"') return false;
+        ++pos;
+        dst->clear();
+        while (pos < text.size() && text[pos] != '"') {
+            if (text[pos] == '\\' && pos + 1 < text.size()) ++pos;
+            dst->push_back(text[pos++]);
+        }
+        if (pos < text.size() && text[pos] == '"') ++pos;
+        return true;
+    };
+
+    // 1. Secao opcional "jukebox"
+    if (jukebox_out) {
+        size_t jpos = text.find("\"jukebox\"");
+        if (jpos != std::string::npos) {
+            jpos = text.find('{', jpos);
+            if (jpos != std::string::npos) {
+                ++jpos;
+                jukebox_out->present = true;
+                while (jpos < text.size()) {
+                    skip_ws_at(jpos);
+                    if (jpos >= text.size() || text[jpos] == '}') {
+                        if (jpos < text.size()) ++jpos;
+                        break;
+                    }
+                    std::string k;
+                    if (!read_str_at(jpos, &k)) break;
+                    skip_ws_at(jpos);
+                    if (jpos >= text.size()) break;
+                    if (text.compare(jpos, 4, "true") == 0) {
+                        jpos += 4;
+                        if (k == "enabled") jukebox_out->enabled = true;
+                        else if (k == "shuffle") jukebox_out->shuffle = true;
+                    } else if (text.compare(jpos, 5, "false") == 0) {
+                        jpos += 5;
+                        if (k == "enabled") jukebox_out->enabled = false;
+                        else if (k == "shuffle") jukebox_out->shuffle = false;
+                    } else if (text[jpos] == '[') {
+                        ++jpos;
+                        while (jpos < text.size()) {
+                            skip_ws_at(jpos);
+                            if (jpos >= text.size() || text[jpos] == ']') {
+                                if (jpos < text.size()) ++jpos;
+                                break;
+                            }
+                            std::string item;
+                            if (!read_str_at(jpos, &item)) {
+                                ++jpos;
+                                continue;
+                            }
+                            if (k == "playlist" && is_safe_rel_music_path(item) &&
+                                has_supported_audio_ext(item)) {
+                                const fs::path full = music_dir / item;
+                                if (fs::is_regular_file(full, ec)) {
+                                    if (std::find(jukebox_out->playlist.begin(),
+                                                  jukebox_out->playlist.end(),
+                                                  item) == jukebox_out->playlist.end()) {
+                                        jukebox_out->playlist.push_back(item);
+                                    }
+                                }
+                            }
+                        }
+                    } else if (text[jpos] == '"') {
+                        std::string dummy;
+                        read_str_at(jpos, &dummy);
+                    } else {
+                        ++jpos;
+                    }
+                }
+            }
+        }
+    }
+
+    // 2. Secao opcional "tracks": { key: { ... } }
+    size_t pos = text.find("\"tracks\"");
+    if (pos == std::string::npos) return;
+    pos = text.find('{', pos);
+    if (pos == std::string::npos) return;
+    ++pos;
+
+    while (pos < text.size()) {
+        skip_ws_at(pos);
+        if (pos >= text.size() || text[pos] == '}') break;
+        std::string track_key;
+        if (!read_str_at(pos, &track_key)) break;
+        skip_ws_at(pos);
+        if (pos >= text.size() || text[pos] != '{') break;
+        ++pos;
+
+        const int tid = dos_bgm_find_track_by_key(track_key);
+        std::string rel_file;
+        bool loop = (tid >= 0) ? kBgmCatalog[static_cast<size_t>(tid)].default_loop : true;
+        int64_t loop_start_ms = -1;
+        int64_t loop_end_ms = -1;
+        float gain_db = 0.0f;
+
+        while (pos < text.size()) {
+            skip_ws_at(pos);
+            if (pos >= text.size() || text[pos] == '}') {
+                if (pos < text.size()) ++pos;
+                break;
+            }
+            std::string k;
+            if (!read_str_at(pos, &k)) break;
+            skip_ws_at(pos);
+            if (pos >= text.size()) break;
+            if (text[pos] == '"') {
+                std::string val;
+                read_str_at(pos, &val);
+                if (k == "file") rel_file = val;
+            } else if (text.compare(pos, 4, "true") == 0) {
+                pos += 4;
+                if (k == "loop") loop = true;
+            } else if (text.compare(pos, 5, "false") == 0) {
+                pos += 5;
+                if (k == "loop") loop = false;
+            } else {
+                const size_t start = pos;
+                while (pos < text.size() &&
+                       (std::isdigit(static_cast<unsigned char>(text[pos])) ||
+                        text[pos] == '-' || text[pos] == '+' || text[pos] == '.')) {
+                    ++pos;
+                }
+                if (pos > start) {
+                    const double num = std::atof(text.substr(start, pos - start).c_str());
+                    if (k == "loop_start_ms") loop_start_ms = static_cast<int64_t>(num);
+                    else if (k == "loop_end_ms") loop_end_ms = static_cast<int64_t>(num);
+                    else if (k == "gain_db") gain_db = static_cast<float>(std::clamp(num, -24.0, 12.0));
+                } else {
+                    ++pos;
+                }
+            }
+        }
+
+        if (tid >= 0 && is_safe_rel_music_path(rel_file) && has_supported_audio_ext(rel_file)) {
+            const fs::path full = music_dir / rel_file;
+            if (fs::is_regular_file(full, ec)) {
+                DosCustomTrackBinding b{};
+                b.track_id = static_cast<uint8_t>(tid);
+                b.file_path = full.string();
+                b.file_label = rel_file;
+                b.loop = loop;
+                b.loop_start_ms = loop_start_ms;
+                b.loop_end_ms = loop_end_ms;
+                b.gain_db = gain_db;
+                b.gain_linear = std::pow(10.0f, gain_db / 20.0f);
+                if (manifest_tracks) (*manifest_tracks)[b.track_id] = b;
+                if (bindings) (*bindings)[b.track_id] = std::move(b);
+            }
+        }
+    }
+}
+
+struct CustomMusicEngine {
+    std::mutex mu;
+    std::string music_dir;
+    bool enabled = true;
+    std::vector<std::string> available_files;
+    std::unordered_map<uint8_t, DosCustomTrackBinding> auto_bindings;
+    std::unordered_map<uint8_t, DosCustomTrackBinding> manifest_tracks;
+    std::unordered_map<uint8_t, DosCustomTrackBinding> bindings;
+
+    bool jukebox_enabled = false;
+    bool jukebox_shuffle = false;
+    std::vector<std::string> jukebox_playlist;
+    size_t jukebox_index = 0;
+    std::atomic<bool> jukebox_advance_pending{false};
+    std::mt19937 rng{0xC05D0516u};
+
+    int active_bgm_id = -1;
+    int active_bgm_player_slot = -1;  // Slot dinamico de hardware player (0..15) alocado pelo Nitro SDK
+    bool active_playing = false;
+    bool guest_paused = false;
+    bool host_paused = false;
+    float game_fade_gain = 1.0f;
+
+    DosCustomTrackBinding current_binding{};
+    DosDecodedAudio decoded{};
+    size_t play_frame = 0;
+    bool finished = false;
+    std::string loaded_path;
+};
+
+CustomMusicEngine g_music;
+
+std::string format_bgm_label(int id) {
+    if (id < 0 || id >= static_cast<int>(kDosBgmTrackCount)) return "";
+    const auto& info = kBgmCatalog[static_cast<size_t>(id)];
+    char buf[128]{};
+    std::snprintf(buf, sizeof(buf), "#%02u %s (%s)",
+                  static_cast<unsigned>(info.id), info.display_name, info.sdat_name);
+    return std::string(buf);
+}
+
+bool jukebox_active_locked() {
+    return g_music.enabled && g_music.jukebox_enabled && !g_music.jukebox_playlist.empty();
+}
+
+void rebuild_effective_bindings_locked() {
+    g_music.bindings = g_music.auto_bindings;
+    for (const auto& kv : g_music.manifest_tracks) {
+        g_music.bindings[kv.first] = kv.second;
+    }
+}
+
+bool save_music_manifest_locked() {
+    if (g_music.music_dir.empty()) return false;
+    std::ostringstream ss;
+    ss << "{\n";
+    ss << "  \"jukebox\": {\n";
+    ss << "    \"enabled\": " << (g_music.jukebox_enabled ? "true" : "false") << ",\n";
+    ss << "    \"shuffle\": " << (g_music.jukebox_shuffle ? "true" : "false") << ",\n";
+    ss << "    \"playlist\": [";
+    for (size_t i = 0; i < g_music.jukebox_playlist.size(); ++i) {
+        if (i > 0) ss << ", ";
+        ss << "\"" << json_escape(g_music.jukebox_playlist[i]) << "\"";
+    }
+    ss << "]\n";
+    ss << "  },\n";
+    ss << "  \"tracks\": {";
+    std::map<uint8_t, DosCustomTrackBinding> sorted_tracks(
+        g_music.manifest_tracks.begin(), g_music.manifest_tracks.end());
+    bool first = true;
+    for (const auto& kv : sorted_tracks) {
+        const auto& b = kv.second;
+        if (!first) ss << ",";
+        first = false;
+        char idbuf[8]{};
+        std::snprintf(idbuf, sizeof(idbuf), "%02u", static_cast<unsigned>(b.track_id));
+        ss << "\n    \"" << idbuf << "\": {\n";
+        ss << "      \"file\": \"" << json_escape(b.file_label) << "\",\n";
+        ss << "      \"loop\": " << (b.loop ? "true" : "false") << ",\n";
+        ss << "      \"loop_start_ms\": " << b.loop_start_ms << ",\n";
+        ss << "      \"loop_end_ms\": " << b.loop_end_ms << ",\n";
+        ss << "      \"gain_db\": " << std::fixed << std::setprecision(2) << b.gain_db << "\n";
+        ss << "    }";
+    }
+    if (!sorted_tracks.empty()) ss << "\n  ";
+    ss << "}\n";
+    ss << "}\n";
+    return atomic_write_text_file(fs::path(g_music.music_dir) / "music.json", ss.str());
+}
+
+bool load_and_start_binding_locked(const DosCustomTrackBinding& bind, bool start_now, const char* reason_label) {
+    if (g_music.loaded_path != bind.file_path) {
+        DosDecodedAudio dec{};
+        std::string err;
+        if (!dos_custom_music_decode_file(bind.file_path, &dec, &err)) {
+            std::fprintf(stderr, "[custom-music] failed to decode %s: %s\n",
+                         bind.file_path.c_str(), err.c_str());
+            g_music.active_playing = false;
+            return false;
+        }
+        if (bind.loop_start_ms >= 0) {
+            dec.loop_start_frame = static_cast<size_t>(
+                (static_cast<double>(bind.loop_start_ms) / 1000.0) * kDosSpuSampleRate);
+        }
+        if (bind.loop_end_ms > 0) {
+            dec.loop_end_frame = static_cast<size_t>(
+                (static_cast<double>(bind.loop_end_ms) / 1000.0) * kDosSpuSampleRate);
+        }
+        const size_t total_frames = dec.pcm_stereo_32768.size() / 2u;
+        if (dec.loop_end_frame > total_frames) dec.loop_end_frame = total_frames;
+        if (dec.loop_start_frame >= total_frames) dec.loop_start_frame = 0;
+        if (dec.loop_end_frame > 0 && dec.loop_end_frame <= dec.loop_start_frame) {
+            dec.loop_start_frame = 0;
+            dec.loop_end_frame = 0;
+        }
+        g_music.decoded = std::move(dec);
+        g_music.loaded_path = bind.file_path;
+    }
+
+    g_music.current_binding = bind;
+    g_music.play_frame = 0;
+    g_music.finished = false;
+    g_music.guest_paused = false;
+    g_music.active_playing = start_now;
+    g_music.game_fade_gain = 1.0f;
+    if (start_now) {
+        std::fprintf(stderr, "[custom-music] playing %s -> %s (frames=%zu loop=%s)\n",
+                     reason_label ? reason_label : "track",
+                     bind.file_label.c_str(),
+                     g_music.decoded.pcm_stereo_32768.size() / 2u,
+                     bind.loop ? "on" : "off");
+    }
+    return true;
+}
+
+bool start_jukebox_index_locked(size_t idx, bool keep_if_already_playing_same) {
+    g_music.jukebox_advance_pending.store(false, std::memory_order_relaxed);
+    if (!jukebox_active_locked() || g_music.music_dir.empty()) {
+        g_music.active_playing = false;
+        return false;
+    }
+    const size_t n = g_music.jukebox_playlist.size();
+    g_music.jukebox_index = idx % n;
+    const std::string& rel = g_music.jukebox_playlist[g_music.jukebox_index];
+    const fs::path full = fs::path(g_music.music_dir) / rel;
+    if (keep_if_already_playing_same && g_music.active_playing && !g_music.finished &&
+        g_music.loaded_path == full.string()) {
+        return true;
+    }
+    DosCustomTrackBinding b{};
+    b.track_id = 0xFFu;
+    b.file_path = full.string();
+    b.file_label = rel;
+    b.loop = (n == 1u);  // Musica unica na playlist faz loop continuo; 2+ musicas avancam na playlist
+    b.gain_db = 0.0f;
+    b.gain_linear = 1.0f;
+    return load_and_start_binding_locked(b, true, "jukebox");
+}
+
+void activate_track_locked(int tid, bool start_now) {
+    g_music.active_bgm_id = tid;
+    g_music.guest_paused = false;
+
+    if (!g_music.enabled) {
+        g_music.active_playing = false;
+        return;
+    }
+    if (jukebox_active_locked()) {
+        // No modo Jukebox Global, mantem a faixa atual da playlist fluindo sem reiniciar a cada sala.
+        start_jukebox_index_locked(g_music.jukebox_index, true);
+        return;
+    }
+
+    g_music.finished = false;
+    if (tid < 0) {
+        g_music.active_playing = false;
+        return;
+    }
+    const auto it = g_music.bindings.find(static_cast<uint8_t>(tid));
+    if (it == g_music.bindings.end()) {
+        g_music.active_playing = false;
+        return;
+    }
+
+    const std::string label = format_bgm_label(tid);
+    load_and_start_binding_locked(it->second, start_now, label.c_str());
+}
