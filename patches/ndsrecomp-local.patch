+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "dos_enhancements.h"
+#include "dos_mod_profile.h"
+
+enum class DosCompatState : uint8_t {
+    Verified = 0,
+    Unverified = 1,
+    Incompatible = 2,
+};
+
+struct DosModEntry {
+    std::string id;
+    std::string name;
+    std::string version = "1.0";
+    std::string kind;  // "baseline", "campaign", "character_pack"
+    std::string profile_file;
+    std::string author;
+    std::string summary;
+    std::string source_url;
+    std::string validation_level = "none";
+    std::string registry_state = "unverified";
+    std::string exclusive_group;
+    std::vector<std::string> allowed_character_packs;
+    std::vector<std::string> compatible_campaigns;
+    bool builtin = false;
+    bool manual_import = false;
+    bool supports_ptbr = false;
+    bool definitive_compatible = false;
+    bool installed = false;
+    std::string resolved_patch_path;
+};
+
+struct DosVerifiedCombo {
+    std::string campaign;
+    std::string character_pack;
+    std::string baseline;
+    std::string language;
+    std::string validation_level;
+};
+
+struct DosModRegistry {
+    std::string base_rom_sha1 = "47530ff87e608f88105a314fdf36dc385f8dec94";
+    std::string runtime_compat = "cdos-recomp-v1";
+    std::string registry_path;
+    std::string data_mods_dir;
+    std::vector<DosModEntry> baselines;
+    std::vector<DosModEntry> campaigns;
+    std::vector<DosModEntry> character_packs;
+    std::vector<DosVerifiedCombo> verified_combos;
+    bool loaded = false;
+};
+
+struct DosModSelection {
+    std::string campaign_id = "dawn-of-sorrow";
+    std::string character_pack_id = "default";
+    std::string baseline_id = "definitive";
+    DosLanguage language = DosLanguage::English;
+    bool allow_unverified = false;
+    std::string randomizer_seed;
+    std::string randomizer_preset = "standard";
+};
+
+struct DosConflictDecision {
+    DosCompatState state = DosCompatState::Incompatible;
+    bool allowed = false;
+    std::string reason;
+    std::string active_profile_id;
+    std::string active_profile_name;
+    std::string active_version = "1.0";
+    std::string patch_path;
+    std::string validation_level = "none";
+    bool uses_builtin_rom = false;
+};
+
+// Sanitizacao segura contra path traversal para IDs, versoes e seeds.
+std::string dos_mod_sanitize_id(const std::string& raw, const std::string& fallback = "");
+std::string dos_mod_sanitize_seed(const std::string& raw);
+std::string dos_mod_profile_namespace(const std::string& profile_id,
+                                      const std::string& version,
+                                      const std::string& modset_hash);
+
+// Escrita atomica segura (tmp + rename) para configs/metadados.
+bool dos_write_text_atomic(const std::string& path, const std::string& content);
+
+// Carrega {install}/mods/registry.json e inspeciona perfis instalados em {data}/mods/profiles/.
+bool dos_mod_registry_load(const std::string& registry_json_path,
+                           const std::string& data_mods_dir,
+                           DosModRegistry* out,
+                           std::string* error_out = nullptr);
+
+// Reescaneia {data}/mods/profiles/ sem alterar {install}/mods/registry.json.
+void dos_mod_registry_rescan_installed(DosModRegistry* reg);
+
+// Avalia combinacao pelo ConflictEngine de 3 estados (Verified / Unverified / Incompatible).
+DosConflictDecision dos_mod_resolve_conflict(const DosModRegistry& reg,
+                                             const DosModSelection& sel,
+                                             const std::string& base_rom_sha1,
+                                             const DosRomPatchSet& builtin_patches);
+
+// Constroi a ROM ativa em RAM a partir do registry + patches builtin ou DOSPATCH em {data}/mods/profiles/.
+bool dos_mod_build_rom_from_registry(const DosRomPatchSet& builtin_patches,
+                                     const DosModRegistry& reg,
+                                     const DosModSelection& sel,
+                                     const std::string& base_rom_sha1,
+                                     std::vector<uint8_t>* out_rom,
+                                     DosActiveRomSelection* active_out,
+                                     DosConflictDecision* decision_out = nullptr,
+                                     std::string* error_out = nullptr);
+
+// Isolamento de save e savestate por perfil, versao e hash (preserva caminhos do PR #15 para original/definitive).
+std::string dos_mod_isolated_save_path(const std::string& base_save_path,
+                                       const std::string& profile_id,
+                                       const std::string& version,
+                                       const std::string& modset_hash);
+
+std::string dos_mod_isolated_savestate_dir(const std::string& base_savestate_dir,
+                                           const std::string& profile_id,
+                                           const std::string& version,
+                                           const std::string& modset_hash);
diff --git a/runner/src/dos_postprocess.frag.hlsl b/runner/src/dos_postprocess.frag.hlsl
new file mode 100644
index 0000000..64423b8
--- /dev/null
+++ b/runner/src/dos_postprocess.frag.hlsl
@@ -0,0 +1,257 @@
+cbuffer DosShaderParams : register(b0, space3) {
+    float2 tex_size;
+    float2 inv_tex_size;
+    uint filter_mode;
+    uint color_mode;
+    uint sharpen_mode;
+    uint post_fx;
+    float brightness;
+    float contrast;
+    float saturation;
+    float vignette;
+};
+
+Texture2D u_texture : register(t0, space2);
+SamplerState u_sampler : register(s0, space2);
+
+struct PSInput {
+    float4 v_color : TEXCOORD0;
+    float2 v_uv : TEXCOORD1;
+};
+
+struct PSOutput {
+    float4 o_color : SV_Target;
+};
+
+static const float XBR_EQ_THRESHOLD = 15.0f;
+static const float XBR_LV2_COEFF = 2.0f;
+
+float4 fetch_px(float2 coord) {
+    float2 clamped = clamp(coord, float2(0.0f, 0.0f), tex_size - 1.0f);
+    return u_texture.SampleLevel(u_sampler, (clamped + 0.5f) * inv_tex_size, 0.0f);
+}
+
+float xbr_lum(float3 rgb) {
+    return dot(rgb, float3(0.299f, 0.587f, 0.114f)) * 255.0f;
+}
+
+float4 df4(float4 a, float4 b) {
+    return abs(a - b);
+}
+
+float4 eq4(float4 a, float4 b) {
+    return step(df4(a, b), XBR_EQ_THRESHOLD.xxxx);
+}
+
+float4 neq4(float4 a, float4 b) {
+    return 1.0f - eq4(a, b);
+}
+
+float4 diff4(float4 a, float4 b) {
+    return float4(a != b);
+}
+
+float4 wd4(float4 a, float4 b, float4 c, float4 d,
+           float4 e, float4 f, float4 g, float4 h) {
+    return df4(a, b) + df4(a, c) + df4(d, e) + df4(d, f) + 4.0f * df4(g, h);
+}
+
+float4 eval_xbr_lv2(float2 pix_coord, float2 grad_px) {
+    float2 p = floor(pix_coord);
+    float2 fp = frac(pix_coord);
+
+    float4 vA1 = fetch_px(p + float2(-1.0f, -2.0f));
+    float4 vB1 = fetch_px(p + float2( 0.0f, -2.0f));
+    float4 vC1 = fetch_px(p + float2( 1.0f, -2.0f));
+    float4 vA0 = fetch_px(p + float2(-2.0f, -1.0f));
+    float4 vA  = fetch_px(p + float2(-1.0f, -1.0f));
+    float4 vB  = fetch_px(p + float2( 0.0f, -1.0f));
+    float4 vC  = fetch_px(p + float2( 1.0f, -1.0f));
+    float4 vC4 = fetch_px(p + float2( 2.0f, -1.0f));
+    float4 vD0 = fetch_px(p + float2(-2.0f,  0.0f));
+    float4 vD  = fetch_px(p + float2(-1.0f,  0.0f));
+    float4 vE  = fetch_px(p);
+    float4 vF  = fetch_px(p + float2( 1.0f,  0.0f));
+    float4 vF4 = fetch_px(p + float2( 2.0f,  0.0f));
+    float4 vG0 = fetch_px(p + float2(-2.0f,  1.0f));
+    float4 vG  = fetch_px(p + float2(-1.0f,  1.0f));
+    float4 vH  = fetch_px(p + float2( 0.0f,  1.0f));
+    float4 vI  = fetch_px(p + float2( 1.0f,  1.0f));
+    float4 vI4 = fetch_px(p + float2( 2.0f,  1.0f));
+    float4 vG5 = fetch_px(p + float2(-1.0f,  2.0f));
+    float4 vH5 = fetch_px(p + float2( 0.0f,  2.0f));
+    float4 vI5 = fetch_px(p + float2( 1.0f,  2.0f));
+
+    if (all(vB.rgb == vE.rgb) && all(vH.rgb == vE.rgb) &&
+        all(vD.rgb == vE.rgb) && all(vF.rgb == vE.rgb)) {
+        return vE;
+    }
+
+    float lB = xbr_lum(vB.rgb), lD = xbr_lum(vD.rgb), lH = xbr_lum(vH.rgb), lF = xbr_lum(vF.rgb);
+    float lC = xbr_lum(vC.rgb), lA = xbr_lum(vA.rgb), lG = xbr_lum(vG.rgb), lI = xbr_lum(vI.rgb);
+    float lE = xbr_lum(vE.rgb);
+
+    float4 b = float4(lB, lD, lH, lF);
+    float4 c = float4(lC, lA, lG, lI);
+    float4 d = b.yzwx;
+    float4 e = lE.xxxx;
+    float4 f = b.wxyz;
+    float4 g = c.zwxy;
+    float4 h = b.zwxy;
+    float4 i = c.wxyz;
+
+    float4 i4 = float4(xbr_lum(vI4.rgb), xbr_lum(vC1.rgb), xbr_lum(vA0.rgb), xbr_lum(vG5.rgb));
+    float4 i5 = float4(xbr_lum(vI5.rgb), xbr_lum(vC4.rgb), xbr_lum(vA1.rgb), xbr_lum(vG0.rgb));
+    float4 h5 = float4(xbr_lum(vH5.rgb), xbr_lum(vF4.rgb), xbr_lum(vB1.rgb), xbr_lum(vD0.rgb));
+    float4 f4 = h5.yzwx;
+
+    float4 Ao = float4(1.0f, -1.0f, -1.0f,  1.0f);
+    float4 Bo = float4(1.0f,  1.0f, -1.0f, -1.0f);
+    float4 Co = float4(1.5f,  0.5f, -0.5f,  0.5f);
+    float4 Ax = float4(1.0f, -1.0f, -1.0f,  1.0f);
+    float4 Bx = float4(0.5f,  2.0f, -0.5f, -2.0f);
+    float4 Cx = float4(1.0f,  1.0f, -0.5f,  0.0f);
+    float4 Ay = float4(1.0f, -1.0f, -1.0f,  1.0f);
+    float4 By = float4(2.0f,  0.5f, -2.0f, -0.5f);
+    float4 Cy = float4(2.0f,  0.0f, -1.0f,  0.5f);
+
+    float4 fx   = Ao * fp.y + Bo * fp.x;
+    float4 fx_l = Ax * fp.y + Bx * fp.x;
+    float4 fx_u = Ay * fp.y + By * fp.x;
+
+    float4 irlv0 = diff4(e, f) * diff4(e, h);
+    float4 irlv1 = irlv0 * (neq4(f, b) * neq4(f, c) + neq4(h, d) * neq4(h, g) +
+                            eq4(e, i) * (neq4(f, f4) * neq4(f, i4) + neq4(h, h5) * neq4(h, i5)) +
+                            eq4(e, g) + eq4(e, c));
+    float4 irlv2l = diff4(e, g) * diff4(d, g);
+    float4 irlv2u = diff4(e, c) * diff4(b, c);
+
+    float4 wd1 = wd4(e, c, g, i, h5, f4, h, f);
+    float4 wd2 = wd4(h, d, i5, f, i4, b, e, i);
+
+    float4 edr   = step(wd1 + 0.1f, wd2) * irlv1;
+    float4 edr_l = step(XBR_LV2_COEFF * df4(f, g), df4(h, c)) * irlv2l * edr;
+    float4 edr_u = step(XBR_LV2_COEFF * df4(h, c), df4(f, g)) * irlv2u * edr;
+
+    float aa = clamp(max(grad_px.x, grad_px.y) * 0.35f, 0.02f, 0.25f);
+    float4 s_fx   = smoothstep(Co - aa, Co + aa, fx);
+    float4 s_fx_l = smoothstep(Cx - aa, Cx + aa, fx_l);
+    float4 s_fx_u = smoothstep(Cy - aa, Cy + aa, fx_u);
+
+    float4 nc = edr * (edr_l * s_fx_l +
+                       edr_u * s_fx_u +
+                       (1.0f - edr_l) * (1.0f - edr_u) * s_fx);
+    nc = saturate(nc);
+
+    float4 px = step(df4(e, f), df4(e, h));
+    float4 cand0 = (px.x > 0.5f) ? vF : vH;
+    float4 cand1 = (px.y > 0.5f) ? vB : vF;
+    float4 cand2 = (px.z > 0.5f) ? vD : vB;
+    float4 cand3 = (px.w > 0.5f) ? vH : vD;
+
+    float4 pxA = vE;
+    float blend = 0.0f;
+    if (nc.x > blend) { blend = nc.x; pxA = cand0; }
+    if (nc.y > blend) { blend = nc.y; pxA = cand1; }
+    if (nc.z > blend) { blend = nc.z; pxA = cand2; }
+    if (nc.w > blend) { blend = nc.w; pxA = cand3; }
+
+    return lerp(vE, pxA, saturate(blend));
+}
+
+PSOutput main(PSInput input) {
+    PSOutput output;
+    float2 pix_coord = input.v_uv * tex_size;
+    float2 grad_px = fwidth(pix_coord);
+
+    float4 base_rgba;
+    if (filter_mode == 1u) {
+        base_rgba = u_texture.SampleLevel(u_sampler, input.v_uv, 0.0f);
+    } else if (filter_mode == 2u) {
+        float2 center_pos = pix_coord - 0.5f;
+        float2 base_px = floor(center_pos);
+        float2 f = frac(center_pos);
+        float2 half_aa = clamp(grad_px * 0.5f, 1e-4f, 0.49f);
+        float2 sf = smoothstep(0.5f - half_aa, 0.5f + half_aa, f);
+        float4 c00 = fetch_px(base_px);
+        float4 c10 = fetch_px(base_px + float2(1.0f, 0.0f));
+        float4 c01 = fetch_px(base_px + float2(0.0f, 1.0f));
+        float4 c11 = fetch_px(base_px + float2(1.0f, 1.0f));
+        base_rgba = lerp(lerp(c00, c10, sf.x), lerp(c01, c11, sf.x), sf.y);
+    } else if (filter_mode == 3u) {
+        float2 p = floor(pix_coord);
+        float2 fp = frac(pix_coord);
+        float4 cE = fetch_px(p);
+        float4 cB = fetch_px(p + float2( 0.0f, -1.0f));
+        float4 cH = fetch_px(p + float2( 0.0f,  1.0f));
+        float4 cD = fetch_px(p + float2(-1.0f,  0.0f));
+        float4 cF = fetch_px(p + float2( 1.0f,  0.0f));
+        base_rgba = cE;
+        if (any(cB.rgb != cH.rgb) && any(cD.rgb != cF.rgb)) {
+            if (fp.x < 0.5f && fp.y < 0.5f) base_rgba = all(cD.rgb == cB.rgb) ? cD : cE;
+            else if (fp.x >= 0.5f && fp.y < 0.5f) base_rgba = all(cB.rgb == cF.rgb) ? cF : cE;
+            else if (fp.x < 0.5f && fp.y >= 0.5f) base_rgba = all(cD.rgb == cH.rgb) ? cD : cE;
+            else base_rgba = all(cH.rgb == cF.rgb) ? cF : cE;
+        }
+    } else if (filter_mode == 4u) {
+        base_rgba = eval_xbr_lv2(pix_coord, grad_px);
+    } else {
+        base_rgba = fetch_px(floor(pix_coord));
+    }
+
+    float3 rgb = base_rgba.rgb;
+
+    if (sharpen_mode != 0u) {
+        float strength = (sharpen_mode == 2u) ? 0.5625f : 0.265625f;
+        float3 n0 = fetch_px(floor(pix_coord + float2( 0.5f,  0.0f))).rgb;
+        float3 n1 = fetch_px(floor(pix_coord + float2(-0.5f,  0.0f))).rgb;
+        float3 n2 = fetch_px(floor(pix_coord + float2( 0.0f,  0.5f))).rgb;
+        float3 n3 = fetch_px(floor(pix_coord + float2( 0.0f, -0.5f))).rgb;
+        float3 avg = 0.25f * (n0 + n1 + n2 + n3);
+        rgb = saturate(rgb + (rgb - avg) * strength);
+    }
+
+    if (color_mode == 1u) {
+        float3 yv = rgb * rgb * (3.0f - 2.0f * rgb);
+        float3 cr = 0.68f * rgb + 0.32f * yv;
+        float luma = dot(cr, float3(0.30078125f, 0.5859375f, 0.11328125f));
+        rgb = saturate(luma + (cr - luma) * 1.1484375f);
+    } else if (color_mode == 2u) {
+        float3 dl = pow(max(rgb, 0.0f), 1.12f) * float3(0.99f, 0.98f, 0.95f);
+        float luma = dot(dl, float3(0.30078125f, 0.5859375f, 0.11328125f));
+        rgb = saturate(luma + (dl - luma) * 0.90625f);
+    }
+
+    rgb = saturate((rgb - 0.5f) * contrast + 0.5f) * brightness;
+    float sat_luma = dot(rgb, float3(0.299f, 0.587f, 0.114f));
+    rgb = saturate(sat_luma + (rgb - sat_luma) * saturation);
+
+    if (vignette > 0.001f) {
+        float2 vc = input.v_uv * 2.0f - 1.0f;
+        float dist = dot(vc, vc);
+        rgb *= saturate(1.0f - dist * vignette * 0.45f);
+    }
+
+    if (post_fx != 0u) {
+        uint2 sub_px = uint2(floor(pix_coord * 2.0f));
+        bool odd_y = (sub_px.y & 1u) != 0u;
+        if (post_fx == 1u) {
+            if (odd_y) rgb *= 0.8203125f;
+        } else if (post_fx == 2u) {
+            float row_mul = odd_y ? 0.7265625f : 1.0f;
+            uint phase = sub_px.x % 3u;
+            float3 mask = float3(
+                phase == 0u ? 1.0f : 0.90625f,
+                phase == 1u ? 1.0f : 0.90625f,
+                phase == 2u ? 1.0f : 0.90625f);
+            rgb *= row_mul * mask;
+        } else if (post_fx == 3u) {
+            float ym = odd_y ? 0.84375f : 0.984375f;
+            float xm = ((sub_px.x & 1u) != 0u) ? 0.8671875f : 0.984375f;
+            rgb *= ym * xm;
+        }
+    }
+
+    output.o_color = float4(rgb, 1.0f) * input.v_color;
+    return output;
+}
diff --git a/runner/src/dos_rom_patch.cpp b/runner/src/dos_rom_patch.cpp
new file mode 100644
index 0000000..025df40
--- /dev/null
+++ b/runner/src/dos_rom_patch.cpp
@@ -0,0 +1,137 @@
+#include "dos_rom_patch.h"
+
+#include <algorithm>
+#include <array>
+#include <cstring>
+#include <fstream>
+
+#include "sha1.h"
+
+namespace {
+
+constexpr uint8_t kMagic[8] = {'D', 'O', 'S', 'P', 'A', 'T', 'C', 'H'};
+constexpr size_t kHeaderSize = 64u;
+constexpr uint32_t kSupportedVersion = 1u;
+constexpr uint32_t kMaxTargetRomSize = 512u * 1024u * 1024u;
+
+uint32_t read_le32(const uint8_t* p) {
+    return uint32_t{p[0]} | (uint32_t{p[1]} << 8) |
+           (uint32_t{p[2]} << 16) | (uint32_t{p[3]} << 24);
+}
+
+uint32_t ieee_crc32(const uint8_t* data, size_t len) {
+    uint32_t crc = 0xFFFFFFFFu;
+    for (size_t i = 0; i < len; ++i) {
+        crc ^= static_cast<uint32_t>(data[i]);
+        for (int b = 0; b < 8; ++b) {
+            const uint32_t mask = (crc & 1u) ? 0xEDB88320u : 0u;
+            crc = (crc >> 1) ^ mask;
+        }
+    }
+    return ~crc;
+}
+
+bool set_err(std::string* error, const char* msg) {
+    if (error) *error = msg ? msg : "";
+    return false;
+}
+
+}  // namespace
+
+bool dos_rom_patch_apply_bytes(const std::vector<uint8_t>& base_rom,
+                               const uint8_t* patch_data,
+                               size_t patch_size,
+                               std::vector<uint8_t>* out_rom,
+                               std::string* error) {
+    if (!out_rom) return set_err(error, "out_rom nulo");
+    if (!patch_data || patch_size < kHeaderSize) {
+        return set_err(error, "patch DOSPATCH truncado ou invalido");
+    }
+    if (std::memcmp(patch_data, kMagic, sizeof(kMagic)) != 0) {
+        return set_err(error, "assinatura DOSPATCH invalida");
+    }
+
+    const uint32_t version = read_le32(patch_data + 8);
+    if (version != kSupportedVersion) {
+        return set_err(error, "versao DOSPATCH nao suportada");
+    }
+    const uint32_t target_size = read_le32(patch_data + 12);
+    if (target_size == 0u || target_size > kMaxTargetRomSize) {
+        return set_err(error, "tamanho alvo de ROM invalido no DOSPATCH");
+    }
+
+    std::array<uint8_t, 20> expected_src_sha1{};
+    std::array<uint8_t, 20> expected_dst_sha1{};
+    std::memcpy(expected_src_sha1.data(), patch_data + 16, 20);
+    std::memcpy(expected_dst_sha1.data(), patch_data + 36, 20);
+    const uint32_t chunk_count = read_le32(patch_data + 56);
+    const uint32_t expected_crc = read_le32(patch_data + 60);
+
+    const auto actual_src_sha1 = gba::sha1(base_rom.data(), base_rom.size()).bytes;
+    if (actual_src_sha1 != expected_src_sha1) {
+        return set_err(error, "SHA-1 da ROM base nao corresponde ao patch PT-BR");
+    }
+
+    const uint32_t actual_crc = ieee_crc32(patch_data + kHeaderSize, patch_size - kHeaderSize);
+    if (actual_crc != expected_crc) {
+        return set_err(error, "CRC32 do payload DOSPATCH corrompido");
+    }
+
+    std::vector<uint8_t> patched(target_size, 0u);
+    const size_t copy_len = std::min<size_t>(base_rom.size(), target_size);
+    if (copy_len > 0u) {
+        std::memcpy(patched.data(), base_rom.data(), copy_len);
+    }
+
+    size_t cursor = kHeaderSize;
+    for (uint32_t i = 0; i < chunk_count; ++i) {
+        if (cursor + 8u > patch_size) {
+            return set_err(error, "bloco DOSPATCH truncado");
+        }
+        const uint32_t offset = read_le32(patch_data + cursor);
+        const uint32_t length = read_le32(patch_data + cursor + 4);
+        cursor += 8u;
+        if (length > patch_size - cursor) {
+            return set_err(error, "dados de bloco DOSPATCH truncados");
+        }
+        if (static_cast<uint64_t>(offset) + static_cast<uint64_t>(length) >
+            static_cast<uint64_t>(target_size)) {
+            return set_err(error, "bloco DOSPATCH ultrapassa tamanho alvo da ROM");
+        }
+        if (length > 0u) {
+            std::memcpy(patched.data() + offset, patch_data + cursor, length);
+        }
+        cursor += length;
+    }
+
+    if (cursor != patch_size) {
+        return set_err(error, "bytes extras apos o fim dos blocos DOSPATCH");
+    }
+
+    const auto actual_dst_sha1 = gba::sha1(patched.data(), patched.size()).bytes;
+    if (actual_dst_sha1 != expected_dst_sha1) {
+        return set_err(error, "SHA-1 da ROM resultante falhou na verificacao");
+    }
+
+    *out_rom = std::move(patched);
+    return true;
+}
+
+bool dos_rom_patch_apply_file(const std::vector<uint8_t>& base_rom,
+                              const std::string& patch_path,
+                              std::vector<uint8_t>* out_rom,
+                              std::string* error) {
+    if (patch_path.empty()) return set_err(error, "caminho de patch vazio");
+    std::ifstream in(patch_path, std::ios::binary | std::ios::ate);
+    if (!in) return set_err(error, "nao foi possivel abrir o arquivo .dospatch");
+    const std::streamoff size = in.tellg();
+    if (size < static_cast<std::streamoff>(kHeaderSize)) {
+        return set_err(error, "arquivo .dospatch vazio ou truncado");
+    }
+    in.seekg(0, std::ios::beg);
+    std::vector<uint8_t> buf(static_cast<size_t>(size));
+    if (!in.read(reinterpret_cast<char*>(buf.data()), size)) {
+        return set_err(error, "falha de leitura no arquivo .dospatch");
+    }
+    return dos_rom_patch_apply_bytes(base_rom, buf.data(), buf.size(), out_rom, error);
+}
