+void dos_custom_music_on_pxi_sound(uint32_t payload, uint8_t* main_ram, size_t main_ram_size) {
+    if (!main_ram || main_ram_size < 4u * 1024u * 1024u) return;
+    if (payload < 0x02000000u || payload >= 0x03000000u) return;
+
+    auto ram_ptr = [&](uint32_t addr, size_t bytes) -> uint8_t* {
+        if (addr < 0x02000000u || addr >= 0x03000000u) return nullptr;
+        const size_t off = static_cast<size_t>(addr & 0x003FFFFFu);
+        if (off + bytes > main_ram_size) return nullptr;
+        return main_ram + off;
+    };
+
+    const bool trace_pxi = []() {
+        const char* e = std::getenv("NDS_CUSTOM_MUSIC_TRACE");
+        return e && e[0] == '1';
+    }();
+
+    std::lock_guard<std::mutex> lock(g_music.mu);
+    uint32_t ptr = payload;
+    for (unsigned guard = 0; ptr && guard < 256u; ++guard) {
+        if (ptr & 3u) break;
+        uint8_t* node = ram_ptr(ptr, 24u);
+        if (!node) break;
+
+        const uint32_t next = rd_u32(node + 0);
+        const uint32_t cmd_id = rd_u32(node + 4);
+        const uint32_t arg0 = rd_u32(node + 8);
+        const uint32_t arg1 = rd_u32(node + 12);
+        const uint32_t arg2 = rd_u32(node + 16);
+        const uint32_t arg3 = rd_u32(node + 20);
+        if (trace_pxi && cmd_id <= 8u && arg0 < 16u) {
+            uint8_t b16[16]{};
+            if (cmd_id == 0u) {
+                if (const uint8_t* p16 = ram_ptr(arg1 + arg2, 16u)) std::memcpy(b16, p16, 16u);
+            }
+            const int matched = (cmd_id == 0u) ? dos_bgm_identify_sseq_prefix(b16) : -1;
+            std::fprintf(stderr,
+                         "[custom-music-trace] cmd=%u p=%u a1=0x%X a2=0x%X a3=0x%X match=%d b=%02x%02x%02x%02x%02x%02x%02x%02x\n",
+                         cmd_id, arg0, arg1, arg2, arg3, matched,
+                         b16[0], b16[1], b16[2], b16[3], b16[4], b16[5], b16[6], b16[7]);
+        }
+
+        // Nitro SDK 2.x (Castlevania: Dawn of Sorrow) SNDCommandIDs:
+        // 0 = START_SEQ(player, base, offset, bank)
+        // 1 = STOP_SEQ(player)
+        // 2 = PAUSE_SEQ(player, flag)
+        // 4 = PLAYER_PARAM(player, offset, data, size) [offset 4=Priority, 5=Volume(0..127), 6=ExtraVolume(s16)]
+        if (cmd_id == 0u && arg0 < 16u) {
+            const uint32_t data_addr = arg1 + arg2;
+            int tid = -1;
+            if (const uint8_t* p16 = ram_ptr(data_addr, 16u)) {
+                tid = dos_bgm_identify_sseq_prefix(p16);
+            }
+            if (tid < 0) {
+                if (const uint8_t* p16 = ram_ptr(data_addr + 0x1Cu, 16u)) {
+                    tid = dos_bgm_identify_sseq_prefix(p16);
+                }
+            }
+            if (tid >= 0) {
+                g_music.active_bgm_player_slot = static_cast<int>(arg0);
+                activate_track_locked(tid, true);
+            } else if (static_cast<int>(arg0) == g_music.active_bgm_player_slot) {
+                // Este slot de hardware foi reutilizado por um SFX/SSAR — libera slot de BGM.
+                g_music.active_bgm_player_slot = -1;
+                g_music.active_bgm_id = -1;
+                if (!jukebox_active_locked()) {
+                    g_music.active_playing = false;
+                }
+            }
+        } else if (cmd_id == 1u && static_cast<int>(arg0) == g_music.active_bgm_player_slot) {
+            // SND_COMMAND_STOP_SEQ
+            g_music.active_bgm_player_slot = -1;
+            g_music.guest_paused = false;
+            if (!jukebox_active_locked()) {
+                g_music.active_playing = false;
+            }
+        } else if (cmd_id == 2u && static_cast<int>(arg0) == g_music.active_bgm_player_slot) {
+            // SND_COMMAND_PAUSE_SEQ (Nitro SDK 2.x)
+            if (!jukebox_active_locked()) {
+                g_music.guest_paused = (arg1 != 0u);
+            }
+        } else if (cmd_id == 4u && static_cast<int>(arg0) == g_music.active_bgm_player_slot) {
+            // SND_COMMAND_PLAYER_PARAM (Nitro SDK 2.x): arg1=offset, arg2=data, arg3=size
+            const bool custom_owns_slot =
+                g_music.enabled &&
+                (jukebox_active_locked() ||
+                 (g_music.active_bgm_id >= 0 &&
+                  g_music.bindings.count(static_cast<uint8_t>(g_music.active_bgm_id)) != 0u));
+            if (arg1 == 5u && arg3 == 1u) {
+                const uint32_t vol = std::min<uint32_t>(127u, arg2 & 0xFFu);
+                g_music.game_fade_gain = jukebox_active_locked() ? 1.0f : (static_cast<float>(vol) / 127.0f);
+                if (custom_owns_slot) {
+                    // Silencia SOMENTE o slot de BGM na ARM7 mantendo SFX/vozes intactos.
+                    wr_u32(node + 16, 0u);
+                }
+            } else if (arg1 == 4u && arg3 == 1u && custom_owns_slot) {
+                // Dawn of Sorrow envia PLAYER_PARAM(Priority=0x40) logo apos START_SEQ.
+                // Reaproveitamos este no para SND_COMMAND_MUTE_TRACK (cmd=6 no Nitro SDK 2.x):
+                // arg0=player, arg1=0xFFFF (todas as 16 tracks), arg2=1 (bit 0 = SND_SEQ_MUTE_NO_STOP), arg3=0.
+                wr_u32(node + 4, 6u);
+                wr_u32(node + 12, 0xFFFFu);
+                wr_u32(node + 16, 1u);
+                wr_u32(node + 20, 0u);
+            } else if (arg1 == 6u && arg3 == 2u && custom_owns_slot) {
+                wr_u32(node + 16, static_cast<uint32_t>(static_cast<uint16_t>(-32768)));
+            }
+        }
+
+        if (next == ptr) break;
+        ptr = next;
+    }
+}
+
+void dos_custom_music_mix(int16_t* stereo_pcm,
+                          uint32_t frames,
+                          bool custom_enabled,
+                          uint8_t custom_volume_pct,
+                          bool master_audio_enabled,
+                          uint8_t master_volume_pct) {
+    if (!stereo_pcm || frames == 0 || !custom_enabled || !master_audio_enabled) return;
+    if (custom_volume_pct == 0u || master_volume_pct == 0u) return;
+
+    std::lock_guard<std::mutex> lock(g_music.mu);
+    if (!g_music.enabled || !g_music.active_playing || g_music.guest_paused ||
+        g_music.host_paused || g_music.finished) {
+        return;
+    }
+    const size_t total_frames = g_music.decoded.pcm_stereo_32768.size() / 2u;
+    if (total_frames == 0) return;
+
+    const float fade = jukebox_active_locked() ? 1.0f : g_music.game_fade_gain;
+    const float gain =
+        (static_cast<float>(std::min<uint8_t>(custom_volume_pct, 150u)) / 100.0f) *
+        (static_cast<float>(std::min<uint8_t>(master_volume_pct, 150u)) / 100.0f) *
+        fade * g_music.current_binding.gain_linear;
+    if (gain <= 0.0001f) return;
+
+    const size_t loop_end = (g_music.decoded.loop_end_frame > g_music.decoded.loop_start_frame &&
+                             g_music.decoded.loop_end_frame <= total_frames)
+                                ? g_music.decoded.loop_end_frame
+                                : total_frames;
+    const size_t loop_start = g_music.decoded.loop_start_frame;
+    const int16_t* src = g_music.decoded.pcm_stereo_32768.data();
+
+    for (uint32_t i = 0; i < frames; ++i) {
+        if (g_music.play_frame >= loop_end) {
+            if (jukebox_active_locked() && g_music.jukebox_playlist.size() > 1u) {
+                g_music.finished = true;
+                g_music.jukebox_advance_pending.store(true, std::memory_order_release);
+                break;
+            }
+            if (g_music.current_binding.loop) {
+                g_music.play_frame = loop_start;
+            } else {
+                g_music.finished = true;
+                break;
+            }
+        }
+        const int32_t ml = static_cast<int32_t>(
+            std::lrintf(static_cast<float>(src[g_music.play_frame * 2u]) * gain));
+        const int32_t mr = static_cast<int32_t>(
+            std::lrintf(static_cast<float>(src[g_music.play_frame * 2u + 1u]) * gain));
+        stereo_pcm[i * 2u] = clamp_s16(static_cast<int32_t>(stereo_pcm[i * 2u]) + ml);
+        stereo_pcm[i * 2u + 1u] = clamp_s16(static_cast<int32_t>(stereo_pcm[i * 2u + 1u]) + mr);
+        ++g_music.play_frame;
+    }
+}
+
+DosCustomMusicStatus dos_custom_music_status() {
+    std::lock_guard<std::mutex> lock(g_music.mu);
+    DosCustomMusicStatus st{};
+    st.music_dir = g_music.music_dir;
+    st.installed_tracks = g_music.bindings.size();
+    st.active_bgm_id = g_music.active_bgm_id;
+    st.active_bgm_label = format_bgm_label(g_music.active_bgm_id);
+    st.playing_custom = g_music.enabled && g_music.active_playing && !g_music.finished;
+    st.custom_file_label = st.playing_custom ? g_music.current_binding.file_label : "";
+    st.paused = g_music.guest_paused || g_music.host_paused;
+    st.game_fade_gain = g_music.game_fade_gain;
+    st.jukebox_enabled = g_music.jukebox_enabled;
+    st.jukebox_shuffle = g_music.jukebox_shuffle;
+    st.jukebox_index = g_music.jukebox_index;
+    st.jukebox_playlist = g_music.jukebox_playlist;
+    st.available_files = g_music.available_files;
+    for (const auto& kv : g_music.bindings) {
+        if (kv.first < kDosBgmTrackCount) {
+            st.track_files[kv.first] = kv.second.file_label;
+        }
+    }
+    return st;
+}
