+void draw_tab_audio(DosImGuiMenuContext& ctx, DosLanguage lang, ImFont* heading_font) {
+    NdsFrontendOptions* opt = ctx.options;
+    if (!opt) return;
+
+    begin_section(dos_tr(lang, DosStrId::SecAudioMix), heading_font);
+    if (ImGui::Checkbox(dos_tr(lang, DosStrId::LblAudioEnabled), &opt->dos.audio_enabled)) {
+        mark_dirty(ctx, false);
+    }
+    static constexpr std::array<DosAudioMode, 4> kAudioModes = {
+        DosAudioMode::WarmStereoHd, DosAudioMode::NativeDs,
+        DosAudioMode::LowPassClean, DosAudioMode::GothicReverb};
+    static constexpr std::array<DosStrId, 4> kAudioNames = {
+        DosStrId::AudioWarmStereo, DosStrId::AudioNative,
+        DosStrId::AudioLowPass, DosStrId::AudioGothicReverb};
+    if (combo_enum(dos_tr(lang, DosStrId::LblAudioMode), &opt->dos.audio_mode,
+                   kAudioModes, kAudioNames, lang)) {
+        mark_dirty(ctx, false);
+    }
+    int vol = opt->dos.audio_volume;
+    if (ImGui::SliderInt(dos_tr(lang, DosStrId::LblVolume), &vol, 0, 150, "%d%%")) {
+        opt->dos.audio_volume = static_cast<uint8_t>(vol);
+        mark_dirty(ctx, false);
+    }
+    int fx = opt->dos.audio_fx_pct;
+    if (ImGui::SliderInt(dos_tr(lang, DosStrId::LblAudioFx), &fx, 0, 150, "%d%%")) {
+        opt->dos.audio_fx_pct = static_cast<uint8_t>(fx);
+        mark_dirty(ctx, false);
+    }
+    if (ImGui::Checkbox(dos_tr(lang, DosStrId::LblMuteUnfocused),
+                        &opt->dos.mute_unfocused)) {
+        mark_dirty(ctx, false);
+    }
+
+    begin_section(dos_tr(lang, DosStrId::SecCustomMusic), heading_font);
+    if (ImGui::Checkbox(dos_tr(lang, DosStrId::LblCustomMusicEnabled),
+                        &opt->dos.custom_music_enabled)) {
+        dos_custom_music_set_enabled(opt->dos.custom_music_enabled);
+        mark_dirty(ctx, false);
+    }
+    int cm_vol = opt->dos.custom_music_volume;
+    if (ImGui::SliderInt(dos_tr(lang, DosStrId::LblCustomMusicVolume), &cm_vol, 0, 150, "%d%%")) {
+        opt->dos.custom_music_volume = static_cast<uint8_t>(cm_vol);
+        mark_dirty(ctx, false);
+    }
+    const DosCustomMusicStatus cm_st = dos_custom_music_status();
+    ImGui::Text("%s: %s",
+                dos_tr(lang, DosStrId::LblCustomMusicNowPlaying),
+                cm_st.active_bgm_label.empty() ? "-" : cm_st.active_bgm_label.c_str());
+    if (cm_st.playing_custom) {
+        if (cm_st.jukebox_enabled && !cm_st.jukebox_playlist.empty()) {
+            ImGui::TextColored(ImVec4(0.32f, 0.90f, 0.48f, 1.0f),
+                               "[JUKEBOX %zu/%zu] %s",
+                               cm_st.jukebox_index + 1u,
+                               cm_st.jukebox_playlist.size(),
+                               cm_st.custom_file_label.c_str());
+        } else {
+            ImGui::TextColored(ImVec4(0.32f, 0.90f, 0.48f, 1.0f),
+                               "Custom track active: %s (%zu mapped, %zu files)",
+                               cm_st.custom_file_label.c_str(),
+                               cm_st.installed_tracks,
+                               cm_st.available_files.size());
+        }
+    } else {
+        ImGui::TextDisabled("Audio files: %zu  |  Mapped stages: %zu  |  Dir: %s",
+                            cm_st.available_files.size(),
+                            cm_st.installed_tracks,
+                            cm_st.music_dir.empty() ? "(not configured)" : cm_st.music_dir.c_str());
+    }
+    if (ImGui::Button(dos_tr(lang, DosStrId::BtnRescanMusic), ImVec2(240.0f, 0.0f))) {
+        dos_custom_music_rescan();
+    }
+    ImGui::TextWrapped("%s", dos_tr(lang, DosStrId::LblCustomMusicFolderHint));
+
+    if (cm_st.available_files.empty()) {
+        ImGui::Spacing();
+        ImGui::TextColored(ImVec4(0.95f, 0.78f, 0.30f, 1.0f), "%s",
+                           dos_tr(lang, DosStrId::LblMusicNoFilesHint));
+    } else {
+        // --- Global Jukebox / Playlist (mutes ALL DS BGM) ---
+        begin_section(dos_tr(lang, DosStrId::SecMusicJukebox), heading_font);
+        bool jb_enabled = cm_st.jukebox_enabled;
+        bool jb_shuffle = cm_st.jukebox_shuffle;
+        std::vector<std::string> jb_playlist = cm_st.jukebox_playlist;
+        bool jb_changed = false;
+
+        if (ImGui::Checkbox(dos_tr(lang, DosStrId::LblMusicJukeboxEnabled), &jb_enabled)) {
+            if (jb_enabled && jb_playlist.empty()) {
+                jb_playlist = cm_st.available_files;
+            }
+            jb_changed = true;
+        }
+        ImGui::SameLine();
+        if (ImGui::Checkbox(dos_tr(lang, DosStrId::LblMusicJukeboxShuffle), &jb_shuffle)) {
+            jb_changed = true;
+        }
+        ImGui::TextDisabled("%s", dos_tr(lang, DosStrId::LblMusicJukeboxHint));
+
+        if (ImGui::Button(dos_tr(lang, DosStrId::BtnMusicPrev), ImVec2(90.0f, 0.0f))) {
+            dos_custom_music_jukebox_prev();
+        }
+        ImGui::SameLine();
+        if (ImGui::Button(dos_tr(lang, DosStrId::BtnMusicNext), ImVec2(90.0f, 0.0f))) {
+            dos_custom_music_jukebox_next();
+        }
+        ImGui::SameLine();
+        if (ImGui::Button(dos_tr(lang, DosStrId::BtnMusicSelectAll), ImVec2(110.0f, 0.0f))) {
+            jb_playlist = cm_st.available_files;
+            jb_changed = true;
+        }
+        ImGui::SameLine();
+        if (ImGui::Button(dos_tr(lang, DosStrId::BtnMusicClearPlaylist), ImVec2(90.0f, 0.0f))) {
+            jb_playlist.clear();
+            jb_enabled = false;
+            jb_changed = true;
+        }
+
+        if (ImGui::BeginChild("##dos_jukebox_playlist", ImVec2(0.0f, 118.0f), ImGuiChildFlags_Borders)) {
+            for (const auto& fname : cm_st.available_files) {
+                auto it = std::find(jb_playlist.begin(), jb_playlist.end(), fname);
+                bool checked = (it != jb_playlist.end());
+                if (ImGui::Checkbox(fname.c_str(), &checked)) {
+                    if (checked) {
+                        jb_playlist.push_back(fname);
+                    } else if (it != jb_playlist.end()) {
+                        jb_playlist.erase(it);
+                    }
+                    jb_changed = true;
+                }
+            }
+        }
+        ImGui::EndChild();
+        if (jb_changed) {
+            dos_custom_music_set_jukebox(jb_enabled, jb_shuffle, jb_playlist);
+        }
+
+        // --- Per-Stage Visual Track Mapper (30 game tracks, any filename) ---
+        begin_section(dos_tr(lang, DosStrId::SecMusicTrackMapper), heading_font);
+        static int s_selected_stage = 11;  // Default: #11 Pitch Black Intrusion
+        static int s_selected_file_idx = 0;  // 0 = Original DS, 1..N = available_files[idx-1]
+        static int s_last_synced_stage = -1;
+
+        const auto& catalog = dos_bgm_track_catalog();
+        auto sync_file_idx_for_stage = [&](int stage_id) {
+            s_last_synced_stage = stage_id;
+            s_selected_file_idx = 0;
+            if (stage_id >= 0 && stage_id < static_cast<int>(kDosBgmTrackCount)) {
+                const std::string& cur = cm_st.track_files[static_cast<size_t>(stage_id)];
+                if (!cur.empty()) {
+                    for (size_t i = 0; i < cm_st.available_files.size(); ++i) {
+                        if (cm_st.available_files[i] == cur) {
+                            s_selected_file_idx = static_cast<int>(i) + 1;
+                            break;
+                        }
+                    }
+                }
+            }
+        };
+        if (s_last_synced_stage != s_selected_stage) {
+            sync_file_idx_for_stage(s_selected_stage);
+        }
+        if (s_selected_file_idx > static_cast<int>(cm_st.available_files.size())) {
+            s_selected_file_idx = 0;
+        }
+
+        char stage_preview[160]{};
+        const auto& cur_stage_info = catalog[static_cast<size_t>(s_selected_stage)];
+        const std::string& cur_assigned = cm_st.track_files[static_cast<size_t>(s_selected_stage)];
+        std::snprintf(stage_preview, sizeof(stage_preview), "#%02u %s%s%s",
+                      static_cast<unsigned>(cur_stage_info.id),
+                      cur_stage_info.display_name,
+                      cur_assigned.empty() ? "" : "  ->  ",
+                      cur_assigned.c_str());
+
+        ImGui::SetNextItemWidth(340.0f);
+        if (ImGui::BeginCombo(dos_tr(lang, DosStrId::LblMusicStageSelect), stage_preview)) {
+            for (size_t i = 0; i < kDosBgmTrackCount; ++i) {
+                char item_label[192]{};
+                const auto& info = catalog[i];
+                const std::string& assigned = cm_st.track_files[i];
+                std::snprintf(item_label, sizeof(item_label), "#%02u %s%s%s",
+                              static_cast<unsigned>(info.id),
+                              info.display_name,
+                              assigned.empty() ? "" : "  [",
+                              assigned.empty() ? "" : (assigned + "]").c_str());
+                const bool is_sel = (static_cast<int>(i) == s_selected_stage);
+                if (ImGui::Selectable(item_label, is_sel)) {
+                    s_selected_stage = static_cast<int>(i);
+                    sync_file_idx_for_stage(s_selected_stage);
+                }
+                if (is_sel) ImGui::SetItemDefaultFocus();
+            }
+            ImGui::EndCombo();
+        }
+        if (cm_st.active_bgm_id >= 0 && cm_st.active_bgm_id < static_cast<int>(kDosBgmTrackCount)) {
+            ImGui::SameLine();
+            if (ImGui::Button(dos_tr(lang, DosStrId::BtnMusicUseCurrent))) {
+                s_selected_stage = cm_st.active_bgm_id;
+                sync_file_idx_for_stage(s_selected_stage);
+            }
+        }
+
+        const char* file_preview =
+            (s_selected_file_idx <= 0)
+                ? dos_tr(lang, DosStrId::LblMusicOriginalDs)
+                : cm_st.available_files[static_cast<size_t>(s_selected_file_idx - 1)].c_str();
+        ImGui::SetNextItemWidth(340.0f);
+        if (ImGui::BeginCombo(dos_tr(lang, DosStrId::LblMusicFileSelect), file_preview)) {
+            if (ImGui::Selectable(dos_tr(lang, DosStrId::LblMusicOriginalDs), s_selected_file_idx == 0)) {
+                s_selected_file_idx = 0;
+            }
+            for (size_t i = 0; i < cm_st.available_files.size(); ++i) {
+                const bool is_sel = (s_selected_file_idx == static_cast<int>(i) + 1);
+                if (ImGui::Selectable(cm_st.available_files[i].c_str(), is_sel)) {
+                    s_selected_file_idx = static_cast<int>(i) + 1;
+                }
+                if (is_sel) ImGui::SetItemDefaultFocus();
+            }
+            ImGui::EndCombo();
+        }
+
+        if (ImGui::Button(dos_tr(lang, DosStrId::BtnMusicAssign), ImVec2(180.0f, 0.0f))) {
+            const std::string chosen =
+                (s_selected_file_idx <= 0)
+                    ? ""
+                    : cm_st.available_files[static_cast<size_t>(s_selected_file_idx - 1)];
+            dos_custom_music_assign_track(static_cast<uint8_t>(s_selected_stage), chosen);
+        }
+        ImGui::SameLine();
+        if (ImGui::Button(dos_tr(lang, DosStrId::BtnMusicClearStage), ImVec2(160.0f, 0.0f))) {
+            dos_custom_music_assign_track(static_cast<uint8_t>(s_selected_stage), "");
+            s_selected_file_idx = 0;
+        }
+    }
+}
