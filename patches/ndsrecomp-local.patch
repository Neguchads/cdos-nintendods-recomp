+bool dos_frame_identical(const uint32_t* a, const uint32_t* b, size_t count) {
+    if (!a || !b) return false;
+    if (a == b || count == 0) return true;
+    return std::memcmp(a, b, count * sizeof(uint32_t)) == 0;
+}
+
+const uint32_t* DosFrameProcessor::process(const uint32_t* src, int src_w, int src_h,
+                                           DosHdFilter filter, DosColorMode color,
+                                           DosSharpenMode sharpen, DosPostFx post_fx,
+                                           int* out_w, int* out_h,
+                                           bool* unchanged_out) {
+    if (unchanged_out) *unchanged_out = false;
+    if (!src || src_w <= 0 || src_h <= 0) {
+        if (out_w) *out_w = 0;
+        if (out_h) *out_h = 0;
+        invalidate_cache();
+        return nullptr;
+    }
+    const int scale = dos_hd_filter_scale(filter);
+    const int dst_w = src_w * scale;
+    const int dst_h = src_h * scale;
+    if (out_w) *out_w = dst_w;
+    if (out_h) *out_h = dst_h;
+
+    const size_t src_n = static_cast<size_t>(src_w) * static_cast<size_t>(src_h);
+    const bool bypass = (scale == 1 && color == DosColorMode::Native &&
+                         sharpen == DosSharpenMode::Off && post_fx == DosPostFx::Off);
+    if (last_valid && last_src_w == src_w && last_src_h == src_h &&
+        last_filter == filter && last_color == color &&
+        last_sharpen == sharpen && last_post_fx == post_fx &&
+        last_src.size() == src_n && dos_frame_identical(src, last_src.data(), src_n)) {
+        if (unchanged_out) *unchanged_out = true;
+        return bypass ? src : last_out;
+    }
+
+    last_src.assign(src, src + src_n);
+    last_src_w = src_w;
+    last_src_h = src_h;
+    last_out_w = dst_w;
+    last_out_h = dst_h;
+    last_filter = filter;
+    last_color = color;
+    last_sharpen = sharpen;
+    last_post_fx = post_fx;
+
+    if (bypass) {
+        last_out = src;
+        last_valid = true;
+        return src;
+    }
+
+    const uint32_t* stage = src;
+    if (color != DosColorMode::Native) {
+        const auto& luts = color_luts();
+        color_buf.resize(src_n);
+        for (size_t i = 0; i < src_n; ++i)
+            color_buf[i] = apply_color_pixel(src[i], color, luts);
+        stage = color_buf.data();
+    }
+
+    int cur_w = src_w;
+    int cur_h = src_h;
+    if (scale == 2) {
+        upscale_buf.resize(static_cast<size_t>(dst_w) * static_cast<size_t>(dst_h));
+        if (filter == DosHdFilter::Xbr2x)
+            upscale_xbr2x(stage, src_w, src_h, upscale_buf.data());
+        else if (filter == DosHdFilter::Scale2x)
+            upscale_scale2x(stage, src_w, src_h, upscale_buf.data());
+        else
+            upscale_sharp_bilinear_2x(stage, src_w, src_h, upscale_buf.data());
+        stage = upscale_buf.data();
+        cur_w = dst_w;
+        cur_h = dst_h;
+    }
+
+    const size_t out_n = static_cast<size_t>(cur_w) * static_cast<size_t>(cur_h);
+    if (sharpen != DosSharpenMode::Off) {
+        final_buf.resize(out_n);
+        apply_sharpen(stage, cur_w, cur_h, sharpen, final_buf.data());
+        stage = final_buf.data();
+    } else if (post_fx != DosPostFx::Off && stage != upscale_buf.data() &&
+               stage != color_buf.data()) {
+        final_buf.assign(stage, stage + out_n);
+        stage = final_buf.data();
+    }
+
+    if (post_fx != DosPostFx::Off) {
+        uint32_t* mutable_stage = const_cast<uint32_t*>(stage);
+        apply_post_fx(mutable_stage, cur_w, cur_h, post_fx);
+    }
+    last_out = stage;
+    last_valid = true;
+    return stage;
+}
+
+uint32_t* DosFrameProcessor::process_mutable(const uint32_t* src, int src_w, int src_h,
+                                             DosHdFilter filter, DosColorMode color,
+                                             DosSharpenMode sharpen, DosPostFx post_fx,
+                                             int* out_w, int* out_h) {
+    int w = 0, h = 0;
+    const uint32_t* res = process(src, src_w, src_h, filter, color, sharpen, post_fx, &w, &h);
+    if (out_w) *out_w = w;
+    if (out_h) *out_h = h;
+    if (!res) return nullptr;
+    if (res != final_buf.data()) {
+        const size_t n = static_cast<size_t>(w) * static_cast<size_t>(h);
+        final_buf.assign(res, res + n);
+    }
+    // Caller mutates final_buf in-place (e.g. drawing HUD), so cached final_buf
+    // is no longer a clean filtered output for subsequent unchanged-frame hits.
+    if (last_out == final_buf.data()) invalidate_cache();
+    return final_buf.data();
+}
+
+void DosAudioProcessor::reset() {
+    lp_l = 0.0f;
+    lp_r = 0.0f;
+    std::fill_n(comb_l, kCombLenL, 0.0f);
+    std::fill_n(comb_r, kCombLenR, 0.0f);
+    idx_l = 0;
+    idx_r = 0;
+}
+
+void DosAudioProcessor::process(int16_t* interleaved_stereo, uint32_t frames,
+                                DosAudioMode mode, bool enabled, uint8_t volume_pct,
+                                uint8_t fx_intensity_pct) {
+    if (!interleaved_stereo || frames == 0) return;
+    if (!enabled || volume_pct == 0) {
+        std::memset(interleaved_stereo, 0, static_cast<size_t>(frames) * 2u * sizeof(int16_t));
+        return;
+    }
+
+    const float gain = static_cast<float>(volume_pct) / 100.0f;
+    const float fx = static_cast<float>(std::clamp<int>(fx_intensity_pct, 0, 150)) / 100.0f;
+    // Gentle 1-pole low-pass alpha at 32768 Hz (~11.5 kHz rolloff) to tame SPU alias hiss.
+    const float lp_alpha = (mode == DosAudioMode::LowPassClean) ? 0.68f : 0.78f;
+
+    for (uint32_t i = 0; i < frames; ++i) {
+        float l = static_cast<float>(interleaved_stereo[i * 2]);
+        float r = static_cast<float>(interleaved_stereo[i * 2 + 1]);
+
+        if (mode != DosAudioMode::NativeDs) {
+            lp_l += lp_alpha * (l - lp_l);
+            lp_r += lp_alpha * (r - lp_r);
+            l = lp_l;
+            r = lp_r;
+        }
+
+        if (mode == DosAudioMode::WarmStereoHd || mode == DosAudioMode::GothicReverb) {
+            // Mid/Side stereo widening (+28% * fx_intensity side depth).
+            const float mid = 0.5f * (l + r);
+            const float side = 0.5f * (l - r) * (1.0f + 0.28f * fx);
+            l = mid + side;
+            r = mid - side;
+        }
+
+        if (mode == DosAudioMode::GothicReverb) {
+            const float delayed_l = comb_l[idx_l];
+            const float delayed_r = comb_r[idx_r];
+            comb_l[idx_l] = l * 0.28f + delayed_l * 0.42f;
+            comb_r[idx_r] = r * 0.28f + delayed_r * 0.42f;
+            if (++idx_l >= kCombLenL) idx_l = 0;
+            if (++idx_r >= kCombLenR) idx_r = 0;
+            l += (delayed_l * 0.16f + delayed_r * 0.06f) * fx;
+            r += (delayed_r * 0.16f + delayed_l * 0.06f) * fx;
+        }
+
+        l *= gain;
+        r *= gain;
+        const int il = static_cast<int>(std::lround(l));
+        const int ir = static_cast<int>(std::lround(r));
+        interleaved_stereo[i * 2] = static_cast<int16_t>(std::clamp(il, -32768, 32767));
+        interleaved_stereo[i * 2 + 1] = static_cast<int16_t>(std::clamp(ir, -32768, 32767));
+    }
+}
+
+namespace {
+
+void render_hud_impl(uint32_t* pixels, int width, int height,
+                     const DosHudMetrics& m, bool transparent_bg) {
+    if (!pixels || width < 64 || height < 22) return;
+    if (transparent_bg) {
+        std::memset(pixels, 0,
+                    static_cast<size_t>(width) * static_cast<size_t>(height) * sizeof(uint32_t));
+    }
+    char line[160]{};
+    if (m.hud_mode == DosHudMode::FpsOnly) {
+        std::snprintf(line, sizeof(line), "FPS:%0.1f %s",
+                      m.fps, m.rom_patched_ptbr ? "PT-BR" : "");
+    } else {
+        std::snprintf(line, sizeof(line),
+                      "FPS:%0.1f EMU:%0.1fMS PRES:%0.1fMS T3:%0.1FK %s %s %s%s",
+                      m.fps, m.emu_ms, m.present_ms, m.tier3_kips,
+                      m.render_driver ? m.render_driver : "AUTO",
+                      m.hd_filter ? m.hd_filter : "NEAR",
+                      m.layout ? m.layout : "PIP",
+                      m.rom_patched_ptbr ? " PT-BR" : "");
+    }
+
+    const int scale = (width >= 512) ? 2 : 1;
+    const int bar_h = std::min(height, 11 * scale);
+    const int text_len = static_cast<int>(std::strlen(line));
+    const int bar_w = std::min(width, 6 * scale * text_len + 6 * scale);
+
+    for (int y = 0; y < bar_h; ++y) {
+        uint32_t* row = pixels + y * width;
+        if (transparent_bg) {
+            for (int x = 0; x < bar_w; ++x) row[x] = 0xC00A0C12u;
+        } else {
+            for (int x = 0; x < bar_w; ++x) {
+                const uint32_t bg = row[x];
+                const int r = static_cast<int>((bg >> 16) & 255u) / 4;
+                const int g = static_cast<int>((bg >> 8) & 255u) / 4;
+                const int b = static_cast<int>(bg & 255u) / 4;
+                row[x] = pack_argb(r, g, b);
+            }
+        }
+    }
+
+    const int origin_x = 3 * scale;
+    const int origin_y = 2 * scale;
+    for (int i = 0; line[i]; ++i) {
+        const int cx = origin_x + i * 6 * scale;
+        if (cx + 5 * scale > width) break;
+        const char* glyph = hud_glyph(line[i]);
+        for (int gy = 0; gy < 7; ++gy) {
+            for (int gx = 0; gx < 5; ++gx) {
+                if (glyph[gy * 5 + gx] != '1') continue;
+                for (int sy = 0; sy < scale; ++sy) {
+                    const int py = origin_y + gy * scale + sy;
+                    if (py >= height) continue;
+                    for (int sx = 0; sx < scale; ++sx) {
+                        const int px = cx + gx * scale + sx;
+                        if (px < width) pixels[py * width + px] = 0xFFE6FF80u;
+                    }
+                }
+            }
+        }
+    }
+}
+
