+void test_frame_cache_hud_and_gpu_shader() {
+    std::vector<uint32_t> frame_a(64 * 64, 0xFF204060u);
+    frame_a[10 * 64 + 12] = 0xFFE0A040u;
+    std::vector<uint32_t> frame_b = frame_a;
+
+    assert(dos_frame_identical(frame_a.data(), frame_b.data(), frame_a.size()));
+
+    DosFrameProcessor proc;
+    int ow = 0, oh = 0;
+    bool unchanged = true;
+
+    const uint32_t* out0 = proc.process(
+        frame_a.data(), 64, 64, DosHdFilter::Xbr2x,
+        DosColorMode::VividHd, DosSharpenMode::Subtle, DosPostFx::Off,
+        &ow, &oh, &unchanged);
+    assert(out0 != nullptr && ow == 128 && oh == 128 && !unchanged);
+
+    // Identical content and settings hit the unchanged-frame cache.
+    const uint32_t* out1 = proc.process(
+        frame_b.data(), 64, 64, DosHdFilter::Xbr2x,
+        DosColorMode::VividHd, DosSharpenMode::Subtle, DosPostFx::Off,
+        &ow, &oh, &unchanged);
+    assert(out1 == out0 && unchanged);
+
+    // Changing one pixel invalidates the cache hit.
+    frame_b[20 * 64 + 20] = 0xFF10FF20u;
+    assert(!dos_frame_identical(frame_a.data(), frame_b.data(), frame_a.size()));
+    const uint32_t* out2 = proc.process(
+        frame_b.data(), 64, 64, DosHdFilter::Xbr2x,
+        DosColorMode::VividHd, DosSharpenMode::Subtle, DosPostFx::Off,
+        &ow, &oh, &unchanged);
+    assert(out2 != nullptr && !unchanged);
+
+    // Changing filter or explicit invalidate_cache() must recompute.
+    proc.process(frame_b.data(), 64, 64, DosHdFilter::Scale2x,
+                 DosColorMode::VividHd, DosSharpenMode::Subtle, DosPostFx::Off,
+                 &ow, &oh, &unchanged);
+    assert(!unchanged);
+
+    proc.invalidate_cache();
+    proc.process(frame_b.data(), 64, 64, DosHdFilter::Scale2x,
+                 DosColorMode::VividHd, DosSharpenMode::Subtle, DosPostFx::Off,
+                 &ow, &oh, &unchanged);
+    assert(!unchanged);
+
+    // Transparent HUD surface (768x24) draws opaque/translucent bar at top and leaves rows 22..23 empty.
+    std::vector<uint32_t> hud_buf(768 * 24, 0xDEADBEEFu);
+    DosHudMetrics metrics{};
+    metrics.fps = 60.0;
+    metrics.emu_ms = 2.1;
+    metrics.present_ms = 0.6;
+    metrics.tier3_kips = 0.0;
+    metrics.render_driver = "DX12-GPU";
+    metrics.hd_filter = "XBR2X";
+    metrics.layout = "PIP";
+    metrics.hud_mode = DosHudMode::Full;
+    dos_draw_dev_hud_transparent(hud_buf.data(), 768, 24, metrics);
+
+    bool found_glyph = false;
+    bool found_bar = false;
+    for (int i = 0; i < 768 * 22; ++i) {
+        if (hud_buf[i] == 0xFFE6FF80u) found_glyph = true;
+        if (hud_buf[i] == 0xC00A0C12u) found_bar = true;
+    }
+    assert(found_glyph && found_bar);
+    for (int i = 768 * 22; i < 768 * 24; ++i) {
+        assert(hud_buf[i] == 0u);
+    }
+
+    // FpsOnly HUD draws narrower top strip cleanly without metadata columns.
+    std::vector<uint32_t> fps_buf(768 * 24, 0x0u);
+    metrics.hud_mode = DosHudMode::FpsOnly;
+    dos_draw_dev_hud_transparent(fps_buf.data(), 768, 24, metrics);
+    bool fps_has_glyph = false;
+    bool fps_tail_empty = true;
+    for (int y = 0; y < 22; ++y) {
+        for (int x = 0; x < 160; ++x) {
+            if (fps_buf[static_cast<size_t>(y) * 768u + static_cast<size_t>(x)] == 0xFFE6FF80u)
+                fps_has_glyph = true;
+        }
+    }
+    for (int y = 0; y < 22; ++y) {
+        if (fps_buf[y * 768 + 600] != 0u) fps_tail_empty = false;
+    }
+    assert(fps_has_glyph && fps_tail_empty);
+
+    const uint8_t* dxil_data = nullptr;
+    size_t dxil_size = 0;
+    assert(dos_gpu_postprocess_dxil_bytecode(&dxil_data, &dxil_size));
+    assert(dxil_data != nullptr && dxil_size > 64);
+    assert(std::memcmp(dxil_data, "DXBC", 4) == 0);
+    bool hash_nonzero = false;
+    for (size_t i = 4; i < 20; ++i) {
+        if (dxil_data[i] != 0u) hash_nonzero = true;
+    }
+    assert(hash_nonzero);
+    bool has_dxil_chunk = false;
+    for (size_t i = 0; i + 4 <= dxil_size; ++i) {
+        if (std::memcmp(dxil_data + i, "DXIL", 4) == 0) {
+            has_dxil_chunk = true;
+            break;
+        }
+    }
+    assert(has_dxil_chunk);
+
+    const uint8_t* spirv_data = nullptr;
+    size_t spirv_size = 0;
+    assert(dos_gpu_postprocess_spirv_bytecode(&spirv_data, &spirv_size));
+    assert(spirv_data != nullptr && spirv_size > 64 && (spirv_size % 4u) == 0u);
+    uint32_t spirv_magic = 0;
+    std::memcpy(&spirv_magic, spirv_data, sizeof(spirv_magic));
+    assert(spirv_magic == 0x07230203u);
+
+    assert(dos_i18n_self_check());
+    assert(std::strcmp(dos_tr(DosLanguage::English, DosStrId::TabDisplay),
+                       dos_tr(DosLanguage::PtBr, DosStrId::TabDisplay)) != 0);
+}
