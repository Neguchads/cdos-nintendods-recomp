+const char* select_footer_text(const DosImGuiMenuContext& ctx, DosLanguage lang) {
+    DosButtonPrompts mode = ctx.options ? ctx.options->dos.button_prompts
+                                        : DosButtonPrompts::Auto;
+    if (mode == DosButtonPrompts::Auto) {
+        if (!ctx.gamepad_connected) return dos_tr(lang, DosStrId::MenuHintFooter);
+        if (contains_icase(ctx.gamepad_name, "PlayStation") ||
+            contains_icase(ctx.gamepad_name, "DualSense") ||
+            contains_icase(ctx.gamepad_name, "DualShock")) {
+            mode = DosButtonPrompts::PlayStation;
+        } else if (contains_icase(ctx.gamepad_name, "Nintendo") ||
+                   contains_icase(ctx.gamepad_name, "Switch") ||
+                   contains_icase(ctx.gamepad_name, "Pro Controller")) {
+            mode = DosButtonPrompts::Nintendo;
+        } else {
+            mode = DosButtonPrompts::Xbox;
+        }
+    }
+    switch (mode) {
+        case DosButtonPrompts::Xbox:
+            return dos_tr(lang, DosStrId::ControllerFooterXbox);
+        case DosButtonPrompts::PlayStation:
+            return dos_tr(lang, DosStrId::ControllerFooterPs);
+        case DosButtonPrompts::Nintendo:
+            return dos_tr(lang, DosStrId::ControllerFooterNintendo);
+        case DosButtonPrompts::Keyboard:
+        case DosButtonPrompts::Auto:
+        default:
+            return dos_tr(lang, DosStrId::MenuHintFooter);
+    }
+}
