+void test_audio_processor() {
+    DosAudioProcessor dsp;
+    dsp.reset();
+
+    std::vector<int16_t> samples(512 * 2);
+    for (size_t i = 0; i < 512; ++i) {
+        samples[i * 2] = static_cast<int16_t>((i % 32 < 16) ? 12000 : -12000);
+        samples[i * 2 + 1] = static_cast<int16_t>((i % 16 < 8) ? 8000 : -8000);
+    }
+
+    auto muted = samples;
+    dsp.process(muted.data(), 512, DosAudioMode::WarmStereoHd, false, 100);
+    for (int16_t s : muted) assert(s == 0);
+
+    auto warm = samples;
+    dsp.reset();
+    dsp.process(warm.data(), 512, DosAudioMode::WarmStereoHd, true, 125);
+    bool nonzero = false;
+    for (int16_t s : warm) {
+        if (s != 0) nonzero = true;
+    }
+    assert(nonzero);
+
+    auto reverb = samples;
+    dsp.process(reverb.data(), 512, DosAudioMode::GothicReverb, true, 100, 140);
+    assert(reverb.back() != warm.back());
+
+    auto dry_fx = samples;
+    dsp.reset();
+    dsp.process(dry_fx.data(), 512, DosAudioMode::GothicReverb, true, 100, 0);
+    assert(dry_fx != reverb);
+}
