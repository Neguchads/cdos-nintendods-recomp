diff --git a/runner/vendor/melonds/GPU3D.cpp b/runner/vendor/melonds/GPU3D.cpp
index c97e275..3a53a60 100644
--- a/runner/vendor/melonds/GPU3D.cpp
+++ b/runner/vendor/melonds/GPU3D.cpp
@@ -1281,6 +1281,60 @@ void GPU3D::SubmitPolygon() noexcept
         if (vtx->FinalColor[2]) vtx->FinalColor[2] = ((vtx->FinalColor[2] << 4) + 0xF);
     }
 
+    // Dawn of Sorrow True 2D Widescreen: extend untextured axis-aligned
+    // fullscreen atmospheric quads (mist, sky gradient, water tint, flashes)
+    // authored at native 256..272px width so they cover the full wide band.
+    bool dos_wide_expanded = false;
+    if (DosWideQuadExpand && GuestWideProjection && RenderWidth > 256 &&
+        nverts == 4 && ((TexParam >> 26) & 7) == 0)
+    {
+        s32 qmin_x = 1024, qmax_x = -1, qmin_y = 1024, qmax_y = -1;
+        for (int i = 0; i < 4; i++)
+        {
+            const s32 vx = poly->Vertices[i]->FinalPosition[0];
+            const s32 vy = poly->Vertices[i]->FinalPosition[1];
+            if (vx < qmin_x) qmin_x = vx;
+            if (vx > qmax_x) qmax_x = vx;
+            if (vy < qmin_y) qmin_y = vy;
+            if (vy > qmax_y) qmax_y = vy;
+        }
+        bool axis_aligned = (qmin_x == 0 && qmax_x >= 255 && qmax_x <= 276 &&
+                             qmax_x < static_cast<s32>(RenderWidth) &&
+                             (qmax_y - qmin_y) >= 64);
+        if (axis_aligned)
+        {
+            for (int i = 0; i < 4; i++)
+            {
+                const s32 vx = poly->Vertices[i]->FinalPosition[0];
+                const s32 vy = poly->Vertices[i]->FinalPosition[1];
+                if ((vx != qmin_x && vx != qmax_x) ||
+                    (vy != qmin_y && vy != qmax_y))
+                {
+                    axis_aligned = false;
+                    break;
+                }
+            }
+        }
+        if (axis_aligned && NumVertices + 4 <= 6144)
+        {
+            const s32 wide_x = static_cast<s32>(RenderWidth);
+            for (int i = 0; i < 4; i++)
+            {
+                if (poly->Vertices[i]->FinalPosition[0] == qmax_x)
+                {
+                    // Clone into a fresh vertex slot so shared strip vertices
+                    // on earlier polygons are never mutated in place.
+                    Vertex* dst = &CurVertexRAM[NumVertices++];
+                    *dst = *poly->Vertices[i];
+                    dst->FinalPosition[0] = wide_x;
+                    dst->HiresPosition[0] = wide_x << 4;
+                    poly->Vertices[i] = dst;
+                }
+            }
+            dos_wide_expanded = true;
+        }
+    }
+
     // determine bounds of the polygon
     // also determine the W shift and normalize W
     // normalization works both ways
@@ -1363,7 +1417,7 @@ void GPU3D::SubmitPolygon() noexcept
         poly->FinalW[i] = w;
     }
 
-    if (PolygonMode >= 2)
+    if (PolygonMode >= 2 && !dos_wide_expanded)
         LastStripPolygon = poly;
     else
         LastStripPolygon = NULL;
