+bool dos_load_settings_ini(const std::string& path,
+                           NdsScreenLayout* layout,
+                           NdsPipCorner* pip_corner,
+                           NdsPipMainScreen* pip_main,
+                           int* fullscreen_mode,
+                           NdsButtonBindings* key_primary,
+                           NdsButtonBindings* gamepad_bindings,
+                           bool* custom_gamepad,
+                           uint8_t* internal_resolution,
+                           uint8_t* texture_upscale,
+                           DosEnhancementSettings* dos) {
+    if (path.empty() || !dos) return false;
+    std::ifstream file(path);
+    if (!file) return false;
+
+    std::string line;
+    bool has_hud_mode = false;
+    while (std::getline(file, line)) {
+        if (line.empty() || line[0] == '#') continue;
+        const size_t eq = line.find('=');
+        if (eq == std::string::npos) continue;
+        const std::string key = line.substr(0, eq);
+        const std::string val = line.substr(eq + 1);
+        int tmp = 0;
+        bool btmp = false;
+
+        if (key == "dos_layout" && layout) layout_from_ini_name(val, layout);
+        else if (key == "dos_pip_corner" && pip_corner) corner_from_ini_name(val, pip_corner);
+        else if (key == "dos_pip_main" && pip_main) {
+            const std::string n = lower_trim_token(val);
+            if (n == "top") *pip_main = NdsPipMainScreen::Top;
+            else if (n == "bottom") *pip_main = NdsPipMainScreen::Bottom;
+        } else if (key == "dos_fullscreen" && fullscreen_mode) {
+            const std::string n = lower_trim_token(val);
+            if (n == "off") *fullscreen_mode = 0;
+            else if (n == "borderless") *fullscreen_mode = 1;
+            else if (n == "exclusive") *fullscreen_mode = 2;
+        } else if (key == "dos_aspect_mode") dos_parse_aspect_mode(val, &dos->aspect_mode);
+        else if (key == "dos_render_driver") dos_parse_render_driver(val, &dos->render_driver);
+        else if (key == "dos_hd_filter") dos_parse_hd_filter(val, &dos->hd_filter);
+        else if (key == "dos_post_fx") dos_parse_post_fx(val, &dos->post_fx);
+        else if (key == "dos_color_mode") dos_parse_color_mode(val, &dos->color_mode);
+        else if (key == "dos_sharpen") dos_parse_sharpen_mode(val, &dos->sharpen);
+        else if (key == "dos_audio_mode") dos_parse_audio_mode(val, &dos->audio_mode);
+        else if (key == "dos_audio_enabled" && parse_bool_ini(val, &btmp)) dos->audio_enabled = btmp;
+        else if (key == "dos_audio_volume" && parse_int_range(val, 0, 150, &tmp)) dos->audio_volume = static_cast<uint8_t>(tmp);
+        else if (key == "dos_audio_fx" && parse_int_range(val, 0, 150, &tmp)) dos->audio_fx_pct = static_cast<uint8_t>(tmp);
+        else if (key == "dos_dev_hud" && parse_bool_ini(val, &btmp)) dos->dev_hud = btmp;
+        else if (key == "dos_hud_mode" && dos_parse_hud_mode(val, &dos->hud_mode)) has_hud_mode = true;
+        else if (key == "dos_pip_opacity" && parse_int_range(val, 25, 100, &tmp)) dos->pip_opacity_pct = static_cast<uint8_t>(tmp);
+        else if (key == "dos_pip_size" && parse_int_range(val, 20, 50, &tmp)) dos->pip_size_pct = static_cast<uint8_t>(tmp);
+        else if (key == "dos_brightness" && parse_int_range(val, 80, 130, &tmp)) dos->brightness_pct = static_cast<uint8_t>(tmp);
+        else if (key == "dos_contrast" && parse_int_range(val, 80, 130, &tmp)) dos->contrast_pct = static_cast<uint8_t>(tmp);
+        else if (key == "dos_saturation" && parse_int_range(val, 70, 140, &tmp)) dos->saturation_pct = static_cast<uint8_t>(tmp);
+        else if (key == "dos_vignette" && parse_int_range(val, 0, 50, &tmp)) dos->vignette_pct = static_cast<uint8_t>(tmp);
+        else if (key == "dos_stick_deadzone" && parse_int_range(val, 5, 45, &tmp)) dos->stick_deadzone_pct = static_cast<uint8_t>(tmp);
+        else if (key == "dos_vsync" && parse_bool_ini(val, &btmp)) dos->vsync = btmp;
+        else if (key == "dos_skip_launcher" && parse_bool_ini(val, &btmp)) dos->skip_launcher = btmp;
+        else if (key == "dos_pause_on_menu" && parse_bool_ini(val, &btmp)) dos->pause_on_menu = btmp;
+        else if (key == "dos_pause_unfocused" && parse_bool_ini(val, &btmp)) dos->pause_unfocused = btmp;
+        else if (key == "dos_mute_unfocused" && parse_bool_ini(val, &btmp)) dos->mute_unfocused = btmp;
+        else if (key == "dos_ui_language") dos_parse_language(val, &dos->ui_language);
+        else if (key == "dos_game_language") dos_parse_language(val, &dos->game_language);
+        else if (key == "dos_content_profile") dos_parse_content_profile(val, &dos->content_profile);
+        else if (key == "dos_enhanced_intro" && parse_bool_ini(val, &btmp)) dos->enhanced_intro = btmp;
+        else if (key == "dos_active_campaign" && !val.empty() && val.size() <= 48 &&
+                 val.find("..") == std::string::npos && val.find('/') == std::string::npos &&
+                 val.find('\\') == std::string::npos) {
+            dos->active_campaign = val;
+        } else if (key == "dos_active_character_pack" && !val.empty() && val.size() <= 48 &&
+                   val.find("..") == std::string::npos && val.find('/') == std::string::npos &&
+                   val.find('\\') == std::string::npos) {
+            dos->active_character_pack = val;
+        } else if (key == "dos_allow_unverified_mods" && parse_bool_ini(val, &btmp)) {
+            dos->allow_unverified_mods = btmp;
+        } else if (key == "dos_randomizer_seed" && val.size() <= 32) {
+            dos->randomizer_seed = val;
+        } else if (key == "dos_randomizer_preset" &&
+                   (val == "casual" || val == "standard" || val == "hard")) {
+            dos->randomizer_preset = val;
+        } else if (key == "dos_button_prompts") dos_parse_button_prompts(val, &dos->button_prompts);
+        else if (key == "dos_internal_resolution" && internal_resolution && parse_int_range(val, 1, 12, &tmp))
+            *internal_resolution = static_cast<uint8_t>(tmp);
+        else if (key == "dos_texture_upscale" && texture_upscale &&
+                 (val == "1" || val == "2" || val == "4"))
+            *texture_upscale = static_cast<uint8_t>(std::atoi(val.c_str()));
+        else if (key == "dos_keyboard_primary" && key_primary)
+            nds_parse_bindings(val, false, key_primary);
+        else if (key == "dos_keyboard_secondary")
+            nds_parse_bindings(val, false, &dos->secondary_keyboard_bindings);
+        else if (key == "dos_gamepad_bindings" && gamepad_bindings &&
+                 nds_parse_bindings(val, true, gamepad_bindings) && custom_gamepad)
+            *custom_gamepad = true;
+    }
+    if (has_hud_mode) {
+        dos->dev_hud = (dos->hud_mode != DosHudMode::Off);
+    } else {
+        dos->hud_mode = dos->dev_hud ? DosHudMode::Full : DosHudMode::Off;
+    }
+    return true;
+}
+
+bool dos_save_settings_ini(const std::string& path,
+                           NdsScreenLayout layout,
+                           NdsPipCorner pip_corner,
+                           NdsPipMainScreen pip_main,
+                           int fullscreen_mode,
+                           const NdsButtonBindings& key_primary,
+                           const NdsButtonBindings& gamepad_bindings,
+                           bool custom_gamepad,
+                           uint8_t internal_resolution,
+                           uint8_t texture_upscale,
+                           const DosEnhancementSettings& dos) {
+    if (path.empty()) return false;
+    const std::filesystem::path fs_path(path);
+    std::error_code ec;
+    if (!fs_path.parent_path().empty()) {
+        std::filesystem::create_directories(fs_path.parent_path(), ec);
+        if (ec) return false;
+    }
+
+    const char* fs_str = (fullscreen_mode == 1) ? "borderless"
+                         : (fullscreen_mode == 2) ? "exclusive"
+                                                  : "off";
+    const bool eff_hud = (dos.hud_mode != DosHudMode::Off) || dos.dev_hud;
+    const DosHudMode eff_hud_mode =
+        (dos.hud_mode != DosHudMode::Off) ? dos.hud_mode
+                                          : (dos.dev_hud ? DosHudMode::Full : DosHudMode::Off);
+    const std::array<std::pair<const char*, std::string>, 41> kv = {{
+        {"dos_layout", layout_to_ini_name(layout)},
+        {"dos_pip_corner", corner_to_ini_name(pip_corner)},
+        {"dos_pip_main", pip_main == NdsPipMainScreen::Bottom ? "bottom" : "top"},
+        {"dos_fullscreen", fs_str},
+        {"dos_aspect_mode", dos_aspect_mode_name(dos.aspect_mode)},
+        {"dos_render_driver", dos_render_driver_name(dos.render_driver)},
+        {"dos_hd_filter", dos_hd_filter_name(dos.hd_filter)},
+        {"dos_post_fx", dos_post_fx_name(dos.post_fx)},
+        {"dos_color_mode", dos_color_mode_name(dos.color_mode)},
+        {"dos_sharpen", dos_sharpen_mode_name(dos.sharpen)},
+        {"dos_audio_mode", dos_audio_mode_name(dos.audio_mode)},
+        {"dos_audio_enabled", dos.audio_enabled ? "1" : "0"},
+        {"dos_audio_volume", std::to_string(dos.audio_volume)},
+        {"dos_audio_fx", std::to_string(dos.audio_fx_pct)},
+        {"dos_dev_hud", eff_hud ? "1" : "0"},
+        {"dos_hud_mode", dos_hud_mode_name(eff_hud_mode)},
+        {"dos_pip_opacity", std::to_string(dos.pip_opacity_pct)},
+        {"dos_pip_size", std::to_string(dos.pip_size_pct)},
+        {"dos_brightness", std::to_string(dos.brightness_pct)},
+        {"dos_contrast", std::to_string(dos.contrast_pct)},
+        {"dos_saturation", std::to_string(dos.saturation_pct)},
+        {"dos_vignette", std::to_string(dos.vignette_pct)},
+        {"dos_stick_deadzone", std::to_string(dos.stick_deadzone_pct)},
+        {"dos_vsync", dos.vsync ? "1" : "0"},
+        {"dos_skip_launcher", dos.skip_launcher ? "1" : "0"},
+        {"dos_pause_on_menu", dos.pause_on_menu ? "1" : "0"},
+        {"dos_pause_unfocused", dos.pause_unfocused ? "1" : "0"},
+        {"dos_mute_unfocused", dos.mute_unfocused ? "1" : "0"},
+        {"dos_ui_language", dos_language_name(dos.ui_language)},
+        {"dos_game_language", dos_language_name(dos.game_language)},
+        {"dos_content_profile", dos_content_profile_name(dos.content_profile)},
+        {"dos_enhanced_intro", dos.enhanced_intro ? "1" : "0"},
+        {"dos_active_campaign", dos.active_campaign.empty() ? "dawn-of-sorrow" : dos.active_campaign},
+        {"dos_active_character_pack", dos.active_character_pack.empty() ? "default" : dos.active_character_pack},
+        {"dos_allow_unverified_mods", dos.allow_unverified_mods ? "1" : "0"},
+        {"dos_randomizer_seed", dos.randomizer_seed},
+        {"dos_randomizer_preset", dos.randomizer_preset.empty() ? "standard" : dos.randomizer_preset},
+        {"dos_button_prompts", dos_button_prompts_name(dos.button_prompts)},
+        {"dos_internal_resolution", std::to_string(internal_resolution)},
+        {"dos_texture_upscale", std::to_string(texture_upscale)},
+        {"dos_keyboard_primary", nds_format_bindings(key_primary)},
+    }};
+
+    const size_t kSecIdx = kv.size();
+    const size_t kPadIdx = kv.size() + 1;
+    std::vector<std::string> lines;
+    std::vector<bool> written(kv.size() + 2, false);
+    {
+        std::ifstream in(path);
+        std::string line;
+        while (std::getline(in, line)) {
+            const size_t eq = line.find('=');
+            const std::string key = eq == std::string::npos ? "" : line.substr(0, eq);
+            bool replaced = false;
+            for (size_t i = 0; i < kv.size(); ++i) {
+                if (key == kv[i].first) {
+                    lines.push_back(std::string(kv[i].first) + "=" + kv[i].second);
+                    written[i] = true;
+                    replaced = true;
+                    break;
+                }
+            }
+            if (!replaced && key == "dos_keyboard_secondary") {
+                lines.push_back("dos_keyboard_secondary=" + nds_format_bindings(dos.secondary_keyboard_bindings));
+                written[kSecIdx] = true;
+                replaced = true;
+            }
+            if (!replaced && custom_gamepad && key == "dos_gamepad_bindings") {
+                lines.push_back("dos_gamepad_bindings=" + nds_format_bindings(gamepad_bindings));
+                written[kPadIdx] = true;
+                replaced = true;
+            }
+            if (!replaced) lines.push_back(line);
+        }
+    }
+    for (size_t i = 0; i < kv.size(); ++i) {
+        if (!written[i])
+            lines.push_back(std::string(kv[i].first) + "=" + kv[i].second);
+    }
+    if (!written[kSecIdx])
+        lines.push_back("dos_keyboard_secondary=" + nds_format_bindings(dos.secondary_keyboard_bindings));
+    if (custom_gamepad && !written[kPadIdx])
+        lines.push_back("dos_gamepad_bindings=" + nds_format_bindings(gamepad_bindings));
+
+    // Escrita atomica (tmp + rename) para evitar corrupcao de dos-settings.ini.
+    const std::filesystem::path tmp_path =
+        fs_path.parent_path() / (fs_path.filename().string() + ".tmp");
+    {
+        std::ofstream out(tmp_path, std::ios::binary | std::ios::trunc);
+        if (!out) return false;
+        for (const auto& l : lines) out << l << '\n';
+        out.flush();
+        if (!out) {
+            out.close();
+            std::filesystem::remove(tmp_path, ec);
+            return false;
+        }
+    }
+    std::filesystem::rename(tmp_path, fs_path, ec);
+    if (ec) {
+        std::error_code ec2;
+        std::filesystem::remove(fs_path, ec2);
+        ec.clear();
+        std::filesystem::rename(tmp_path, fs_path, ec);
+        if (ec) {
+            std::filesystem::remove(tmp_path, ec2);
+            return false;
+        }
+    }
+    return true;
+}
