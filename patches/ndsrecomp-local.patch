+        DosStrId::CornerTopLeft, DosStrId::CornerTopRight,
+        DosStrId::CornerBottomLeft, DosStrId::CornerBottomRight};
+    if (combo_enum(dos_tr(lang, DosStrId::LblPipCorner), &opt->pip_corner,
+                   kCorners, kCornerNames, lang)) {
