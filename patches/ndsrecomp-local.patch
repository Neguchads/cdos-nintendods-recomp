+    if ((opt->adaptive_supported & NDS_ADAPTIVE_BOTTOM) != 0u) {
+        if (ImGui::Checkbox(dos_tr(lang, DosStrId::LblTrueWidescreen),
+                            &opt->dos.true_widescreen)) {
+            mark_dirty(ctx, true);
+        }
+        ImGui::TextWrapped("%s", dos_tr(lang, DosStrId::HintTrueWidescreen));
+        if (!opt->dos.true_widescreen) ImGui::BeginDisabled();
+        static constexpr std::array<DosWideHudMode, 2> kWideHudModes = {
