+uint32_t test_crc32(const uint8_t* data, size_t len) {
+    uint32_t crc = 0xFFFFFFFFu;
+    for (size_t i = 0; i < len; ++i) {
+        crc ^= data[i];
+        for (int b = 0; b < 8; ++b) {
+            crc = (crc >> 1) ^ ((crc & 1u) ? 0xEDB88320u : 0u);
+        }
+    }
+    return ~crc;
+}
+
+void push_le32(std::vector<uint8_t>& out, uint32_t v) {
+    out.push_back(static_cast<uint8_t>(v & 0xFFu));
+    out.push_back(static_cast<uint8_t>((v >> 8) & 0xFFu));
+    out.push_back(static_cast<uint8_t>((v >> 16) & 0xFFu));
+    out.push_back(static_cast<uint8_t>((v >> 24) & 0xFFu));
+}
+
+void test_rom_patch() {
+    std::vector<uint8_t> base(512, 0x20u);
+    std::vector<uint8_t> target = base;
+    const char* msg = "CASTLEVANIA-PTBR";
+    std::memcpy(target.data() + 128, msg, std::strlen(msg));
+
+    const auto src_sha1 = gba::sha1(base.data(), base.size()).bytes;
+    const auto dst_sha1 = gba::sha1(target.data(), target.size()).bytes;
+
+    std::vector<uint8_t> payload;
+    push_le32(payload, 128u);
+    push_le32(payload, static_cast<uint32_t>(std::strlen(msg)));
+    payload.insert(payload.end(), msg, msg + std::strlen(msg));
+    const uint32_t crc = test_crc32(payload.data(), payload.size());
+
+    std::vector<uint8_t> patch;
+    patch.insert(patch.end(), {'D', 'O', 'S', 'P', 'A', 'T', 'C', 'H'});
+    push_le32(patch, 1u);
+    push_le32(patch, static_cast<uint32_t>(target.size()));
+    patch.insert(patch.end(), src_sha1.begin(), src_sha1.end());
+    patch.insert(patch.end(), dst_sha1.begin(), dst_sha1.end());
+    push_le32(patch, 1u);
+    push_le32(patch, crc);
+    patch.insert(patch.end(), payload.begin(), payload.end());
+
+    std::vector<uint8_t> patched;
+    std::string err;
+    assert(dos_rom_patch_apply_bytes(base, patch.data(), patch.size(), &patched, &err));
+    assert(patched == target);
+
+    auto bad_magic = patch;
+    bad_magic[0] = 'X';
+    assert(!dos_rom_patch_apply_bytes(base, bad_magic.data(), bad_magic.size(), &patched, &err));
+
+    auto wrong_base = base;
+    wrong_base[0] ^= 1u;
+    assert(!dos_rom_patch_apply_bytes(wrong_base, patch.data(), patch.size(), &patched, &err));
+
+    auto bad_crc = patch;
+    bad_crc.back() ^= 0xFFu;
+    assert(!dos_rom_patch_apply_bytes(base, bad_crc.data(), bad_crc.size(), &patched, &err));
+
+    // Out-of-bounds offset/length must fail closed.
+    std::vector<uint8_t> oob_payload;
+    push_le32(oob_payload, 508u);
+    push_le32(oob_payload, 8u);
+    oob_payload.insert(oob_payload.end(), 8u, 0xAAu);
+    std::vector<uint8_t> oob_patch = patch;
+    oob_patch.resize(64);
+    const uint32_t oob_crc = test_crc32(oob_payload.data(), oob_payload.size());
+    oob_patch[60] = static_cast<uint8_t>(oob_crc & 0xFFu);
+    oob_patch[61] = static_cast<uint8_t>((oob_crc >> 8) & 0xFFu);
+    oob_patch[62] = static_cast<uint8_t>((oob_crc >> 16) & 0xFFu);
+    oob_patch[63] = static_cast<uint8_t>((oob_crc >> 24) & 0xFFu);
+    oob_patch.insert(oob_patch.end(), oob_payload.begin(), oob_payload.end());
+    assert(!dos_rom_patch_apply_bytes(base, oob_patch.data(), oob_patch.size(), &patched, &err));
+}
