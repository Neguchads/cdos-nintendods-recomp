+    for (size_t i = 0; i < kSiteCount; ++i) {
+        if (!read_main_ram_word(kDosWideSites[i].addr, &cur_words[i]) ||
+            (cur_words[i] != kDosWideSites[i].native_word &&
+             cur_words[i] != kDosWideSites[i].wide_word)) {
+            preflight_ok = false;
+            break;
+        }
+    }
+
