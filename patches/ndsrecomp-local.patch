+    if (ImGui::SliderInt(dos_tr(lang, DosStrId::LblPipSize), &pip_size, 20, 50, "%d%%")) {
+        opt->dos.pip_size_pct = static_cast<uint8_t>(pip_size);
+        mark_dirty(ctx, true);
+    }
+    int pip_op = static_cast<int>(opt->dos.pip_opacity_pct);
+    if (ImGui::SliderInt(dos_tr(lang, DosStrId::LblPipOpacity), &pip_op, 25, 100, "%d%%")) {
+        opt->dos.pip_opacity_pct = static_cast<uint8_t>(pip_op);
+        mark_dirty(ctx, true);
+    }
+    if (!is_pip) ImGui::EndDisabled();
+
+    static constexpr std::array<DosAspectMode, 7> kAspects = {
+        DosAspectMode::Stretch, DosAspectMode::Letterbox,
+        DosAspectMode::SmartCrop16x9, DosAspectMode::Balanced16x10,
+        DosAspectMode::Ultrawide21x9, DosAspectMode::Integer,
+        DosAspectMode::Auto};
+    static constexpr std::array<DosStrId, 7> kAspectNames = {
+        DosStrId::AspectStretch, DosStrId::AspectLetterbox,
+        DosStrId::AspectSmartCrop16x9, DosStrId::AspectBalanced16x10,
+        DosStrId::AspectUltrawide21x9, DosStrId::AspectInteger,
+        DosStrId::AspectAuto};
+    if (combo_enum(dos_tr(lang, DosStrId::LblAspectMode), &opt->dos.aspect_mode,
+                   kAspects, kAspectNames, lang)) {
+        mark_dirty(ctx, true);
