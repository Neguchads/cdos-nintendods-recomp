+}  // namespace
+
+DosImGuiMenu::~DosImGuiMenu() {
+    shutdown();
+}
+
+bool DosImGuiMenu::init(SDL_Window* window, SDL_Renderer* renderer) {
+    if (initialized_) return true;
+    if (!window || !renderer) return false;
+
+    ImGuiContext* im_ctx = ImGui::CreateContext();
+    if (!im_ctx) return false;
+    imgui_context_ = im_ctx;
+    ImGui::SetCurrentContext(im_ctx);
+
+    ImGuiIO& io = ImGui::GetIO();
+    io.IniFilename = nullptr;
+    io.MouseDrawCursor = false;
+    io.ConfigFlags |= ImGuiConfigFlags_NavEnableKeyboard;
+    io.ConfigFlags |= ImGuiConfigFlags_NavEnableGamepad;
+
+    if (const char* ttf = find_system_ttf_font()) {
+        body_font_ = io.Fonts->AddFontFromFileTTF(ttf, 17.0f, nullptr, kLatinExtendedRanges);
+        heading_font_ = io.Fonts->AddFontFromFileTTF(ttf, 22.0f, nullptr, kLatinExtendedRanges);
+    }
+    if (!body_font_) {
+        body_font_ = io.Fonts->AddFontDefault();
+        heading_font_ = body_font_;
+    }
+
+    apply_metroid_castlevania_theme();
+
+    if (!ImGui_ImplSDL3_InitForSDLRenderer(window, renderer)) {
+        shutdown();
+        return false;
+    }
+    sdl_backend_ready_ = true;
+
+    if (!ImGui_ImplSDLRenderer3_Init(renderer)) {
+        shutdown();
+        return false;
+    }
+    renderer_backend_ready_ = true;
+    initialized_ = true;
+    return true;
+}
+
+void DosImGuiMenu::shutdown() {
+    if (imgui_context_) {
+        ImGui::SetCurrentContext(static_cast<ImGuiContext*>(imgui_context_));
+        if (renderer_backend_ready_) {
+            ImGui_ImplSDLRenderer3_Shutdown();
+            renderer_backend_ready_ = false;
+        }
+        if (sdl_backend_ready_) {
+            ImGui_ImplSDL3_Shutdown();
+            sdl_backend_ready_ = false;
+        }
+        ImGui::DestroyContext(static_cast<ImGuiContext*>(imgui_context_));
+        imgui_context_ = nullptr;
+    }
+    body_font_ = nullptr;
+    heading_font_ = nullptr;
+    initialized_ = false;
+    open_ = false;
+}
+
+void DosImGuiMenu::set_open(bool open, int tab) {
+    open_ = open;
+    if (tab >= 0 && tab < 7) active_tab_ = tab;
+    if (!open_) {
+        capture_kind_ = CaptureKind::None;
+        capture_row_ = -1;
+    }
+}
+
+void DosImGuiMenu::toggle_open() {
+    set_open(!open_);
+}
+
+void DosImGuiMenu::push_toast(const std::string& title, const std::string& body,
+                              double seconds) {
+    toast_title_ = title;
+    toast_body_ = body;
+    const uint64_t ms = static_cast<uint64_t>(std::max(0.5, seconds) * 1000.0);
+    toast_expire_ms_ = SDL_GetTicks() + ms;
+}
+
+void DosImGuiMenu::record_frame_sample(double fps, double emu_ms, double present_ms) {
+    fps_history_[static_cast<size_t>(fps_history_offset_)] = static_cast<float>(fps);
+    fps_history_offset_ = (fps_history_offset_ + 1) % 120;
+    if (fps_history_count_ < 120) ++fps_history_count_;
+    last_emu_ms_ = emu_ms;
+    last_present_ms_ = present_ms;
+}
+
+bool DosImGuiMenu::process_event(const SDL_Event* event, DosImGuiMenuContext& ctx) {
+    if (!initialized_ || !event || !imgui_context_) return false;
+    ImGui::SetCurrentContext(static_cast<ImGuiContext*>(imgui_context_));
+
+    if (!open_) return false;
+
+    if (suppress_mouse_up_button_ != 0 &&
+        event->type == SDL_EVENT_MOUSE_BUTTON_UP &&
+        event->button.button == suppress_mouse_up_button_) {
+        suppress_mouse_up_button_ = 0;
+        return true;
+    }
+
+    if (capture_kind_ != CaptureKind::None) {
+        if (event->type == SDL_EVENT_KEY_DOWN && !event->key.repeat) {
+            const int sc = static_cast<int>(event->key.scancode);
+            if (sc != SDL_SCANCODE_ESCAPE && ctx.options &&
+                capture_row_ >= 0 && capture_row_ < 12) {
+                const int val = (sc == SDL_SCANCODE_DELETE || sc == SDL_SCANCODE_BACKSPACE)
+                                    ? 0
+                                    : sc;
+                if (capture_kind_ == CaptureKind::KeyPrimary) {
+                    ctx.options->keyboard_bindings[static_cast<size_t>(capture_row_)] = val;
+                } else if (capture_kind_ == CaptureKind::KeySecondary) {
+                    ctx.options->dos.secondary_keyboard_bindings[static_cast<size_t>(capture_row_)] = val;
+                } else if (capture_kind_ == CaptureKind::Pad && val == 0) {
+                    if (!ctx.options->custom_gamepad_bindings) {
+                        ctx.options->gamepad_bindings = kNdsDefaultPad;
+                        ctx.options->custom_gamepad_bindings = true;
+                    }
+                    ctx.options->gamepad_bindings[static_cast<size_t>(capture_row_)] = 0;
+                }
+                if (ctx.settings_dirty) *ctx.settings_dirty = true;
+            }
+            capture_kind_ = CaptureKind::None;
+            capture_row_ = -1;
+            return true;
+        }
+        if (event->type == SDL_EVENT_MOUSE_BUTTON_DOWN &&
+            (capture_kind_ == CaptureKind::KeyPrimary ||
+             capture_kind_ == CaptureKind::KeySecondary) &&
+            ctx.options && capture_row_ >= 0 && capture_row_ < 12) {
+            const int mcode = dos_mouse_button_to_binding(event->button.button);
+            if (mcode != 0) {
+                if (capture_kind_ == CaptureKind::KeyPrimary) {
+                    ctx.options->keyboard_bindings[static_cast<size_t>(capture_row_)] = mcode;
+                } else {
+                    ctx.options->dos.secondary_keyboard_bindings[static_cast<size_t>(capture_row_)] = mcode;
+                }
+                if (ctx.settings_dirty) *ctx.settings_dirty = true;
+                suppress_mouse_up_button_ = event->button.button;
+                capture_kind_ = CaptureKind::None;
+                capture_row_ = -1;
+            }
+            return true;
+        }
+        if (event->type == SDL_EVENT_GAMEPAD_BUTTON_DOWN && capture_kind_ == CaptureKind::Pad &&
+            ctx.options && capture_row_ >= 0 && capture_row_ < 12) {
+            if (!ctx.options->custom_gamepad_bindings) {
+                ctx.options->gamepad_bindings = kNdsDefaultPad;
+                ctx.options->custom_gamepad_bindings = true;
+            }
+            ctx.options->gamepad_bindings[static_cast<size_t>(capture_row_)] =
+                static_cast<int>(event->gbutton.button) + 1;
+            if (ctx.settings_dirty) *ctx.settings_dirty = true;
+            capture_kind_ = CaptureKind::None;
+            capture_row_ = -1;
+            return true;
+        }
+        return true;
+    }
+
+    if (event->type == SDL_EVENT_KEY_DOWN && !event->key.repeat) {
+        if (event->key.scancode == SDL_SCANCODE_F1 ||
+            event->key.scancode == SDL_SCANCODE_ESCAPE) {
+            set_open(false);
+            return true;
+        }
+    }
+
+    if (event->type == SDL_EVENT_GAMEPAD_BUTTON_DOWN) {
+        const auto btn = static_cast<SDL_GamepadButton>(event->gbutton.button);
+        if (btn == SDL_GAMEPAD_BUTTON_LEFT_SHOULDER) {
+            active_tab_ = (active_tab_ + 6) % 7;
+            return true;
+        }
+        if (btn == SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER) {
+            active_tab_ = (active_tab_ + 1) % 7;
+            return true;
+        }
+        if (btn == SDL_GAMEPAD_BUTTON_START || btn == SDL_GAMEPAD_BUTTON_GUIDE) {
+            set_open(false);
+            return true;
+        }
+    }
+
+    ImGui_ImplSDL3_ProcessEvent(event);
+    return true;
+}
+
+void DosImGuiMenu::render(SDL_Renderer* renderer, DosImGuiMenuContext& ctx) {
+    if (!initialized_ || !renderer || !imgui_context_) return;
+
+    const bool toast_active = !toast_title_.empty() && SDL_GetTicks() < toast_expire_ms_;
+    if (!toast_active) {
+        toast_title_.clear();
+        toast_body_.clear();
+    }
+    if (!open_ && !toast_active) return;
+
+    ImGui::SetCurrentContext(static_cast<ImGuiContext*>(imgui_context_));
+
+    int out_w = 0, out_h = 0;
+    SDL_GetCurrentRenderOutputSize(renderer, &out_w, &out_h);
+    if (out_w <= 0 || out_h <= 0) return;
+
+    int saved_lw = 0, saved_lh = 0;
+    SDL_RendererLogicalPresentation saved_lmode = SDL_LOGICAL_PRESENTATION_DISABLED;
+    SDL_GetRenderLogicalPresentation(renderer, &saved_lw, &saved_lh, &saved_lmode);
+    if (saved_lmode != SDL_LOGICAL_PRESENTATION_DISABLED) {
+        SDL_SetRenderLogicalPresentation(renderer, 0, 0, SDL_LOGICAL_PRESENTATION_DISABLED);
+    }
+
+    ImGui_ImplSDLRenderer3_NewFrame();
+    ImGui_ImplSDL3_NewFrame();
+    ImGui::NewFrame();
+
+    ImGuiIO& io = ImGui::GetIO();
+    const float disp_w = std::max(1.0f, io.DisplaySize.x);
+    const float disp_h = std::max(1.0f, io.DisplaySize.y);
+
+    const DosLanguage lang =
+        ctx.options ? ctx.options->dos.ui_language : DosLanguage::English;
+    ImFont* head = static_cast<ImFont*>(heading_font_);
+
+    if (open_) {
+        const float margin_x = std::max(16.0f, disp_w * 0.04f);
+        const float margin_y = std::max(16.0f, disp_h * 0.04f);
+        const float win_w = std::min(1120.0f, std::max(300.0f, disp_w - margin_x * 2.0f));
+        const float win_h = std::min(760.0f, std::max(260.0f, disp_h - margin_y * 2.0f));
+        ImGui::SetNextWindowPos(ImVec2((disp_w - win_w) * 0.5f, (disp_h - win_h) * 0.5f),
+                                ImGuiCond_Always);
+        ImGui::SetNextWindowSize(ImVec2(win_w, win_h), ImGuiCond_Always);
+
+        constexpr ImGuiWindowFlags kFlags =
+            ImGuiWindowFlags_NoResize | ImGuiWindowFlags_NoMove |
+            ImGuiWindowFlags_NoCollapse | ImGuiWindowFlags_NoTitleBar;
+
+        if (ImGui::Begin("##DosOverlay", nullptr, kFlags)) {
+            if (head) ImGui::PushFont(head);
+            ImGui::TextColored(ImVec4(0.95f, 0.28f, 0.36f, 1.0f), "CASTLEVANIA");
+            ImGui::SameLine();
+            ImGui::TextColored(ImVec4(0.92f, 0.95f, 0.98f, 1.0f),
+                               "·  %s", dos_tr(lang, DosStrId::AppSubtitle));
+            if (head) ImGui::PopFont();
+            ImGui::Separator();
+            ImGui::Spacing();
+
+            const float footer_h = 34.0f;
+            const float body_h = std::max(120.0f, ImGui::GetContentRegionAvail().y - footer_h);
+            const float sidebar_w = std::clamp(win_w * 0.23f, 148.0f, 220.0f);
+
+            if (ImGui::BeginChild("##Sidebar", ImVec2(sidebar_w, body_h), ImGuiChildFlags_Borders)) {
+                static constexpr std::array<DosStrId, 7> kTabs = {
+                    DosStrId::TabHome, DosStrId::TabDisplay, DosStrId::TabGraphics,
+                    DosStrId::TabAudio, DosStrId::TabControls, DosStrId::TabMods,
+                    DosStrId::TabPerformance};
+                for (int i = 0; i < 7; ++i) {
+                    const bool selected = (active_tab_ == i);
+                    if (selected) {
+                        ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.76f, 0.17f, 0.24f, 0.95f));
+                    }
+                    if (ImGui::Button(dos_tr(lang, kTabs[static_cast<size_t>(i)]),
+                                      ImVec2(-1.0f, 36.0f))) {
+                        active_tab_ = i;
+                        capture_kind_ = CaptureKind::None;
+                        capture_row_ = -1;
+                    }
+                    if (selected) ImGui::PopStyleColor();
+                }
+            }
+            ImGui::EndChild();
+
+            ImGui::SameLine();
+            if (ImGui::BeginChild("##Content", ImVec2(0.0f, body_h), ImGuiChildFlags_Borders)) {
+                auto begin_cap = [&](int kind, int row) {
+                    capture_kind_ = static_cast<CaptureKind>(kind);
+                    capture_row_ = row;
+                };
+                int cap_row = capture_row_;
+                switch (active_tab_) {
+                    case 0: draw_tab_home(ctx, lang, head, open_); break;
+                    case 1: draw_tab_display(ctx, lang, head); break;
+                    case 2: draw_tab_graphics(ctx, lang, head, *this); break;
+                    case 3: draw_tab_audio(ctx, lang, head); break;
+                    case 4:
+                        draw_tab_controls(ctx, lang, head,
+                                          static_cast<int>(capture_kind_), cap_row,
+                                          begin_cap, *this);
+                        break;
+                    case 5:
+                        draw_tab_mods(ctx, lang, head);
+                        break;
+                    case 6:
+                        draw_tab_performance(ctx, lang, head, fps_history_.data(),
+                                             fps_history_count_, fps_history_offset_,
+                                             last_emu_ms_, last_present_ms_);
+                        break;
+                    default: break;
+                }
+            }
+            ImGui::EndChild();
+
+            ImGui::Separator();
+            ImGui::TextDisabled("%s", select_footer_text(ctx, lang));
+        }
+        ImGui::End();
+    }
+
+    if (toast_active) {
+        ImGui::SetNextWindowPos(ImVec2(disp_w - 24.0f, 24.0f),
+                                ImGuiCond_Always, ImVec2(1.0f, 0.0f));
+        ImGui::SetNextWindowBgAlpha(0.88f);
+        constexpr ImGuiWindowFlags kToastFlags =
+            ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_AlwaysAutoResize |
+            ImGuiWindowFlags_NoSavedSettings | ImGuiWindowFlags_NoFocusOnAppearing |
+            ImGuiWindowFlags_NoNav | ImGuiWindowFlags_NoMove;
+        if (ImGui::Begin("##DosToast", nullptr, kToastFlags)) {
+            ImGui::TextColored(ImVec4(0.32f, 0.80f, 0.98f, 1.0f), "%s",
+                               toast_title_.c_str());
+            if (!toast_body_.empty()) {
+                ImGui::TextUnformatted(toast_body_.c_str());
+            }
+        }
+        ImGui::End();
+    }
+
+    ImGui::Render();
+    ImGui_ImplSDLRenderer3_RenderDrawData(ImGui::GetDrawData(), renderer);
+
+    if (saved_lmode != SDL_LOGICAL_PRESENTATION_DISABLED) {
+        SDL_SetRenderLogicalPresentation(renderer, saved_lw, saved_lh, saved_lmode);
+    }
+}
+
+#else
+
+DosImGuiMenu::~DosImGuiMenu() = default;
+bool DosImGuiMenu::init(SDL_Window*, SDL_Renderer*) { return false; }
+void DosImGuiMenu::shutdown() {}
+void DosImGuiMenu::set_open(bool, int) {}
+void DosImGuiMenu::toggle_open() {}
+void DosImGuiMenu::push_toast(const std::string&, const std::string&, double) {}
+void DosImGuiMenu::record_frame_sample(double, double, double) {}
+bool DosImGuiMenu::process_event(const SDL_Event*, DosImGuiMenuContext&) { return false; }
+void DosImGuiMenu::render(SDL_Renderer*, DosImGuiMenuContext&) {}
+
+#endif
