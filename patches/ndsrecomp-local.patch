+DosControlPreset dos_detect_control_preset(const NdsButtonBindings& primary,
+                                           const NdsButtonBindings& gamepad,
+                                           bool custom_gamepad) {
+    if (primary == kModernArrowsKeys) return DosControlPreset::ModernArrows;
+    if (primary == kModernWasdKeys || (custom_gamepad && gamepad == kModernGamepad))
+        return DosControlPreset::ModernWasd;
+    return DosControlPreset::ClassicNds;
+}
+
+void dos_apply_control_preset(DosControlPreset preset,
+                              NdsButtonBindings* primary_key,
+                              NdsButtonBindings* secondary_key,
+                              NdsButtonBindings* gamepad,
+                              bool* custom_gamepad) {
+    if (!primary_key || !secondary_key || !gamepad || !custom_gamepad) return;
+    if (preset == DosControlPreset::ModernWasd) {
+        *primary_key = kModernWasdKeys;
+        *secondary_key = kModernWasdSecondaryKeys;
+        *gamepad = kModernGamepad;
+        *custom_gamepad = true;
+    } else if (preset == DosControlPreset::ModernArrows) {
+        *primary_key = kModernArrowsKeys;
+        *secondary_key = kModernWasdKeys;
+        *gamepad = kModernGamepad;
+        *custom_gamepad = true;
+    } else {
+        *primary_key = kNdsDefaultKeys;
+        secondary_key->fill(0);
+        *gamepad = kNdsDefaultPad;
+        *custom_gamepad = false;
+    }
+}
