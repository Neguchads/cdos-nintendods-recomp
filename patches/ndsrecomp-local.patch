+void apply_live_presentation(const NdsFrontendOptions& options,
+                             FrontendPresentation& presentation,
+                             NdsScreenPlacement& touch_placement,
+                             NdsScreenRect& bottom_touch_rect,
+                             int& bottom_logical_width,
+                             int& bottom_content_left,
+                             int& top_content_left,
+                             NdsLogicalRect& stacked_top_screen,
+                             NdsLogicalRect& stacked_bottom_touch) {
+    if (presentation.windows[0]) {
+        set_window_fullscreen(presentation.windows[0], options.fullscreen);
+    }
+    presentation.aspect_mode = options.dos.aspect_mode;
+    presentation.hd_filter = options.dos.hd_filter;
+    presentation.pip_corner = options.pip_corner;
+    presentation.pip_main = nds_pip_swap_allowed(options)
+                                ? options.pip_main_screen
+                                : NdsPipMainScreen::Top;
+    presentation.pip_size_pct = std::clamp<uint8_t>(options.dos.pip_size_pct, 20u, 50u);
