+void dos_custom_music_set_dir(const std::string& music_dir) {
+    {
+        std::lock_guard<std::mutex> lock(g_music.mu);
+        g_music.music_dir = music_dir;
+    }
+    dos_custom_music_rescan();
+}
+
+size_t dos_custom_music_rescan() {
+    std::lock_guard<std::mutex> lock(g_music.mu);
+    g_music.available_files.clear();
+    g_music.auto_bindings.clear();
+    g_music.manifest_tracks.clear();
+    g_music.bindings.clear();
+    g_music.loaded_path.clear();
+    g_music.jukebox_advance_pending.store(false, std::memory_order_relaxed);
+    if (g_music.music_dir.empty()) return 0;
+
+    std::error_code ec;
+    const fs::path dir(g_music.music_dir);
+    if (!fs::is_directory(dir, ec)) return 0;
+
+    // 1. Scan de TODOS os arquivos .wav/.mp3/.ogg na raiz de {data}/mods/music/ (qualquer nome!)
+    std::vector<fs::path> files;
+    for (const auto& entry : fs::directory_iterator(dir, ec)) {
+        if (ec) break;
+        if (!entry.is_regular_file(ec)) continue;
+        if (has_supported_audio_ext(entry.path().string())) {
+            files.push_back(entry.path());
+        }
+    }
+    std::sort(files.begin(), files.end());
+
+    for (const auto& p : files) {
+        g_music.available_files.push_back(p.filename().string());
+        const int tid = dos_bgm_find_track_by_key(p.stem().string());
+        if (tid < 0) continue;
+        DosCustomTrackBinding b{};
+        b.track_id = static_cast<uint8_t>(tid);
+        b.file_path = p.string();
+        b.file_label = p.filename().string();
+        b.loop = kBgmCatalog[static_cast<size_t>(tid)].default_loop;
+        g_music.auto_bindings[b.track_id] = std::move(b);
+    }
+
+    // 2. Manifesto opcional music.json (jukebox + tracks com loop/gain_db)
+    JukeboxManifestConfig jb{};
+    rebuild_effective_bindings_locked();
+    parse_optional_music_manifest(dir, &g_music.manifest_tracks, &g_music.bindings, &jb);
+    if (jb.present) {
+        g_music.jukebox_enabled = jb.enabled;
+        g_music.jukebox_shuffle = jb.shuffle;
+        g_music.jukebox_playlist = std::move(jb.playlist);
+        if (g_music.jukebox_playlist.empty()) {
+            g_music.jukebox_index = 0;
+        } else if (g_music.jukebox_index >= g_music.jukebox_playlist.size()) {
+            g_music.jukebox_index = 0;
+        }
+    } else {
+        g_music.jukebox_enabled = false;
+        g_music.jukebox_shuffle = false;
+        g_music.jukebox_playlist.clear();
+        g_music.jukebox_index = 0;
+    }
+
+    if (!g_music.bindings.empty() || !g_music.available_files.empty()) {
+        std::fprintf(stderr,
+                     "[custom-music] scanned %s -> %zu file(s), %zu track binding(s), jukebox=%s (%zu)\n",
+                     g_music.music_dir.c_str(),
+                     g_music.available_files.size(),
+                     g_music.bindings.size(),
+                     g_music.jukebox_enabled ? "on" : "off",
+                     g_music.jukebox_playlist.size());
+    }
+    if (jukebox_active_locked()) {
+        start_jukebox_index_locked(g_music.jukebox_index, false);
+    } else if (g_music.enabled && g_music.active_bgm_id >= 0) {
+        activate_track_locked(g_music.active_bgm_id, true);
+    } else {
+        g_music.active_playing = false;
+    }
+    return g_music.bindings.size();
+}
+
+void dos_custom_music_set_enabled(bool enabled) {
+    std::lock_guard<std::mutex> lock(g_music.mu);
+    const bool was_enabled = g_music.enabled;
+    g_music.enabled = enabled;
+    if (!enabled) {
+        g_music.active_playing = false;
+    } else if (!was_enabled) {
+        if (jukebox_active_locked()) {
+            start_jukebox_index_locked(g_music.jukebox_index, false);
+        } else if (g_music.active_bgm_id >= 0) {
+            activate_track_locked(g_music.active_bgm_id, true);
+        }
+    }
+}
+
+bool dos_custom_music_is_enabled() {
+    std::lock_guard<std::mutex> lock(g_music.mu);
+    return g_music.enabled;
+}
+
+bool dos_custom_music_assign_track(uint8_t track_id, const std::string& rel_filename_or_empty) {
+    std::lock_guard<std::mutex> lock(g_music.mu);
+    if (track_id >= kDosBgmTrackCount || g_music.music_dir.empty()) return false;
+
+    if (rel_filename_or_empty.empty()) {
+        g_music.manifest_tracks.erase(track_id);
+        rebuild_effective_bindings_locked();
+        save_music_manifest_locked();
+        if (!jukebox_active_locked() && g_music.active_bgm_id == static_cast<int>(track_id)) {
+            activate_track_locked(g_music.active_bgm_id, true);
+        }
+        return true;
+    }
+
+    if (!is_safe_rel_music_path(rel_filename_or_empty) ||
+        !has_supported_audio_ext(rel_filename_or_empty)) {
+        return false;
+    }
+    std::error_code ec;
+    const fs::path full = fs::path(g_music.music_dir) / rel_filename_or_empty;
+    if (!fs::is_regular_file(full, ec)) return false;
+
+    DosCustomTrackBinding b{};
+    auto existing = g_music.manifest_tracks.find(track_id);
+    if (existing != g_music.manifest_tracks.end()) {
+        b = existing->second;
+    } else {
+        b.loop = kBgmCatalog[static_cast<size_t>(track_id)].default_loop;
+        b.loop_start_ms = -1;
+        b.loop_end_ms = -1;
+        b.gain_db = 0.0f;
+        b.gain_linear = 1.0f;
+    }
+    b.track_id = track_id;
+    b.file_path = full.string();
+    b.file_label = rel_filename_or_empty;
+    g_music.manifest_tracks[track_id] = b;
+    rebuild_effective_bindings_locked();
+    save_music_manifest_locked();
+
+    if (!jukebox_active_locked() && g_music.enabled &&
+        g_music.active_bgm_id == static_cast<int>(track_id)) {
+        activate_track_locked(g_music.active_bgm_id, true);
+    }
+    return true;
+}
+
+bool dos_custom_music_set_jukebox(bool enabled, bool shuffle, const std::vector<std::string>& playlist) {
+    std::lock_guard<std::mutex> lock(g_music.mu);
+    if (g_music.music_dir.empty()) return false;
+
+    std::error_code ec;
+    std::vector<std::string> clean_list;
+    clean_list.reserve(playlist.size());
+    for (const auto& item : playlist) {
+        if (!is_safe_rel_music_path(item) || !has_supported_audio_ext(item)) continue;
+        const fs::path full = fs::path(g_music.music_dir) / item;
+        if (!fs::is_regular_file(full, ec)) continue;
+        if (std::find(clean_list.begin(), clean_list.end(), item) == clean_list.end()) {
+            clean_list.push_back(item);
+        }
+    }
+
+    g_music.jukebox_enabled = enabled;
+    g_music.jukebox_shuffle = shuffle;
+    g_music.jukebox_playlist = std::move(clean_list);
+    if (g_music.jukebox_playlist.empty()) {
+        g_music.jukebox_index = 0;
+    } else if (g_music.jukebox_index >= g_music.jukebox_playlist.size()) {
+        g_music.jukebox_index = 0;
+    }
+    save_music_manifest_locked();
+
+    if (jukebox_active_locked()) {
+        start_jukebox_index_locked(g_music.jukebox_index, true);
+    } else if (g_music.enabled && g_music.active_bgm_id >= 0) {
+        activate_track_locked(g_music.active_bgm_id, true);
+    } else {
+        g_music.active_playing = false;
+    }
+    return true;
+}
+
+bool dos_custom_music_jukebox_next() {
+    std::lock_guard<std::mutex> lock(g_music.mu);
+    if (!jukebox_active_locked()) return false;
+    const size_t n = g_music.jukebox_playlist.size();
+    size_t next_idx = (g_music.jukebox_index + 1u) % n;
+    if (g_music.jukebox_shuffle && n > 1u) {
+        std::uniform_int_distribution<size_t> dist(0, n - 2u);
+        size_t pick = dist(g_music.rng);
+        if (pick >= g_music.jukebox_index) ++pick;
+        next_idx = pick;
+    }
+    return start_jukebox_index_locked(next_idx, false);
+}
+
+bool dos_custom_music_jukebox_prev() {
+    std::lock_guard<std::mutex> lock(g_music.mu);
+    if (!jukebox_active_locked()) return false;
+    const size_t n = g_music.jukebox_playlist.size();
+    const size_t prev_idx = (g_music.jukebox_index + n - 1u) % n;
+    return start_jukebox_index_locked(prev_idx, false);
+}
+
+void dos_custom_music_tick() {
+    if (!g_music.jukebox_advance_pending.exchange(false, std::memory_order_acq_rel)) {
+        return;
+    }
+    dos_custom_music_jukebox_next();
+}
+
+void dos_custom_music_reset() {
+    std::lock_guard<std::mutex> lock(g_music.mu);
+    g_music.active_bgm_id = -1;
+    g_music.active_bgm_player_slot = -1;
+    g_music.guest_paused = false;
+    g_music.game_fade_gain = 1.0f;
+    g_music.jukebox_advance_pending.store(false, std::memory_order_relaxed);
+    if (jukebox_active_locked()) {
+        // Mantem a playlist pronta ao reiniciar / carregar savestate
+        start_jukebox_index_locked(g_music.jukebox_index, true);
+    } else {
+        g_music.active_playing = false;
+        g_music.play_frame = 0;
+        g_music.finished = false;
+    }
+}
