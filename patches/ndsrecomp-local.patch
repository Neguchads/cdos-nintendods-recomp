+
+    static constexpr std::array<NdsPipMainScreen, 2> kMains = {
+        NdsPipMainScreen::Bottom, NdsPipMainScreen::Top};
+    static constexpr std::array<DosStrId, 2> kMainNames = {
+        DosStrId::MainBottom, DosStrId::MainTop};
+    if (combo_enum(dos_tr(lang, DosStrId::LblPipMain), &opt->pip_main_screen,
+                   kMains, kMainNames, lang)) {
+        mark_dirty(ctx, true);
+    }
+    if (ImGui::Button(dos_tr(lang, DosStrId::BtnSwapScreens))) {
+        opt->pip_main_screen = (opt->pip_main_screen == NdsPipMainScreen::Bottom)
+                                   ? NdsPipMainScreen::Top
+                                   : NdsPipMainScreen::Bottom;
+        mark_dirty(ctx, true);
+    }
+
+    const bool is_pip = (opt->screen_layout == NdsScreenLayout::PictureInPicture);
+    const bool is_theatre = (opt->screen_layout == NdsScreenLayout::WidescreenTheatre);
+    if (!is_pip && !is_theatre) ImGui::BeginDisabled();
+    static constexpr std::array<NdsPipCorner, 4> kCorners = {
+        NdsPipCorner::TopLeft, NdsPipCorner::TopRight,
+        NdsPipCorner::BottomLeft, NdsPipCorner::BottomRight};
