+
+std::string dos_mod_sanitize_id(const std::string& raw, const std::string& fallback) {
+    std::string out;
+    out.reserve(raw.size());
+    for (unsigned char ch : raw) {
+        if (std::isspace(ch)) continue;
+        const char lc = static_cast<char>(std::tolower(ch));
+        if ((lc >= 'a' && lc <= 'z') || (lc >= '0' && lc <= '9') || lc == '-' || lc == '_') {
+            out.push_back(lc);
+        } else {
+            return fallback;
+        }
+    }
+    if (out.empty() || out.size() > 48 ||
+        !((out[0] >= 'a' && out[0] <= 'z') || (out[0] >= '0' && out[0] <= '9'))) {
+        return fallback;
+    }
+    return out;
+}
+
+std::string dos_mod_sanitize_seed(const std::string& raw) {
+    std::string out;
+    for (unsigned char ch : raw) {
+        if (std::isalnum(ch) || ch == '-' || ch == '_') {
+            out.push_back(static_cast<char>(ch));
+            if (out.size() >= 32) break;
+        }
+    }
+    return out;
+}
+
+std::string dos_mod_profile_namespace(const std::string& profile_id,
+                                      const std::string& version,
+                                      const std::string& modset_hash) {
+    const std::string sid = dos_mod_sanitize_id(profile_id, "profile");
+    std::string sver;
+    for (unsigned char ch : version) {
+        if (std::isalnum(ch) || ch == '.' || ch == '_' || ch == '-') {
+            sver.push_back(static_cast<char>(ch));
+            if (sver.size() >= 20) break;
+        }
+    }
+    if (sver.empty() || sver.find("..") != std::string::npos) sver = "1.0";
+    std::string h8;
+    for (unsigned char ch : modset_hash) {
+        const char lc = static_cast<char>(std::tolower(ch));
+        if ((lc >= '0' && lc <= '9') || (lc >= 'a' && lc <= 'f')) {
+            h8.push_back(lc);
+            if (h8.size() >= 8) break;
+        }
+    }
+    if (h8.empty()) h8 = "00000000";
+    return sid + "-v" + sver + "-" + h8;
+}
+
+bool dos_write_text_atomic(const std::string& path, const std::string& content) {
+    if (path.empty()) return false;
+    std::error_code ec;
+    const fs::path dst(path);
+    if (!dst.parent_path().empty()) {
+        fs::create_directories(dst.parent_path(), ec);
+        if (ec) return false;
+    }
+    const fs::path tmp = dst.parent_path() / (dst.filename().string() + ".tmp");
+    {
+        std::ofstream out(tmp, std::ios::binary | std::ios::trunc);
+        if (!out) return false;
+        out.write(content.data(), static_cast<std::streamsize>(content.size()));
+        out.flush();
+        if (!out) {
+            out.close();
+            fs::remove(tmp, ec);
+            return false;
+        }
+    }
+    fs::rename(tmp, dst, ec);
+    if (ec) {
+        // Windows: rename pode falhar se destino existir dependendo da implementacao STL.
+        std::error_code ec2;
+        fs::remove(dst, ec2);
+        ec.clear();
+        fs::rename(tmp, dst, ec);
+        if (ec) {
+            fs::remove(tmp, ec2);
+            return false;
+        }
+    }
+    return true;
+}
+
+void dos_mod_registry_rescan_installed(DosModRegistry* reg) {
+    if (!reg) return;
+    // Remove entradas dinamicas antigas de dsvrandom antes de reescanear.
+    reg->campaigns.erase(
+        std::remove_if(reg->campaigns.begin(), reg->campaigns.end(),
+                       [](const DosModEntry& e) {
+                           return e.validation_level == "external_randomizer" &&
+                                  e.id.rfind("dsvrandom-", 0) == 0;
+                       }),
+        reg->campaigns.end());
+
+    auto check_list = [&](std::vector<DosModEntry>& list) {
+        for (auto& e : list) {
+            if (e.builtin) {
+                e.installed = true;
+                e.resolved_patch_path.clear();
+                continue;
+            }
+            e.installed = false;
+            e.resolved_patch_path.clear();
+            if (reg->data_mods_dir.empty() || !is_safe_leaf_filename(e.profile_file)) continue;
+            std::error_code ec;
+            const fs::path candidate = fs::path(reg->data_mods_dir) / "profiles" / e.profile_file;
+            if (fs::is_regular_file(candidate, ec)) {
+                e.installed = true;
+                e.resolved_patch_path = candidate.string();
+            }
+        }
+    };
+    check_list(reg->baselines);
+    check_list(reg->campaigns);
+    check_list(reg->character_packs);
+
+    // Descoberta automatica de seeds externas importadas do DSVania Randomizer (dsvrandom-*.dospatch).
+    if (!reg->data_mods_dir.empty()) {
+        std::error_code ec;
+        const fs::path prof_dir = fs::path(reg->data_mods_dir) / "profiles";
+        if (fs::is_directory(prof_dir, ec)) {
+            std::vector<fs::path> found;
+            for (const auto& entry : fs::directory_iterator(prof_dir, ec)) {
+                if (ec) break;
+                if (!entry.is_regular_file(ec)) continue;
+                const std::string fname = entry.path().filename().string();
+                const std::string lc = lower_ascii(fname);
+                if (lc.rfind("dsvrandom-", 0) == 0 && lc.size() > 19 &&
+                    lc.compare(lc.size() - 9, 9, ".dospatch") == 0) {
+                    found.push_back(entry.path());
+                }
+            }
+            std::sort(found.begin(), found.end());
+            for (const auto& p : found) {
+                const std::string stem = p.stem().string();
+                const std::string safe_id = dos_mod_sanitize_id(stem);
+                if (safe_id.empty() || find_entry(reg->campaigns, safe_id) != nullptr) continue;
+                const std::string seed_label = safe_id.size() > 10 ? safe_id.substr(10) : safe_id;
+                DosModEntry e{};
+                e.id = safe_id;
+                e.name = "DSVania Randomizer (" + seed_label + ")";
+                e.version = "1.0";
+                e.kind = "campaign";
+                e.profile_file = p.filename().string();
+                e.author = "LagoLunatic (DSVania Randomizer external output)";
+                e.summary = "Externally generated DSVania Randomizer seed imported as DOSPATCH.";
+                e.source_url = "https://github.com/LagoLunatic/dsvrandom";
+                e.validation_level = "external_randomizer";
+                e.registry_state = "unverified";
+                e.allowed_character_packs = {"default"};
+                e.builtin = false;
+                e.manual_import = true;
+                e.supports_ptbr = false;
+                e.definitive_compatible = false;
+                e.installed = true;
+                e.resolved_patch_path = p.string();
+                reg->campaigns.push_back(std::move(e));
+            }
+        }
+    }
+}
+
+bool dos_mod_registry_load(const std::string& registry_json_path,
+                           const std::string& data_mods_dir,
+                           DosModRegistry* out,
+                           std::string* error_out) {
+    if (!out) return false;
+    *out = DosModRegistry{};
+    out->registry_path = registry_json_path;
+    out->data_mods_dir = data_mods_dir;
+    populate_default_builtin_registry(out);
+
+    if (registry_json_path.empty()) {
+        dos_mod_registry_rescan_installed(out);
+        out->loaded = true;
+        return true;
+    }
+
+    std::ifstream in(registry_json_path, std::ios::binary);
+    if (!in) {
+        if (error_out) *error_out = "registry.json not found; using builtin defaults";
+        dos_mod_registry_rescan_installed(out);
+        out->loaded = false;
+        return false;
+    }
+    std::ostringstream ss;
+    ss << in.rdbuf();
+    JsonVal root{};
+    MiniJsonParser parser(ss.str());
+    if (!parser.parse(&root) || root.type != JsonVal::Type::Object) {
+        if (error_out) *error_out = "invalid JSON in registry.json";
+        dos_mod_registry_rescan_installed(out);
+        out->loaded = false;
+        return false;
+    }
+    if (root.str_or("schema") != "cdos.mod-registry.v1") {
+        if (error_out) *error_out = "unexpected registry schema";
+        dos_mod_registry_rescan_installed(out);
+        out->loaded = false;
+        return false;
+    }
+
+    out->base_rom_sha1 = lower_ascii(root.str_or("base_rom_sha1", out->base_rom_sha1));
+    out->runtime_compat = root.str_or("runtime_compat", out->runtime_compat);
+    parse_entry_list(root.field("baselines"), "baseline", &out->baselines);
+    parse_entry_list(root.field("campaigns"), "campaign", &out->campaigns);
+    parse_entry_list(root.field("character_packs"), "character_pack", &out->character_packs);
+
+    out->verified_combos.clear();
+    if (const JsonVal* vc = root.field("verified_combinations"); vc && vc->type == JsonVal::Type::Array) {
+        for (const auto& item : vc->arr) {
+            if (item.type != JsonVal::Type::Object) continue;
+            DosVerifiedCombo c{};
+            c.campaign = item.str_or("campaign");
+            c.character_pack = item.str_or("character_pack");
+            c.baseline = item.str_or("baseline");
+            c.language = item.str_or("language");
+            c.validation_level = item.str_or("validation_level", "none");
+            out->verified_combos.push_back(std::move(c));
+        }
+    }
+
+    dos_mod_registry_rescan_installed(out);
+    out->loaded = true;
+    return true;
+}
+
+DosConflictDecision dos_mod_resolve_conflict(const DosModRegistry& reg,
+                                             const DosModSelection& sel,
+                                             const std::string& base_rom_sha1,
+                                             const DosRomPatchSet& builtin_patches) {
+    DosConflictDecision dec{};
+    if (!base_rom_sha1.empty() && lower_ascii(base_rom_sha1) != lower_ascii(reg.base_rom_sha1)) {
+        dec.state = DosCompatState::Incompatible;
+        dec.allowed = false;
+        dec.reason = "Base ROM SHA-1 does not match verified USA ACVE dump.";
+        return dec;
+    }
+
+    const DosModEntry* camp = find_entry(reg.campaigns, sel.campaign_id);
+    const DosModEntry* pack = find_entry(reg.character_packs, sel.character_pack_id);
+    const DosModEntry* base = find_entry(reg.baselines, sel.baseline_id);
+    if (!camp || !pack || !base) {
+        dec.state = DosCompatState::Incompatible;
+        dec.allowed = false;
+        dec.reason = "Selected campaign, character pack, or baseline is not registered.";
+        return dec;
+    }
+
+    const bool pack_compat_with_camp =
+        (pack->builtin && pack->id == "default") ||
+        contains_str(pack->compatible_campaigns, camp->id);
+    if (!contains_str(camp->allowed_character_packs, pack->id) || !pack_compat_with_camp) {
+        dec.state = DosCompatState::Incompatible;
+        dec.allowed = false;
+        dec.reason = "Character pack '" + pack->name + "' is incompatible with campaign '" + camp->name + "'.";
+        return dec;
+    }
+
+    if (!camp->definitive_compatible && base->id != "original") {
+        dec.state = DosCompatState::Incompatible;
+        dec.allowed = false;
+        dec.reason = "Independent campaign '" + camp->name +
+                     "' modifies its own overlays and cannot be stacked on Definitive Edition.";
+        return dec;
+    }
+
+    if (!pack->builtin && base->id != "original") {
+        dec.state = DosCompatState::Incompatible;
+        dec.allowed = false;
+        dec.reason = "Character pack '" + pack->name +
+                     "' targets clean USA ROM; switch baseline to Original USA.";
+        return dec;
+    }
+
+    if (sel.language == DosLanguage::PtBr) {
+        if (!camp->supports_ptbr || !pack->supports_ptbr || !base->supports_ptbr) {
+            dec.state = DosCompatState::Incompatible;
+            dec.allowed = false;
+            dec.reason = "PT-BR translation is not validated for this campaign/pack; switch Game Language to English.";
+            return dec;
+        }
+    }
+
+    const DosModEntry* active = base;
+    if (!camp->builtin) active = camp;
+    else if (!pack->builtin) active = pack;
+
+    dec.active_profile_id = active->id;
+    dec.active_profile_name = active->name;
+    dec.active_version = active->version;
+    dec.validation_level = active->validation_level;
+    dec.uses_builtin_rom = active->builtin;
+
+    if (active->builtin) {
+        if (active->id == "definitive" && !builtin_patches.has_definitive()) {
+            dec.state = DosCompatState::Incompatible;
+            dec.allowed = false;
+            dec.reason = "Definitive Edition delta patch is not loaded.";
+            return dec;
+        }
+    } else {
+        if (!active->installed || active->resolved_patch_path.empty()) {
+            dec.state = DosCompatState::Incompatible;
+            dec.allowed = false;
+            dec.reason = "Mod '" + active->name + "' is not installed in {data}/mods/profiles/.";
+            return dec;
+        }
+        dec.patch_path = active->resolved_patch_path;
+    }
+
+    const std::string sanitized_seed = dos_mod_sanitize_seed(sel.randomizer_seed);
+    if (!sanitized_seed.empty()) {
+        if (!camp->builtin || !pack->builtin || !base->builtin) {
+            dec.state = DosCompatState::Incompatible;
+            dec.allowed = false;
+            dec.reason =
+                "Native Seed Mutator only supports verified Dawn of Sorrow Original/Definitive baselines; clear Seed for overhaul campaigns or character packs.";
+            return dec;
+        }
+        const DosSeedPreset preset = dos_seed_parse_preset(sel.randomizer_preset);
+        dec.active_profile_id = "seed-" + lower_ascii(sanitized_seed);
+        dec.active_profile_name =
+            base->name + " [Seed " + sanitized_seed + "/" + dos_seed_preset_name(preset) + "]";
+        dec.active_version = dos_seed_preset_name(preset);
+        dec.validation_level = "seed_mutator_non_progression";
+        dec.uses_builtin_rom = true;
+        dec.state = DosCompatState::Unverified;
+        dec.allowed = sel.allow_unverified;
+        dec.reason =
+            "Native C++ Seed Mutator (non-progression enemy/drop tables only). Enable Dev/Audit opt-in to launch.";
+        return dec;
+    }
+
+    const char* lang_str = (sel.language == DosLanguage::PtBr) ? "ptbr" : "en";
+    bool allowlisted_full = false;
+    for (const auto& vc : reg.verified_combos) {
+        if (vc.campaign == camp->id && vc.character_pack == pack->id &&
+            vc.baseline == base->id && vc.language == lang_str &&
+            vc.validation_level == "full") {
+            allowlisted_full = true;
+            break;
+        }
+    }
+
+    if (allowlisted_full && active->registry_state == "verified") {
+        dec.state = DosCompatState::Verified;
+        dec.allowed = true;
+        dec.reason = "Verified combination (full validation).";
+        return dec;
+    }
+
+    dec.state = DosCompatState::Unverified;
+    dec.allowed = sel.allow_unverified;
+    dec.reason = "Unverified profile (validation='" + active->validation_level +
+                 "'). Enable Dev/Audit opt-in to test.";
+    return dec;
+}
+
+bool dos_mod_build_rom_from_registry(const DosRomPatchSet& builtin_patches,
+                                     const DosModRegistry& reg,
+                                     const DosModSelection& sel,
+                                     const std::string& base_rom_sha1,
+                                     std::vector<uint8_t>* out_rom,
+                                     DosActiveRomSelection* active_out,
+                                     DosConflictDecision* decision_out,
+                                     std::string* error_out) {
+    if (!out_rom || builtin_patches.rom_base.empty()) {
+        if (error_out) *error_out = "Base ROM is empty.";
+        return false;
+    }
+
+    DosConflictDecision dec =
+        dos_mod_resolve_conflict(reg, sel, base_rom_sha1, builtin_patches);
+    if (decision_out) *decision_out = dec;
+    if (!dec.allowed) {
+        if (error_out) *error_out = dec.reason;
+        return false;
+    }
+
+    if (dec.uses_builtin_rom) {
+        const DosContentProfile prof =
+            (sel.baseline_id == "definitive") ? DosContentProfile::Definitive
+                                              : DosContentProfile::Original;
+        if (!dos_build_active_rom(builtin_patches, prof, sel.language, out_rom, active_out)) {
+            if (error_out) *error_out = "Failed to build built-in baseline ROM.";
+            return false;
+        }
+        const std::string sanitized_seed = dos_mod_sanitize_seed(sel.randomizer_seed);
+        if (!sanitized_seed.empty()) {
+            DosSeedMutatorResult mut_res{};
+            std::string mut_err;
+            if (!dos_seed_mutator_apply(out_rom, sanitized_seed, sel.randomizer_preset,
+                                        sel.baseline_id, reg.data_mods_dir, &mut_res, &mut_err)) {
+                if (error_out) *error_out = "Seed Mutator rejected ROM: " + mut_err;
+                return false;
+            }
+            if (active_out) {
+                active_out->label = active_out->label + " [Seed " + mut_res.sanitized_seed + "/" +
+                                    mut_res.preset_name + "] [Unverified]";
+                active_out->modset_hash = short_sha1_vec(*out_rom);
+            }
+            std::fprintf(stderr,
+                         "[seed-mutator] applied seed=%s preset=%s enemies=%zu item1_swaps=%zu item2_swaps=%zu spoiler=%s\n",
+                         mut_res.sanitized_seed.c_str(),
+                         mut_res.preset_name.c_str(),
+                         mut_res.enemies_mutated,
+                         mut_res.item1_swaps,
+                         mut_res.item2_swaps,
+                         mut_res.spoiler_path.empty() ? "(memory-only)" : mut_res.spoiler_path.c_str());
+        }
+        return true;
+    }
+
+    std::vector<uint8_t> patched;
+    std::string patch_err;
+    if (!dos_rom_patch_apply_file(builtin_patches.rom_base, dec.patch_path, &patched, &patch_err)) {
+        if (error_out) *error_out = "Failed to apply profile patch: " + patch_err;
+        return false;
+    }
+    *out_rom = std::move(patched);
+    if (active_out) {
+        active_out->actual_profile = DosContentProfile::Original;
+        active_out->actual_language = sel.language;
+        active_out->label = dec.active_profile_name +
+                            (dec.state == DosCompatState::Unverified ? " [Unverified]" : "");
+        active_out->modset_hash = short_sha1_vec(*out_rom);
+    }
+    return true;
+}
+
+std::string dos_mod_isolated_save_path(const std::string& base_save_path,
+                                       const std::string& profile_id,
+                                       const std::string& version,
+                                       const std::string& modset_hash) {
+    if (base_save_path.empty()) return {};
+    if (profile_id == "original" || profile_id.empty()) {
+        return dos_profile_save_path(base_save_path, DosContentProfile::Original);
+    }
+    if (profile_id == "definitive") {
+        return dos_profile_save_path(base_save_path, DosContentProfile::Definitive);
+    }
+    const fs::path p(base_save_path);
+    const std::string ns = dos_mod_profile_namespace(profile_id, version, modset_hash);
+    return (p.parent_path() / "profiles" / ns / p.filename()).string();
+}
+
+std::string dos_mod_isolated_savestate_dir(const std::string& base_savestate_dir,
+                                           const std::string& profile_id,
+                                           const std::string& version,
+                                           const std::string& modset_hash) {
+    if (base_savestate_dir.empty()) return {};
+    if (profile_id == "original" || profile_id.empty()) {
+        return dos_profile_savestate_dir(base_savestate_dir, DosContentProfile::Original);
+    }
+    if (profile_id == "definitive") {
+        return dos_profile_savestate_dir(base_savestate_dir, DosContentProfile::Definitive);
+    }
+    const std::string ns = dos_mod_profile_namespace(profile_id, version, modset_hash);
+    return (fs::path(base_savestate_dir) / "profiles" / ns).string();
+}
diff --git a/runner/src/dos_mod_registry.h b/runner/src/dos_mod_registry.h
