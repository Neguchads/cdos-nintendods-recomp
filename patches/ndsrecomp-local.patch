+            static int range_list[4] = { 256, 128, 86, 64 };
+            int range = range_list[g->floor1_multiplier-1];
+            int offset = 2;
+            finalY = f->finalY[i];
+            finalY[0] = (short) get_bits(f, ilog(range)-1);
+            finalY[1] = (short) get_bits(f, ilog(range)-1);
