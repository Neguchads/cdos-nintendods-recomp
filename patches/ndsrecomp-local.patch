+std::string lower_trim_token(const std::string& input) {
+    std::string out;
+    out.reserve(input.size());
+    for (unsigned char ch : input) {
+        if (std::isspace(ch)) continue;
+        out.push_back(ch == '_' ? '-' : static_cast<char>(std::tolower(ch)));
+    }
+    return out;
+}
+
+template <typename Enum, size_t N>
+struct EnumMapping {
+    Enum value;
+    const char* name;
+    const char* const* aliases;
+    size_t alias_count;
+};
+
+template <typename Enum, size_t N>
+bool parse_enum_table(const std::string& value,
+                      const std::array<EnumMapping<Enum, N>, N>& table,
+                      Enum* out) {
+    if (!out) return false;
+    const std::string norm = lower_trim_token(value);
+    for (const auto& entry : table) {
+        if (norm == entry.name) {
+            *out = entry.value;
+            return true;
+        }
+        for (size_t i = 0; i < entry.alias_count; ++i) {
+            if (norm == entry.aliases[i]) {
+                *out = entry.value;
+                return true;
+            }
+        }
+    }
+    return false;
+}
+
+template <typename Enum, size_t N>
+const char* enum_name_table(Enum value,
+                            const std::array<EnumMapping<Enum, N>, N>& table) {
+    for (const auto& entry : table) {
+        if (entry.value == value) return entry.name;
+    }
+    return table[0].name;
+}
