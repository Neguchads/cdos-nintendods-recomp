+void test_content_profiles_and_intro_validation() {
+    DosContentProfile prof{};
+    assert(dos_parse_content_profile("definitive", &prof) && prof == DosContentProfile::Definitive);
+    assert(dos_parse_content_profile("vanilla", &prof) && prof == DosContentProfile::Original);
+    assert(!dos_parse_content_profile("unknown", &prof));
+    assert(std::strcmp(dos_content_profile_name(DosContentProfile::Definitive), "definitive") == 0);
+    assert(std::strcmp(dos_content_profile_name(DosContentProfile::Original), "original") == 0);
+
+    // 4-way selection + fallback matrix
+    DosRomPatchSet set{};
+    set.rom_base = {1, 2, 3, 4};
+    set.rom_original_ptbr = {1, 2, 3, 5};
+    set.rom_definitive_en = {9, 9, 9, 1};
+    set.rom_definitive_ptbr = {9, 9, 9, 2};
+
+    std::vector<uint8_t> out;
+    DosActiveRomSelection sel{};
+    assert(dos_build_active_rom(set, DosContentProfile::Definitive, DosLanguage::English, &out, &sel));
+    assert(out == set.rom_definitive_en && sel.actual_profile == DosContentProfile::Definitive &&
+           sel.actual_language == DosLanguage::English && !sel.modset_hash.empty());
+
+    assert(dos_build_active_rom(set, DosContentProfile::Definitive, DosLanguage::PtBr, &out, &sel));
+    assert(out == set.rom_definitive_ptbr && sel.actual_profile == DosContentProfile::Definitive &&
+           sel.actual_language == DosLanguage::PtBr);
+
+    assert(dos_build_active_rom(set, DosContentProfile::Original, DosLanguage::PtBr, &out, &sel));
+    assert(out == set.rom_original_ptbr && sel.actual_profile == DosContentProfile::Original &&
+           sel.actual_language == DosLanguage::PtBr);
+
+    assert(dos_build_active_rom(set, DosContentProfile::Original, DosLanguage::English, &out, &sel));
+    assert(out == set.rom_base && sel.actual_profile == DosContentProfile::Original &&
+           sel.actual_language == DosLanguage::English);
+
+    // Missing Definitive falls back safely to Original without crashing.
+    DosRomPatchSet no_def{};
+    no_def.rom_base = {1, 2, 3, 4};
+    no_def.rom_original_ptbr = {1, 2, 3, 5};
+    assert(dos_build_active_rom(no_def, DosContentProfile::Definitive, DosLanguage::PtBr, &out, &sel));
+    assert(out == no_def.rom_original_ptbr && sel.actual_profile == DosContentProfile::Original);
+
+    // Profile save and savestate isolation
+    assert(dos_profile_savestate_dir("saves/states", DosContentProfile::Original) == "saves/states");
+    assert(dos_profile_savestate_dir("saves/states", DosContentProfile::Definitive).find("definitive") != std::string::npos);
+    assert(dos_profile_save_path("saves/dos.sav", DosContentProfile::Original) == "saves/dos.sav");
+    assert(dos_profile_save_path("saves/dos.sav", DosContentProfile::Definitive).find("definitive") != std::string::npos);
+
+    // INI persistence for dos_content_profile and dos_enhanced_intro
+    const auto tmp_dir = std::filesystem::temp_directory_path() / "dos_profile_ini_test";
+    std::error_code ec;
+    std::filesystem::create_directories(tmp_dir, ec);
+    const std::string ini_path = (tmp_dir / "settings.ini").string();
+    DosEnhancementSettings s_in{};
+    s_in.content_profile = DosContentProfile::Original;
+    s_in.enhanced_intro = false;
+    assert(dos_save_settings_ini(ini_path, NdsScreenLayout::PictureInPicture,
+                                 NdsPipCorner::TopRight, NdsPipMainScreen::Bottom,
+                                 0, kNdsDefaultKeys, kNdsDefaultPad, false, 1, 1, s_in));
+    DosEnhancementSettings s_out{};
+    assert(dos_load_settings_ini(ini_path, nullptr, nullptr, nullptr, nullptr,
+                                 nullptr, nullptr, nullptr, nullptr, nullptr, &s_out));
+    assert(s_out.content_profile == DosContentProfile::Original);
+    assert(s_out.enhanced_intro == false);
+
+    // MP4 box 'ftyp' validation
+    std::string mp4_err;
+    assert(!dos_intro_validate_mp4_file((tmp_dir / "missing.mp4").string(), &mp4_err));
+    const std::string bad_mp4 = (tmp_dir / "bad.mp4").string();
+    {
+        std::ofstream f(bad_mp4, std::ios::binary);
+        f.write("NOT_AN_MP4_FILE!", 16);
+    }
+    assert(!dos_intro_validate_mp4_file(bad_mp4, &mp4_err));
+
+    const std::string good_mp4 = (tmp_dir / "good.mp4").string();
+    {
+        std::ofstream f(good_mp4, std::ios::binary);
+        const uint8_t hdr[16] = {0, 0, 0, 24, 'f', 't', 'y', 'p', 'i', 's', 'o', 'm', 0, 0, 0, 0};
+        f.write(reinterpret_cast<const char*>(hdr), sizeof(hdr));
+    }
+    assert(dos_intro_validate_mp4_file(good_mp4, &mp4_err));
+    std::filesystem::remove_all(tmp_dir, ec);
+}
