diff --git a/runner/src/dos_gpu_shader.cpp b/runner/src/dos_gpu_shader.cpp
new file mode 100644
index 0000000..e3a0553
--- /dev/null
+++ b/runner/src/dos_gpu_shader.cpp
@@ -0,0 +1,218 @@
+#include "dos_gpu_shader.h"
+#include "dos_gpu_shader_dxil.h"
+#include "dos_gpu_shader_spirv.h"
+
+#include <algorithm>
+
+#if defined(NDS_HAVE_SDL3)
+#include <SDL3/SDL.h>
+#endif
+
+namespace {
+
+struct alignas(16) DosShaderParams {
+    float tex_size[2];
+    float inv_tex_size[2];
+    uint32_t filter_mode;
+    uint32_t color_mode;
+    uint32_t sharpen_mode;
+    uint32_t post_fx;
+    float brightness;
+    float contrast;
+    float saturation;
+    float vignette;
+};
+static_assert(sizeof(DosShaderParams) == 48, "DosShaderParams must be 48 bytes");
+
+}  // namespace
+
+bool dos_gpu_postprocess_dxil_bytecode(const uint8_t** data_out,
+                                       size_t* size_out) {
+    if (!data_out || !size_out) return false;
+    *data_out = kDosPostProcessDxil;
+    *size_out = kDosPostProcessDxilSize;
+    return kDosPostProcessDxilSize > 0u;
+}
+
+bool dos_gpu_postprocess_spirv_bytecode(const uint8_t** data_out,
+                                        size_t* size_out) {
+    if (!data_out || !size_out) return false;
+    *data_out = kDosPostProcessSpirv;
+    *size_out = kDosPostProcessSpirvSize;
+    return kDosPostProcessSpirvSize > 0u;
+}
+
+bool DosGpuShaderState::init(SDL_Renderer* renderer, std::string* error_out) {
+    shutdown();
+#if defined(NDS_HAVE_SDL3)
+    if (!renderer) {
+        if (error_out) *error_out = "null renderer";
+        return false;
+    }
+    SDL_GPUDevice* dev = SDL_GetGPURendererDevice(renderer);
+    if (!dev) {
+        if (error_out) *error_out = "renderer is not an SDL_GPURenderer";
+        return false;
+    }
+
+    const SDL_GPUShaderFormat formats = SDL_GetGPUShaderFormats(dev);
+    const uint8_t* code_data = nullptr;
+    size_t code_size = 0;
+    SDL_GPUShaderFormat chosen_format = SDL_GPU_SHADERFORMAT_INVALID;
+    const char* format_label = "";
+
+    if ((formats & SDL_GPU_SHADERFORMAT_DXIL) != 0u &&
+        dos_gpu_postprocess_dxil_bytecode(&code_data, &code_size)) {
+        chosen_format = SDL_GPU_SHADERFORMAT_DXIL;
+        format_label = "DXIL ps_6_0";
+    } else if ((formats & SDL_GPU_SHADERFORMAT_SPIRV) != 0u &&
+               dos_gpu_postprocess_spirv_bytecode(&code_data, &code_size)) {
+        chosen_format = SDL_GPU_SHADERFORMAT_SPIRV;
+        format_label = "SPIR-V Vulkan";
+    } else {
+        if (error_out) *error_out = "GPU device does not support DXIL or SPIR-V";
+        return false;
+    }
+
+    SDL_GPUShaderCreateInfo shader_info{};
+    shader_info.code_size = code_size;
+    shader_info.code = code_data;
+    shader_info.entrypoint = "main";
+    shader_info.format = chosen_format;
+    shader_info.stage = SDL_GPU_SHADERSTAGE_FRAGMENT;
+    shader_info.num_samplers = 1;
+    shader_info.num_storage_textures = 0;
+    shader_info.num_storage_buffers = 0;
+    shader_info.num_uniform_buffers = 1;
+
+    SDL_GPUShader* shader = SDL_CreateGPUShader(dev, &shader_info);
+    if (!shader) {
+        if (error_out) *error_out = SDL_GetError();
+        return false;
+    }
+
+    SDL_GPURenderStateCreateInfo state_info{};
+    state_info.fragment_shader = shader;
+    SDL_GPURenderState* state0 = SDL_CreateGPURenderState(renderer, &state_info);
+    if (!state0) {
+        if (error_out) *error_out = SDL_GetError();
+        SDL_ReleaseGPUShader(dev, shader);
+        return false;
+    }
+    SDL_GPURenderState* state1 = SDL_CreateGPURenderState(renderer, &state_info);
+    if (!state1) {
+        if (error_out) *error_out = SDL_GetError();
+        SDL_DestroyGPURenderState(state0);
+        SDL_ReleaseGPUShader(dev, shader);
+        return false;
+    }
+
+    device = dev;
+    fragment_shader = shader;
+    render_states[0] = state0;
+    render_states[1] = state1;
+    active_format_name = format_label;
+    return true;
+#else
+    (void)renderer;
+    if (error_out) *error_out = "SDL3 GPU shader state unavailable";
+    return false;
+#endif
+}
+
+void DosGpuShaderState::bind(SDL_Renderer* renderer, int slot, int src_w, int src_h,
+                             DosHdFilter filter, DosColorMode color,
+                             DosSharpenMode sharpen, DosPostFx post_fx,
+                             uint8_t brightness_pct, uint8_t contrast_pct,
+                             uint8_t saturation_pct, uint8_t vignette_pct) {
+#if defined(NDS_HAVE_SDL3)
+    const int idx = slot & 1;
+    SDL_GPURenderState* state = render_states[idx];
+    if (!renderer || !state || src_w <= 0 || src_h <= 0) return;
+
+    DosShaderParams params{};
+    params.tex_size[0] = static_cast<float>(src_w);
+    params.tex_size[1] = static_cast<float>(src_h);
+    params.inv_tex_size[0] = 1.0f / params.tex_size[0];
+    params.inv_tex_size[1] = 1.0f / params.tex_size[1];
+
+    switch (filter) {
+        case DosHdFilter::Bilinear:      params.filter_mode = 1u; break;
+        case DosHdFilter::SharpBilinear: params.filter_mode = 2u; break;
+        case DosHdFilter::Scale2x:       params.filter_mode = 3u; break;
+        case DosHdFilter::Xbr2x:         params.filter_mode = 4u; break;
+        case DosHdFilter::Nearest:
+        default:                         params.filter_mode = 0u; break;
+    }
+    switch (color) {
+        case DosColorMode::VividHd:     params.color_mode = 1u; break;
+        case DosColorMode::DsAuthentic: params.color_mode = 2u; break;
+        case DosColorMode::Native:
+        default:                        params.color_mode = 0u; break;
+    }
+    switch (sharpen) {
+        case DosSharpenMode::Subtle: params.sharpen_mode = 1u; break;
+        case DosSharpenMode::Strong: params.sharpen_mode = 2u; break;
+        case DosSharpenMode::Off:
+        default:                     params.sharpen_mode = 0u; break;
+    }
+    switch (post_fx) {
+        case DosPostFx::ScanlinesLight: params.post_fx = 1u; break;
+        case DosPostFx::Crt:            params.post_fx = 2u; break;
+        case DosPostFx::LcdGrid:        params.post_fx = 3u; break;
+        case DosPostFx::Off:
+        default:                        params.post_fx = 0u; break;
+    }
+    params.brightness = static_cast<float>(std::clamp<int>(brightness_pct, 80, 130)) / 100.0f;
+    params.contrast = static_cast<float>(std::clamp<int>(contrast_pct, 80, 130)) / 100.0f;
+    params.saturation = static_cast<float>(std::clamp<int>(saturation_pct, 70, 140)) / 100.0f;
+    params.vignette = static_cast<float>(std::clamp<int>(vignette_pct, 0, 50)) / 100.0f;
+
+    tex_w = src_w;
+    tex_h = src_h;
+    SDL_SetGPURenderStateFragmentUniforms(state, 0, &params, sizeof(params));
+    SDL_SetGPURenderState(renderer, state);
+#else
+    (void)renderer;
+    (void)slot;
+    (void)src_w;
+    (void)src_h;
+    (void)filter;
+    (void)color;
+    (void)sharpen;
+    (void)post_fx;
+    (void)brightness_pct;
+    (void)contrast_pct;
+    (void)saturation_pct;
+    (void)vignette_pct;
+#endif
+}
+
+void DosGpuShaderState::unbind(SDL_Renderer* renderer) {
+#if defined(NDS_HAVE_SDL3)
+    if (renderer && (render_states[0] || render_states[1])) {
+        SDL_SetGPURenderState(renderer, nullptr);
+    }
+#else
+    (void)renderer;
+#endif
+}
+
+void DosGpuShaderState::shutdown() {
+#if defined(NDS_HAVE_SDL3)
+    for (SDL_GPURenderState*& state : render_states) {
+        if (state) {
+            SDL_DestroyGPURenderState(state);
+            state = nullptr;
+        }
+    }
+    if (device && fragment_shader) {
+        SDL_ReleaseGPUShader(device, fragment_shader);
+    }
+    fragment_shader = nullptr;
+    device = nullptr;
+#endif
+    tex_w = 0;
+    tex_h = 0;
+    active_format_name.clear();
+}
