+void draw_tab_home(DosImGuiMenuContext& ctx, DosLanguage lang, ImFont* heading_font,
+                   bool& open_flag) {
+    NdsFrontendOptions* opt = ctx.options;
+    begin_section(dos_tr(lang, DosStrId::SecWelcome), heading_font);
+    ImGui::TextWrapped("%s", dos_tr(lang, DosStrId::WelcomeBody));
+    ImGui::Spacing();
+
+    const char* title = (opt && !opt->game_title.empty())
+                            ? opt->game_title.c_str()
+                            : "Castlevania: Dawn of Sorrow";
+    ImGui::TextDisabled("%s: %s  |  %s / %s",
+                        dos_tr(lang, DosStrId::LblBootModeInfo), title,
+                        ctx.active_driver ? ctx.active_driver : "auto",
+                        ctx.active_shader_format ? ctx.active_shader_format : "none");
+    ImGui::Spacing();
+
+    static constexpr std::array<DosLanguage, 2> kLangs = {
+        DosLanguage::English, DosLanguage::PtBr};
+    static constexpr std::array<DosStrId, 2> kLangNames = {
+        DosStrId::LangEnglish, DosStrId::LangPtBr};
+    if (opt && combo_enum(dos_tr(lang, DosStrId::LblUiLanguage),
+                          &opt->dos.ui_language, kLangs, kLangNames, lang)) {
+        mark_dirty(ctx, false);
+    }
+
+    if (opt) {
+        const DosLanguage prev_game = opt->dos.game_language;
+        if (!ctx.ptbr_patch_available) ImGui::BeginDisabled();
+        if (combo_enum(dos_tr(lang, DosStrId::LblGameLanguage),
+                       &opt->dos.game_language, kLangs, kLangNames, lang)) {
+            if (opt->dos.game_language != prev_game) {
+                mark_dirty(ctx, false);
+                if (ctx.language_swap_requested) *ctx.language_swap_requested = true;
+            }
+        }
+        if (!ctx.ptbr_patch_available) ImGui::EndDisabled();
+        ImGui::TextWrapped("%s", dos_tr(lang, ctx.ptbr_patch_available
+                                                  ? DosStrId::GameLangActiveNote
+                                                  : DosStrId::GameLangMissingNote));
+        ImGui::Spacing();
+        if (ImGui::Checkbox(dos_tr(lang, DosStrId::LblSkipLauncher),
+                            &opt->dos.skip_launcher)) {
+            mark_dirty(ctx, false);
+        }
+    }
+
+    begin_section(dos_tr(lang, DosStrId::SecSaveStates), heading_font);
+    for (int slot = 1; slot <= 5; ++slot) {
+        const NdsSavestateSlotMetadata meta =
+            (!ctx.savestate_dir.empty())
+                ? nds_savestate_slot_metadata(ctx.savestate_dir, static_cast<unsigned>(slot))
+                : NdsSavestateSlotMetadata{};
+        ImGui::PushID(slot);
+        char info[96]{};
+        if (meta.exists) {
+            std::snprintf(info, sizeof(info), "%s %d  (%llu KB)",
+                          dos_tr(lang, DosStrId::LblSlot), slot,
+                          static_cast<unsigned long long>((meta.size_bytes + 1023ull) / 1024ull));
+        } else {
+            std::snprintf(info, sizeof(info), "%s %d  [%s]",
+                          dos_tr(lang, DosStrId::LblSlot), slot,
+                          dos_tr(lang, DosStrId::SlotEmpty));
+        }
+        ImGui::AlignTextToFramePadding();
+        ImGui::Text("%-26s", info);
+        ImGui::SameLine();
+        if (ImGui::Button(dos_tr(lang, DosStrId::BtnSave), ImVec2(95.0f, 0.0f))) {
+            if (ctx.save_slot_requested) *ctx.save_slot_requested = slot;
+        }
+        ImGui::SameLine();
+        if (!meta.exists) ImGui::BeginDisabled();
+        if (ImGui::Button(dos_tr(lang, DosStrId::BtnLoad), ImVec2(95.0f, 0.0f))) {
+            if (ctx.load_slot_requested) *ctx.load_slot_requested = slot;
+        }
+        if (!meta.exists) ImGui::EndDisabled();
+        ImGui::PopID();
+    }
+
+    begin_section(dos_tr(lang, DosStrId::SecUtilities), heading_font);
+    if (ImGui::Button(dos_tr(lang, DosStrId::BtnBackupEeprom), ImVec2(210.0f, 0.0f))) {
+        if (ctx.backup_save_requested) *ctx.backup_save_requested = true;
+    }
+    ImGui::SameLine();
+    if (ImGui::Button(dos_tr(lang, DosStrId::BtnScreenshot), ImVec2(210.0f, 0.0f))) {
+        if (ctx.screenshot_requested) *ctx.screenshot_requested = true;
+    }
+
+    ImGui::Spacing();
+    ImGui::Separator();
+    ImGui::Spacing();
+
+    if (ImGui::Button(dos_tr(lang, DosStrId::BtnResume), ImVec2(175.0f, 34.0f))) {
+        open_flag = false;
+    }
+    ImGui::SameLine();
+    if (ImGui::Button(dos_tr(lang, DosStrId::BtnResetDefaults), ImVec2(175.0f, 34.0f))) {
+        if (ctx.defaults_reset_requested) *ctx.defaults_reset_requested = true;
+    }
+    ImGui::SameLine();
+    ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.55f, 0.13f, 0.18f, 0.95f));
+    if (ImGui::Button(dos_tr(lang, DosStrId::BtnQuit), ImVec2(150.0f, 34.0f))) {
+        if (ctx.running) *ctx.running = false;
+        open_flag = false;
+    }
+    ImGui::PopStyleColor();
+}
