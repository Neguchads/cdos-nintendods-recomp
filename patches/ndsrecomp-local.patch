+void draw_tab_mods(DosImGuiMenuContext& ctx, DosLanguage lang, ImFont* heading_font) {
+    NdsFrontendOptions* opt = ctx.options;
+    if (!opt) return;
+
+    if (ctx.active_profile_label && ctx.active_profile_label[0] != '\0') {
+        ImGui::TextColored(ImVec4(0.85f, 0.92f, 1.0f, 1.0f), "Active: %s  [%s]",
+                           ctx.active_profile_label,
+                           (ctx.active_modset_hash && ctx.active_modset_hash[0])
+                               ? ctx.active_modset_hash : "-");
+        if (ctx.active_save_path && ctx.active_save_path[0] != '\0') {
+            ImGui::TextDisabled("Save: %s", ctx.active_save_path);
+        }
+    }
+    if (ctx.definitive_patch_available) {
+        ImGui::TextDisabled("%s", dos_tr(lang, DosStrId::ContentDefinitiveFeatures));
+    }
+
+    const DosModRegistry* reg = ctx.mod_registry;
+    if (reg) {
+        begin_section(dos_tr(lang, DosStrId::SecCampaignSelect), heading_font);
+        for (const auto& c : reg->campaigns) {
+            const bool selected = (opt->dos.active_campaign == c.id);
+            const char* badge = c.installed ? dos_tr(lang, DosStrId::BadgeInstalled)
+                                            : dos_tr(lang, DosStrId::BadgeNotInstalled);
+            char label[192]{};
+            std::snprintf(label, sizeof(label), "%s  v%s  [%s]##camp_%s",
+                          c.name.c_str(), c.version.c_str(), badge, c.id.c_str());
+            if (!c.installed) ImGui::BeginDisabled();
+            if (ImGui::RadioButton(label, selected)) {
+                opt->dos.active_campaign = c.id;
+                if (!c.definitive_compatible) {
+                    opt->dos.content_profile = DosContentProfile::Original;
+                    opt->dos.active_character_pack = "default";
+                }
+                mark_dirty(ctx, false);
+            }
+            if (!c.installed) ImGui::EndDisabled();
+            if (!c.author.empty()) {
+                ImGui::SameLine();
+                ImGui::TextDisabled("by %s", c.author.c_str());
+            }
+        }
+
+        begin_section(dos_tr(lang, DosStrId::SecCharacterPacks), heading_font);
+        for (const auto& p : reg->character_packs) {
+            const bool selected = (opt->dos.active_character_pack == p.id);
+            const char* badge = p.installed ? dos_tr(lang, DosStrId::BadgeInstalled)
+                                            : dos_tr(lang, DosStrId::BadgeNotInstalled);
+            char label[192]{};
+            std::snprintf(label, sizeof(label), "%s  [%s]##pack_%s",
+                          p.name.c_str(), badge, p.id.c_str());
+            if (!p.installed) ImGui::BeginDisabled();
+            if (ImGui::RadioButton(label, selected)) {
+                opt->dos.active_character_pack = p.id;
+                if (!p.builtin) {
+                    opt->dos.content_profile = DosContentProfile::Original;
+                }
+                mark_dirty(ctx, false);
+            }
+            if (!p.installed) ImGui::EndDisabled();
+            if (!p.author.empty()) {
+                ImGui::SameLine();
+                ImGui::TextDisabled("by %s", p.author.c_str());
+            }
+        }
+
+        begin_section(dos_tr(lang, DosStrId::SecBaselineAdvanced), heading_font);
+        static constexpr std::array<DosContentProfile, 2> kProfiles = {
+            DosContentProfile::Definitive, DosContentProfile::Original};
+        static constexpr std::array<DosStrId, 2> kProfileNames = {
+            DosStrId::ProfileDefinitive, DosStrId::ProfileOriginal};
+        if (!ctx.definitive_patch_available) ImGui::BeginDisabled();
+        if (combo_enum(dos_tr(lang, DosStrId::LblContentProfile),
+                       &opt->dos.content_profile, kProfiles, kProfileNames, lang)) {
+            mark_dirty(ctx, false);
+        }
+        if (!ctx.definitive_patch_available) ImGui::EndDisabled();
+
+        begin_section(dos_tr(lang, DosStrId::SecConflictStatus), heading_font);
+        if (ImGui::Checkbox(dos_tr(lang, DosStrId::LblAllowUnverified),
+                            &opt->dos.allow_unverified_mods)) {
+            mark_dirty(ctx, false);
+        }
+        if (ctx.builtin_patches) {
+            DosModSelection sel{};
+            sel.campaign_id = opt->dos.active_campaign;
+            sel.character_pack_id = opt->dos.active_character_pack;
+            sel.baseline_id = (opt->dos.content_profile == DosContentProfile::Definitive)
+                                  ? "definitive"
+                                  : "original";
+            sel.language = opt->dos.game_language;
+            sel.allow_unverified = opt->dos.allow_unverified_mods;
+            sel.randomizer_seed = opt->dos.randomizer_seed;
+            sel.randomizer_preset = opt->dos.randomizer_preset;
+            const DosConflictDecision dec = dos_mod_resolve_conflict(
+                *reg, sel, ctx.base_rom_sha1 ? ctx.base_rom_sha1 : "", *ctx.builtin_patches);
+            ImVec4 col(0.95f, 0.35f, 0.35f, 1.0f);
+            const char* st_txt = dos_tr(lang, DosStrId::BadgeIncompatible);
+            if (dec.state == DosCompatState::Verified) {
+                col = ImVec4(0.32f, 0.90f, 0.48f, 1.0f);
+                st_txt = dos_tr(lang, DosStrId::BadgeVerified);
+            } else if (dec.state == DosCompatState::Unverified) {
+                col = ImVec4(0.98f, 0.78f, 0.28f, 1.0f);
+                st_txt = dos_tr(lang, DosStrId::BadgeUnverified);
+            }
+            ImGui::TextColored(col, "[%s] %s", st_txt, dec.reason.c_str());
+            if (!dec.allowed) ImGui::BeginDisabled();
+            if (ImGui::Button(dos_tr(lang, DosStrId::BtnApplyProfileRestart), ImVec2(210.0f, 0.0f))) {
+                if (ctx.content_swap_requested) *ctx.content_swap_requested = true;
+            }
+            if (!dec.allowed) ImGui::EndDisabled();
+            ImGui::SameLine();
+            if (ImGui::Button(dos_tr(lang, DosStrId::BtnRescanMods), ImVec2(200.0f, 0.0f))) {
+                if (ctx.rescan_mods_requested) *ctx.rescan_mods_requested = true;
+            }
+        }
+    }
+
+    begin_section(dos_tr(lang, DosStrId::SecRandomizer), heading_font);
+    ImGui::TextWrapped("%s", dos_tr(lang, DosStrId::RandoScopeNote));
+    char seed_buf[40]{};
+    std::snprintf(seed_buf, sizeof(seed_buf), "%s", opt->dos.randomizer_seed.c_str());
+    ImGui::SetNextItemWidth(220.0f);
+    if (ImGui::InputText(dos_tr(lang, DosStrId::LblRandoSeed), seed_buf, sizeof(seed_buf))) {
+        opt->dos.randomizer_seed = dos_mod_sanitize_seed(seed_buf);
+        mark_dirty(ctx, false);
+    }
+    ImGui::SameLine();
+    if (ImGui::Button(dos_tr(lang, DosStrId::BtnRandomSeed), ImVec2(140.0f, 0.0f))) {
+        static uint64_t s_rng = 0x9E3779B97F4A7C15ULL;
+        s_rng ^= SDL_GetPerformanceCounter();
+        s_rng ^= s_rng >> 12;
+        s_rng ^= s_rng << 25;
+        s_rng ^= s_rng >> 27;
+        char gen[20]{};
+        std::snprintf(gen, sizeof(gen), "CDOS-%08X", static_cast<unsigned>(s_rng & 0xFFFFFFFFu));
+        opt->dos.randomizer_seed = gen;
+        mark_dirty(ctx, false);
+    }
+    static constexpr const char* kPresets[3] = {"casual", "standard", "hard"};
+    int cur_preset = 1;
+    for (int i = 0; i < 3; ++i) {
+        if (opt->dos.randomizer_preset == kPresets[i]) cur_preset = i;
+    }
+    ImGui::SetNextItemWidth(180.0f);
+    if (ImGui::Combo(dos_tr(lang, DosStrId::LblRandoPreset), &cur_preset, kPresets, 3)) {
+        opt->dos.randomizer_preset = kPresets[cur_preset];
+        mark_dirty(ctx, false);
+    }
+    ImGui::SameLine();
+    const bool seed_can_apply =
+        !opt->dos.randomizer_seed.empty() && opt->dos.allow_unverified_mods &&
+        opt->dos.active_campaign == "dawn-of-sorrow" &&
+        opt->dos.active_character_pack == "default";
+    if (!seed_can_apply) ImGui::BeginDisabled();
+    if (ImGui::Button(dos_tr(lang, DosStrId::BtnApplySeed), ImVec2(190.0f, 0.0f))) {
+        if (ctx.content_swap_requested) *ctx.content_swap_requested = true;
+    }
+    if (!seed_can_apply) ImGui::EndDisabled();
+    ImGui::SameLine();
+    if (opt->dos.randomizer_seed.empty()) ImGui::BeginDisabled();
+    if (ImGui::Button(dos_tr(lang, DosStrId::BtnClearSeed), ImVec2(130.0f, 0.0f))) {
+        opt->dos.randomizer_seed.clear();
+        mark_dirty(ctx, false);
+        if (ctx.content_swap_requested) *ctx.content_swap_requested = true;
+    }
+    if (opt->dos.randomizer_seed.empty()) ImGui::EndDisabled();
+}
