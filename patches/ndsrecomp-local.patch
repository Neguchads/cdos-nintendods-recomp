+        std::memcpy(wav.data() + 16, &fmt_sz, 4);
+        std::memcpy(wav.data() + 20, &pcm_fmt, 2);
+        std::memcpy(wav.data() + 22, &ch, 2);
+        std::memcpy(wav.data() + 24, &sr, 4);
+        std::memcpy(wav.data() + 28, &byte_rate, 4);
+        std::memcpy(wav.data() + 32, &align, 2);
+        std::memcpy(wav.data() + 34, &bps, 2);
+        std::memcpy(wav.data() + 36, "data", 4);
+        std::memcpy(wav.data() + 40, &data_bytes, 4);
+        for (uint32_t i = 0; i < frames; ++i) {
+            const int16_t sample = 12000;
+            std::memcpy(wav.data() + 44 + i * 4, &sample, 2);
+            std::memcpy(wav.data() + 44 + i * 4 + 2, &sample, 2);
+        }
+        std::ofstream wf(wav_path, std::ios::binary);
+        wf.write(reinterpret_cast<const char*>(wav.data()), static_cast<std::streamsize>(wav.size()));
+    }
+
+    dos_custom_music_reset();
+    dos_custom_music_set_enabled(true);
+    dos_custom_music_set_dir((tmp_dir / "music").string());
+    assert(dos_custom_music_status().installed_tracks == 1u);
+
+    // Simulate Main RAM with SSEQ #11 data16 on dynamic hardware player slot 2 (exact Nitro SDK 2.x protocol):
+    // node0: START_SEQ(player=2, base=0x02010000, offset=0, bank=0x02020000)
+    // node1: PLAYER_PARAM(cmd=4, player=2, offset=4 Priority, val=0x40, size=1) -> rewritten to offset=5 Volume=0!
+    // node2: PLAYER_PARAM(cmd=4, player=0 SFX, offset=5 Volume, val=100, size=1) -> must stay untouched!
+    std::vector<uint8_t> ram(4u * 1024u * 1024u, 0);
+    const auto& cat = dos_bgm_track_catalog();
+    std::memcpy(ram.data() + 0x10000u, cat[11].data16.data(), 16u);
+    auto wr32 = [&](uint32_t off, uint32_t v) { std::memcpy(ram.data() + off, &v, 4); };
+    auto rd32 = [&](uint32_t off) { uint32_t v = 0; std::memcpy(&v, ram.data() + off, 4); return v; };
+    // node0 @ 0x2000 -> next 0x02002020
+    wr32(0x2000, 0x02002020u); wr32(0x2004, 0u); wr32(0x2008, 2u); wr32(0x200C, 0x02010000u); wr32(0x2010, 0u); wr32(0x2014, 0x02020000u);
+    // node1 @ 0x2020 -> next 0x02002040
+    wr32(0x2020, 0x02002040u); wr32(0x2024, 4u); wr32(0x2028, 2u); wr32(0x202C, 4u); wr32(0x2030, 0x40u); wr32(0x2034, 1u);
+    // node2 @ 0x2040 -> next 0
+    wr32(0x2040, 0u); wr32(0x2044, 4u); wr32(0x2048, 0u); wr32(0x204C, 5u); wr32(0x2050, 100u); wr32(0x2054, 1u);
+
+    dos_custom_music_on_pxi_sound(0x02002000u, ram.data(), ram.size());
+    assert(rd32(0x2024) == 6u && rd32(0x202C) == 0xFFFFu && rd32(0x2030) == 1u);  // player 2 BGM muted via MUTE_TRACK
+    assert(rd32(0x204C) == 5u && rd32(0x2050) == 100u);  // player 0 SFX untouched!
+
+    const auto st = dos_custom_music_status();
+    assert(st.active_bgm_id == 11 && st.playing_custom);
+
+    std::array<int16_t, 512> mix_buf{};
+    dos_custom_music_mix(mix_buf.data(), 256, true, 100, true, 100);
+    assert(mix_buf[10] > 8000 && mix_buf[11] > 8000);
+
+    // Pause silences mix cleanly
+    dos_custom_music_set_host_paused(true);
+    std::array<int16_t, 64> paused_buf{};
+    dos_custom_music_mix(paused_buf.data(), 32, true, 100, true, 100);
+    assert(paused_buf[0] == 0 && paused_buf[1] == 0);
+    dos_custom_music_set_host_paused(false);
+
+    // Disable -> Re-enable resumes active track without needing a new START_SEQ
+    dos_custom_music_set_enabled(false);
+    assert(!dos_custom_music_status().playing_custom);
+    dos_custom_music_set_enabled(true);
+    assert(dos_custom_music_status().playing_custom);
+
+    // Rescan while track is active keeps it playing cleanly
+    assert(dos_custom_music_rescan() == 1u);
+    assert(dos_custom_music_status().playing_custom);
+
+    // Malformed WAV with sample_rate=1 must be rejected cleanly (no OOM / bad_alloc)
+    {
+        const std::filesystem::path bad_wav = tmp_dir / "music" / "bad_rate.wav";
+        std::vector<uint8_t> wav(48, 0);
+        std::memcpy(wav.data(), "RIFF", 4);
+        const uint32_t riff_sz = 40;
+        std::memcpy(wav.data() + 4, &riff_sz, 4);
+        std::memcpy(wav.data() + 8, "WAVEfmt ", 8);
+        const uint32_t fmt_sz = 16;
+        const uint16_t pcm_fmt = 1, ch = 2, align = 4, bps = 16;
+        const uint32_t bad_sr = 1;
+        const uint32_t byte_rate = 4;
+        const uint32_t data_bytes = 4;
+        std::memcpy(wav.data() + 16, &fmt_sz, 4);
+        std::memcpy(wav.data() + 20, &pcm_fmt, 2);
+        std::memcpy(wav.data() + 22, &ch, 2);
+        std::memcpy(wav.data() + 24, &bad_sr, 4);
+        std::memcpy(wav.data() + 28, &byte_rate, 4);
+        std::memcpy(wav.data() + 32, &align, 2);
+        std::memcpy(wav.data() + 34, &bps, 2);
+        std::memcpy(wav.data() + 36, "data", 4);
+        std::memcpy(wav.data() + 40, &data_bytes, 4);
+        std::ofstream bf(bad_wav, std::ios::binary);
+        bf.write(reinterpret_cast<const char*>(wav.data()), static_cast<std::streamsize>(wav.size()));
+        DosDecodedAudio dec{};
+        std::string err;
+        assert(!dos_custom_music_decode_file(bad_wav.string(), &dec, &err));
+        assert(!err.empty());
+    }
+
+    // STOP_SEQ(2) stops playback
+    wr32(0x2060, 0u); wr32(0x2064, 1u); wr32(0x2068, 2u);
+    dos_custom_music_on_pxi_sound(0x02002060u, ram.data(), ram.size());
+    assert(!dos_custom_music_status().playing_custom);
+
+    // 4. Visual Track Mapper (arbitrary filename -> stage #07) + Global Jukebox Playlist (mutes ANY BGM)
+    {
+        auto write_short_wav = [](const std::filesystem::path& p, int16_t val, uint32_t frames) {
+            const uint32_t sr = 32768;
+            const uint32_t data_bytes = frames * 4;
+            std::vector<uint8_t> wav(44 + data_bytes, 0);
+            std::memcpy(wav.data(), "RIFF", 4);
+            const uint32_t riff_sz = 36 + data_bytes;
+            std::memcpy(wav.data() + 4, &riff_sz, 4);
+            std::memcpy(wav.data() + 8, "WAVEfmt ", 8);
+            const uint32_t fmt_sz = 16;
+            const uint16_t pcm_fmt = 1, ch = 2, align = 4, bps = 16;
+            const uint32_t byte_rate = sr * 4;
+            std::memcpy(wav.data() + 16, &fmt_sz, 4);
+            std::memcpy(wav.data() + 20, &pcm_fmt, 2);
+            std::memcpy(wav.data() + 22, &ch, 2);
+            std::memcpy(wav.data() + 24, &sr, 4);
+            std::memcpy(wav.data() + 28, &byte_rate, 4);
+            std::memcpy(wav.data() + 32, &align, 2);
+            std::memcpy(wav.data() + 34, &bps, 2);
+            std::memcpy(wav.data() + 36, "data", 4);
+            std::memcpy(wav.data() + 40, &data_bytes, 4);
+            for (uint32_t i = 0; i < frames; ++i) {
+                std::memcpy(wav.data() + 44 + i * 4, &val, 2);
+                std::memcpy(wav.data() + 44 + i * 4 + 2, &val, 2);
+            }
+            std::ofstream wf(p, std::ios::binary);
+            wf.write(reinterpret_cast<const char*>(wav.data()), static_cast<std::streamsize>(wav.size()));
+        };
+
+        write_short_wav(tmp_dir / "music" / "random_rock_a.wav", 6000, 64);
+        write_short_wav(tmp_dir / "music" / "random_rock_b.wav", 14000, 64);
+        dos_custom_music_rescan();
+        const auto st_avail = dos_custom_music_status();
+        assert(st_avail.available_files.size() >= 3u);
+
+        // Assign arbitrary filename to stage #07 -> persists to music.json & survives rescan
+        assert(dos_custom_music_assign_track(7, "random_rock_a.wav"));
+        dos_custom_music_rescan();
+        assert(dos_custom_music_status().track_files[7] == "random_rock_a.wav");
+
+        // Enable Global Jukebox with 2 songs -> mutes unmapped BGM #13 (Dracula's Tears) & advances on finish
+        assert(dos_custom_music_set_jukebox(true, false, {"random_rock_a.wav", "random_rock_b.wav"}));
+        const auto jb_st = dos_custom_music_status();
+        assert(jb_st.jukebox_enabled && jb_st.playing_custom && jb_st.custom_file_label == "random_rock_a.wav");
+
+        // Unmapped BGM #13 START_SEQ + PLAYER_PARAM(Priority) must be muted via MUTE_TRACK in Jukebox mode
+        std::memcpy(ram.data() + 0x12000u, cat[13].data16.data(), 16u);
+        wr32(0x2100, 0x02002120u); wr32(0x2104, 0u); wr32(0x2108, 3u); wr32(0x210C, 0x02012000u); wr32(0x2110, 0u); wr32(0x2114, 0x02020000u);
+        wr32(0x2120, 0u);          wr32(0x2124, 4u); wr32(0x2128, 3u); wr32(0x212C, 4u);          wr32(0x2130, 0x40u); wr32(0x2134, 1u);
+        dos_custom_music_on_pxi_sound(0x02002100u, ram.data(), ram.size());
+        assert(rd32(0x2124) == 6u && rd32(0x212C) == 0xFFFFu && rd32(0x2130) == 1u);
+
+        // Mix past end of 64-frame random_rock_a.wav -> tick() advances to random_rock_b.wav!
+        std::array<int16_t, 256> jb_buf{};
+        dos_custom_music_mix(jb_buf.data(), 128, true, 100, true, 100);
+        dos_custom_music_tick();
+        assert(dos_custom_music_status().custom_file_label == "random_rock_b.wav");
+
+        // Prev returns to random_rock_a.wav
+        assert(dos_custom_music_jukebox_prev());
+        assert(dos_custom_music_status().custom_file_label == "random_rock_a.wav");
+
+        // Rescan preserves jukebox config persisted in music.json
+        dos_custom_music_rescan();
+        const auto jb_reloaded = dos_custom_music_status();
+        assert(jb_reloaded.jukebox_enabled && jb_reloaded.jukebox_playlist.size() == 2u);
+
+        // Disable jukebox restores Per-Track mode
+        assert(dos_custom_music_set_jukebox(false, false, jb_reloaded.jukebox_playlist));
+        assert(!dos_custom_music_status().jukebox_enabled);
+    }
+
+    dos_custom_music_reset();
+    std::filesystem::remove_all(tmp_dir, ec);
+}
+
+}  // namespace
+
+int main() {
+    test_enum_roundtrips();
+    test_frame_processor();
+    test_audio_processor();
+    test_hud_and_presets();
+    test_settings_ini_roundtrip();
+    test_frame_cache_hud_and_gpu_shader();
+    test_rom_patch();
+    test_content_profiles_and_intro_validation();
+    test_mod_registry_and_conflict_engine();
+    test_custom_music_and_widescreen_settings();
+    std::puts("dos_enhancements_test: ok");
+    return 0;
+}
