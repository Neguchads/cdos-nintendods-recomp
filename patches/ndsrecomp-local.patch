+void test_mod_registry_and_conflict_engine() {
+    // Path traversal sanitization
+    assert(dos_mod_sanitize_id("eternity-of-sorrow") == "eternity-of-sorrow");
+    assert(dos_mod_sanitize_id("../evil").empty());
+    assert(dos_mod_sanitize_id("a/b").empty());
+    assert(dos_mod_sanitize_id("C:drive").empty());
+    assert(dos_mod_sanitize_seed("CDOS-2026!@#../ok") == "CDOS-2026ok");
+
+    // Isolated save paths preserve PR #15 paths for original/definitive and namespace others
+    assert(dos_mod_isolated_save_path("saves/dos.sav", "original", "1.0", "abcd1234") == "saves/dos.sav");
+    assert(dos_mod_isolated_save_path("saves/dos.sav", "definitive", "1.0", "abcd1234").find("definitive") != std::string::npos);
+    const std::string custom_sav =
+        dos_mod_isolated_save_path("saves/dos.sav", "eternity-of-sorrow", "1.2", "deadbeef9999");
+    assert(custom_sav.find("eternity-of-sorrow-v1.2-deadbeef") != std::string::npos);
+
+    const auto tmp_dir = std::filesystem::temp_directory_path() / "dos_mod_reg_test";
+    std::error_code ec;
+    std::filesystem::remove_all(tmp_dir, ec);
+    std::filesystem::create_directories(tmp_dir / "data" / "profiles", ec);
+
+    const std::string reg_json = (tmp_dir / "registry.json").string();
+    const std::string reg_body = R"({
+      "schema": "cdos.mod-registry.v1",
+      "base_rom_sha1": "47530ff87e608f88105a314fdf36dc385f8dec94",
+      "runtime_compat": "cdos-recomp-v1",
+      "baselines": [
+        {"id": "definitive", "name": "Definitive", "version": "1.0", "builtin": true, "state": "verified", "validation_level": "full", "supports_ptbr": true},
+        {"id": "original", "name": "Original", "version": "1.0", "builtin": true, "state": "verified", "validation_level": "full", "supports_ptbr": true}
+      ],
+      "campaigns": [
+        {"id": "dawn-of-sorrow", "name": "DoS", "version": "1.0", "builtin": true, "state": "verified", "validation_level": "full", "supports_ptbr": true, "definitive_compatible": true, "allowed_character_packs": ["default", "albus-mode"]},
+        {"id": "eternity-of-sorrow", "name": "Eternity", "version": "1.2", "builtin": false, "state": "unverified", "validation_level": "boot_only", "profile_file": "eternity-of-sorrow.dospatch", "supports_ptbr": false, "definitive_compatible": false, "allowed_character_packs": ["default"]}
+      ],
+      "character_packs": [
+        {"id": "default", "name": "Native", "version": "1.0", "builtin": true, "state": "verified", "validation_level": "full", "compatible_campaigns": ["dawn-of-sorrow", "eternity-of-sorrow"], "supports_ptbr": true},
+        {"id": "albus-mode", "name": "Albus", "version": "1.0", "builtin": false, "state": "unverified", "validation_level": "none", "profile_file": "albus-mode.dospatch", "compatible_campaigns": ["dawn-of-sorrow"], "supports_ptbr": false}
+      ],
+      "verified_combinations": [
+        {"campaign": "dawn-of-sorrow", "character_pack": "default", "baseline": "definitive", "language": "en", "validation_level": "full"}
+      ]
+    })";
+    assert(dos_write_text_atomic(reg_json, reg_body));
+    // Install dummy eternity profile file; leave albus missing.
+    assert(dos_write_text_atomic((tmp_dir / "data" / "profiles" / "eternity-of-sorrow.dospatch").string(), "DOSPATCH"));
+
+    DosModRegistry reg{};
+    std::string err;
+    assert(dos_mod_registry_load(reg_json, (tmp_dir / "data").string(), &reg, &err));
+    assert(reg.loaded && reg.campaigns.size() == 2 && reg.character_packs.size() == 2);
+
+    DosRomPatchSet builtin{};
+    builtin.rom_base = {1, 2, 3, 4};
+    builtin.rom_definitive_en = {9, 9, 9, 1};
+    const std::string sha = "47530ff87e608f88105a314fdf36dc385f8dec94";
+
+    // 1. Verified combination
+    DosModSelection s_ok{};
+    auto dec = dos_mod_resolve_conflict(reg, s_ok, sha, builtin);
+    assert(dec.state == DosCompatState::Verified && dec.allowed);
+
+    // 2. Unverified campaign: blocked without opt-in, allowed with opt-in, never promoted to Verified
+    DosModSelection s_unv{};
+    s_unv.campaign_id = "eternity-of-sorrow";
+    s_unv.baseline_id = "original";
+    s_unv.allow_unverified = false;
+    dec = dos_mod_resolve_conflict(reg, s_unv, sha, builtin);
+    assert(dec.state == DosCompatState::Unverified && !dec.allowed);
+    s_unv.allow_unverified = true;
+    dec = dos_mod_resolve_conflict(reg, s_unv, sha, builtin);
+    assert(dec.state == DosCompatState::Unverified && dec.allowed);
+
+    // 3. Incompatible: Eternity + Definitive, Eternity + Albus, Eternity + PT-BR, missing Albus
+    DosModSelection s_bad = s_unv;
+    s_bad.baseline_id = "definitive";
+    assert(dos_mod_resolve_conflict(reg, s_bad, sha, builtin).state == DosCompatState::Incompatible);
+    s_bad = s_unv;
+    s_bad.character_pack_id = "albus-mode";
+    assert(dos_mod_resolve_conflict(reg, s_bad, sha, builtin).state == DosCompatState::Incompatible);
+    s_bad = s_unv;
+    s_bad.language = DosLanguage::PtBr;
+    assert(dos_mod_resolve_conflict(reg, s_bad, sha, builtin).state == DosCompatState::Incompatible);
+
+    DosModSelection s_missing{};
+    s_missing.character_pack_id = "albus-mode";
+    s_missing.baseline_id = "original";
+    assert(dos_mod_resolve_conflict(reg, s_missing, sha, builtin).state == DosCompatState::Incompatible);
+
+    // 4. Native C++ Seed Mutator conflict rules
+    DosModSelection s_seed{};
+    s_seed.randomizer_seed = "CASTLE2026";
+    s_seed.randomizer_preset = "standard";
+    s_seed.allow_unverified = false;
+    dec = dos_mod_resolve_conflict(reg, s_seed, sha, builtin);
+    assert(dec.state == DosCompatState::Unverified && !dec.allowed);
+    assert(dec.active_profile_id == "seed-castle2026");
+    assert(dec.active_version == "standard");
+
+    s_seed.allow_unverified = true;
+    dec = dos_mod_resolve_conflict(reg, s_seed, sha, builtin);
+    assert(dec.state == DosCompatState::Unverified && dec.allowed);
+
+    // Seed Mutator cannot be stacked on an overhaul campaign
+    DosModSelection s_seed_bad = s_seed;
+    s_seed_bad.campaign_id = "eternity-of-sorrow";
+    s_seed_bad.baseline_id = "original";
+    assert(dos_mod_resolve_conflict(reg, s_seed_bad, sha, builtin).state == DosCompatState::Incompatible);
+
+    // 5. Dynamic discovery of externally generated DSVania Randomizer (dsvrandom-*.dospatch)
+    assert(dos_write_text_atomic((tmp_dir / "data" / "profiles" / "dsvrandom-demo2026.dospatch").string(), "DOSPATCH"));
+    dos_mod_registry_rescan_installed(&reg);
+    DosModSelection s_dsv{};
+    s_dsv.campaign_id = "dsvrandom-demo2026";
+    s_dsv.baseline_id = "original";
+    s_dsv.allow_unverified = true;
+    dec = dos_mod_resolve_conflict(reg, s_dsv, sha, builtin);
+    assert(dec.state == DosCompatState::Unverified && dec.allowed);
+    assert(dec.validation_level == "external_randomizer");
+    // Must reject stacking dsvrandom over Definitive or PT-BR
+    s_dsv.baseline_id = "definitive";
+    assert(dos_mod_resolve_conflict(reg, s_dsv, sha, builtin).state == DosCompatState::Incompatible);
+
+    // 6. Seed Mutator binary safety: reject wrong game code and altered table signature
+    std::vector<uint8_t> fake_rom(kDosEnemyDnaTableRomOffset + kDosEnemyDnaTableBytes + 64, 0);
+    std::string mut_err;
+    assert(!dos_seed_verify_enemy_table_signature(fake_rom, &mut_err));
+    assert(mut_err.find("ACVE") != std::string::npos);
+    fake_rom[0x0C] = 'A';
+    fake_rom[0x0D] = 'C';
+    fake_rom[0x0E] = 'V';
+    fake_rom[0x0F] = 'E';
+    mut_err.clear();
+    assert(!dos_seed_mutator_apply(&fake_rom, "CASTLE2026", "standard", "definitive", "", nullptr, &mut_err));
+    assert(mut_err.find("signature mismatch") != std::string::npos);
+
+    // 7. If local USA ACVE ROM is present via env or relative workspace path, verify determinism, boss invariance, and spoiler log
+    std::filesystem::path local_rom;
+    if (const char* env_rom = std::getenv("CDOS_USA_ROM"); env_rom && env_rom[0] != '\0') {
+        local_rom = env_rom;
+    } else {
+        for (const char* rel : {
+                 "../../../Roms/Castlevania - Dawn of Sorrow (USA).nds",
+                 "../../Roms/Castlevania - Dawn of Sorrow (USA).nds",
+                 "../Roms/Castlevania - Dawn of Sorrow (USA).nds",
+             }) {
+            if (std::filesystem::is_regular_file(rel, ec)) {
+                local_rom = rel;
+                break;
+            }
+        }
+    }
+    if (!local_rom.empty() && std::filesystem::is_regular_file(local_rom, ec)) {
+        const auto sz = std::filesystem::file_size(local_rom, ec);
+        std::vector<uint8_t> rom_a(static_cast<size_t>(sz));
+        {
+            std::ifstream rf(local_rom, std::ios::binary);
+            rf.read(reinterpret_cast<char*>(rom_a.data()), static_cast<std::streamsize>(rom_a.size()));
+            assert(rf.good());
+        }
+        std::vector<uint8_t> rom_b = rom_a;
+        std::vector<uint8_t> rom_c = rom_a;
+        const std::vector<uint8_t> bosses_before(
+            rom_a.begin() + kDosEnemyDnaTableRomOffset + kDosEnemyDnaRegularCount * kDosEnemyDnaEntryStride,
+            rom_a.begin() + kDosEnemyDnaTableRomOffset + kDosEnemyDnaTableBytes);
+
+        DosSeedMutatorResult res_a{}, res_b{}, res_c{};
+        assert(dos_seed_mutator_apply(&rom_a, "CASTLE2026", "standard", "definitive",
+                                      (tmp_dir / "data").string(), &res_a, &mut_err));
+        assert(dos_seed_mutator_apply(&rom_b, "CASTLE2026", "standard", "definitive",
+                                      "", &res_b, &mut_err));
+        assert(dos_seed_mutator_apply(&rom_c, "OTHERSEED9", "hard", "definitive",
+                                      "", &res_c, &mut_err));
+        assert(rom_a == rom_b);
+        assert(res_a.table_hash_after == res_b.table_hash_after);
+        assert(rom_a != rom_c);
+        assert(res_a.table_hash_after != res_c.table_hash_after);
+        assert(res_a.enemies_mutated > 80);
+        assert(!res_a.spoiler_path.empty() && std::filesystem::is_regular_file(res_a.spoiler_path, ec));
+
+        // Verify bosses (101..117) and regular enemy code pointers + soul_id are 100% untouched
+        const std::vector<uint8_t> bosses_after(
+            rom_a.begin() + kDosEnemyDnaTableRomOffset + kDosEnemyDnaRegularCount * kDosEnemyDnaEntryStride,
+            rom_a.begin() + kDosEnemyDnaTableRomOffset + kDosEnemyDnaTableBytes);
+        assert(bosses_before == bosses_after);
+    }
+
+    std::filesystem::remove_all(tmp_dir, ec);
+}
