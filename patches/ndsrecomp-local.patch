+void test_hud_and_presets() {
+    std::vector<uint32_t> frame(256 * 192, 0xFF203040u);
+    DosHudMetrics m{};
+    m.fps = 60.0;
+    m.emu_ms = 2.4;
+    m.present_ms = 0.7;
+    m.tier3_kips = 1.2;
+    m.render_driver = "DX12";
+    m.hd_filter = "XBR2X";
+    m.layout = "PIP";
+    dos_draw_dev_hud(frame.data(), 256, 192, m);
+
+    bool drew_text = false;
+    for (int i = 0; i < 256 * 11; ++i) {
+        if (frame[i] == 0xFFE6FF80u) drew_text = true;
+    }
+    assert(drew_text);
+
+    NdsButtonBindings p{}, s{}, g{};
+    bool cg = false;
+    dos_apply_control_preset(DosControlPreset::ModernWasd, &p, &s, &g, &cg);
+    assert(p[4] == kDosMouseBindRight);   // Mouse Right = A (Special / Confirm)
+    assert(p[5] == 44 && s[5] == 44);     // Space = B (Jump) in both
+    assert(p[7] == kDosMouseBindLeft);    // Mouse Left = Y (Attack)
+    assert(p[8] == 20);                   // Q = L (Dash / Backdash)
+    assert(p[9] == 21);                   // R = R (Guardian Soul)
+    assert(s[8] == kDosMouseBindMiddle);  // Mouse Middle = L (Dash)
+    assert(cg && g[5] == 1 && g[7] == 3);
+    assert(dos_is_mouse_binding(kDosMouseBindLeft));
+    assert(dos_is_mouse_binding(kDosMouseBindMiddle));
+    assert(dos_is_mouse_binding(kDosMouseBindRight));
+    assert(!dos_is_mouse_binding(44));
+    assert(dos_mouse_button_to_binding(1) == kDosMouseBindLeft);
+    assert(dos_mouse_button_to_binding(2) == kDosMouseBindMiddle);
+    assert(dos_mouse_button_to_binding(3) == kDosMouseBindRight);
+    assert(dos_scancode_display_name(44) == "Space");
+    assert(dos_scancode_display_name(kDosMouseBindLeft) == "Mouse Left");
+    assert(dos_scancode_display_name(kDosMouseBindMiddle) == "Mouse Mid");
+    assert(dos_scancode_display_name(kDosMouseBindRight) == "Mouse Right");
+    assert(dos_gamepad_binding_display_name(1) == "Pad South (A)");
+
+    dos_clear_control_bindings(&p, &s, &g, &cg);
+    assert(cg);
+    for (size_t i = 0; i < 12; ++i) {
+        assert(p[i] == 0 && s[i] == 0 && g[i] == 0);
+    }
+}
