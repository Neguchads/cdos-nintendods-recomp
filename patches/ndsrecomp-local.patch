+std::string short_sha1_vec(const std::vector<uint8_t>& data) {
+    if (data.empty()) return "000000000000";
+    const std::string h = gba::sha1(data.data(), data.size()).hex();
+    return h.size() > 12 ? h.substr(0, 12) : h;
+}
