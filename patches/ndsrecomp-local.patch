+
+const char* dos_tr(DosLanguage lang, DosStrId id) {
+    const size_t idx = static_cast<size_t>(id);
+    if (idx >= kTable.size()) return "";
+    const auto& entry = kTable[idx];
+    return (lang == DosLanguage::PtBr) ? entry.ptbr : entry.en;
+}
+
+bool dos_i18n_self_check() {
+    for (size_t i = 0; i < kTable.size(); ++i) {
+        if (static_cast<size_t>(kTable[i].id) != i) return false;
+        if (!kTable[i].en || kTable[i].en[0] == '\0') return false;
+        if (!kTable[i].ptbr || kTable[i].ptbr[0] == '\0') return false;
+    }
+    return true;
+}
