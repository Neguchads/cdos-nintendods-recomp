+void sync_touch_geometry(const FrontendPresentation& presentation,
+                         NdsScreenPlacement& touch_placement,
+                         NdsScreenRect& bottom_touch_rect,
+                         int& bottom_logical_width,
+                         int& bottom_content_left,
+                         int& top_content_left,
+                         NdsLogicalRect& stacked_top_screen,
+                         NdsLogicalRect& stacked_bottom_touch) {
+    bottom_logical_width = presentation.separate
+        ? presentation.screen_widths[1]
+        : presentation.canvas_width;
+    bottom_content_left = (bottom_logical_width - kScreenWidth) / 2;
+    touch_placement = nds_screen_placement(
+        presentation.layout,
+        presentation.separate ? bottom_logical_width : presentation.screen_widths[0],
+        presentation.screen_widths[1], presentation.pip_corner,
+        presentation.pip_main, presentation.pip_size_pct);
+    bottom_touch_rect = nds_bottom_touch_rect(
+        touch_placement, presentation.screen_widths[1]);
+    top_content_left = presentation.separate
+        ? 0
+        : (presentation.canvas_width - presentation.screen_widths[0]) / 2;
+    const auto& top_rect = touch_placement.screens[0];
+    stacked_top_screen = {top_rect.x, top_rect.y, top_rect.w, top_rect.h};
+    stacked_bottom_touch = {
+        bottom_touch_rect.x, bottom_touch_rect.y,
+        bottom_touch_rect.w, bottom_touch_rect.h};
+}
