diff --git a/runner/src/dos_seed_mutator.cpp b/runner/src/dos_seed_mutator.cpp
new file mode 100644
index 0000000..bae38a0
--- /dev/null
+++ b/runner/src/dos_seed_mutator.cpp
@@ -0,0 +1,340 @@
+#include "dos_seed_mutator.h"
+
+#include <algorithm>
+#include <array>
+#include <cctype>
+#include <cmath>
+#include <cstdio>
+#include <filesystem>
+#include <iomanip>
+#include <sstream>
+
+#include "dos_mod_registry.h"
+
+namespace fs = std::filesystem;
+
+namespace {
+
+uint16_t read_u16_le(const uint8_t* p) {
+    return static_cast<uint16_t>(p[0]) | (static_cast<uint16_t>(p[1]) << 8);
+}
+
+void write_u16_le(uint8_t* p, uint16_t v) {
+    p[0] = static_cast<uint8_t>(v & 0xFFu);
+    p[1] = static_cast<uint8_t>((v >> 8) & 0xFFu);
+}
+
+std::string lower_ascii_str(const std::string& s) {
+    std::string out = s;
+    for (char& c : out) c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+    return out;
+}
+
+uint64_t splitmix64_next(uint64_t* state) {
+    uint64_t z = (*state += 0x9E3779B97F4A7C15ULL);
+    z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ULL;
+    z = (z ^ (z >> 27)) * 0x94D049BB133111EBULL;
+    return z ^ (z >> 31);
+}
+
+struct Xoshiro256StarStar {
+    std::array<uint64_t, 4> s{};
+
+    explicit Xoshiro256StarStar(uint64_t seed) {
+        uint64_t sm = seed;
+        for (uint64_t& w : s) w = splitmix64_next(&sm);
+    }
+
+    static uint64_t rotl(uint64_t x, int k) {
+        return (x << k) | (x >> (64 - k));
+    }
+
+    uint64_t next() {
+        const uint64_t result = rotl(s[1] * 5ULL, 7) * 9ULL;
+        const uint64_t t = s[1] << 17;
+        s[2] ^= s[0];
+        s[3] ^= s[1];
+        s[1] ^= s[2];
+        s[0] ^= s[3];
+        s[2] ^= t;
+        s[3] = rotl(s[3], 45);
+        return result;
+    }
+
+    // Numero real deterministico em [lo, hi].
+    double next_range(double lo, double hi) {
+        const double u = static_cast<double>(next() >> 11) * (1.0 / 9007199254740992.0);
+        return lo + u * (hi - lo);
+    }
+
+    size_t next_bounded(size_t bound) {
+        if (bound <= 1) return 0;
+        return static_cast<size_t>(next() % static_cast<uint64_t>(bound));
+    }
+};
+
+struct PresetRanges {
+    double hp_lo, hp_hi;
+    double exp_lo, exp_hi;
+    double atk_lo, atk_hi;
+    double def_lo, def_hi;
+    double soul_lo, soul_hi;
+    double drop_lo, drop_hi;
+};
+
+PresetRanges preset_ranges(DosSeedPreset p) {
+    switch (p) {
+        case DosSeedPreset::Casual:
+            return {0.70, 1.05, 1.20, 1.60, 0.80, 1.00, 0.80, 1.00, 1.25, 1.75, 1.20, 1.60};
+        case DosSeedPreset::Hard:
+            return {1.15, 1.65, 0.75, 1.10, 1.10, 1.45, 1.05, 1.35, 0.80, 1.15, 0.80, 1.15};
+        case DosSeedPreset::Standard:
+        default:
+            return {0.80, 1.35, 0.85, 1.35, 0.85, 1.25, 0.85, 1.25, 0.85, 1.35, 0.85, 1.35};
+    }
+}
+
+uint16_t scale_u16(uint16_t val, double mult, uint16_t min_v, uint16_t max_v) {
+    if (val == 0) return 0;
+    const double scaled = std::round(static_cast<double>(val) * mult);
+    const double clamped = std::clamp(scaled, static_cast<double>(min_v), static_cast<double>(max_v));
+    return static_cast<uint16_t>(clamped);
+}
+
+uint8_t scale_u8(uint8_t val, double mult, uint8_t min_v, uint8_t max_v) {
+    if (val == 0) return 0;
+    const double scaled = std::round(static_cast<double>(val) * mult);
+    const double clamped = std::clamp(scaled, static_cast<double>(min_v), static_cast<double>(max_v));
+    return static_cast<uint8_t>(clamped);
+}
+
+std::string hex64(uint64_t v) {
+    char buf[20]{};
+    std::snprintf(buf, sizeof(buf), "%016llx", static_cast<unsigned long long>(v));
+    return std::string(buf);
+}
+
+}  // namespace
+
+DosSeedPreset dos_seed_parse_preset(const std::string& name) {
+    const std::string lc = lower_ascii_str(name);
+    if (lc == "casual") return DosSeedPreset::Casual;
+    if (lc == "hard") return DosSeedPreset::Hard;
+    return DosSeedPreset::Standard;
+}
+
+const char* dos_seed_preset_name(DosSeedPreset preset) {
+    switch (preset) {
+        case DosSeedPreset::Casual:
+            return "casual";
+        case DosSeedPreset::Hard:
+            return "hard";
+        case DosSeedPreset::Standard:
+        default:
+            return "standard";
+    }
+}
+
+uint64_t dos_seed_fnv1a64(const uint8_t* data, size_t len) {
+    uint64_t h = 14695981039346656037ULL;
+    for (size_t i = 0; i < len; ++i) {
+        h ^= static_cast<uint64_t>(data[i]);
+        h *= 1099511628211ULL;
+    }
+    return h;
+}
+
+bool dos_seed_verify_enemy_table_signature(const std::vector<uint8_t>& rom,
+                                           std::string* error_out) {
+    if (rom.size() < kDosEnemyDnaTableRomOffset + kDosEnemyDnaTableBytes) {
+        if (error_out) *error_out = "ROM is too small to contain verified Dawn of Sorrow USA enemy table.";
+        return false;
+    }
+    if (rom[0x0C] != 'A' || rom[0x0D] != 'C' || rom[0x0E] != 'V' || rom[0x0F] != 'E') {
+        if (error_out) *error_out = "ROM game code is not USA ACVE; refusing to mutate unverified offsets.";
+        return false;
+    }
+    const uint64_t actual = dos_seed_fnv1a64(
+        rom.data() + kDosEnemyDnaTableRomOffset, kDosEnemyDnaTableBytes);
+    if (actual != kDosEnemyDnaTableFnv1a64) {
+        if (error_out) {
+            *error_out = "Enemy DNA table signature mismatch (got 0x" + hex64(actual) +
+                         ", expected 0x" + hex64(kDosEnemyDnaTableFnv1a64) +
+                         "); refusing to apply USA offsets on modified campaign ROM.";
+        }
+        return false;
+    }
+    return true;
+}
+
+bool dos_seed_mutator_apply(std::vector<uint8_t>* rom,
+                            const std::string& raw_seed,
+                            const std::string& preset_str,
+                            const std::string& base_profile_id,
+                            const std::string& data_mods_dir,
+                            DosSeedMutatorResult* result_out,
+                            std::string* error_out) {
+    if (!rom) {
+        if (error_out) *error_out = "Null ROM buffer.";
+        return false;
+    }
+    const std::string seed = dos_mod_sanitize_seed(raw_seed);
+    if (seed.empty()) {
+        if (error_out) *error_out = "Seed is empty or contains no valid [A-Za-z0-9_-] characters.";
+        return false;
+    }
+    if (!dos_seed_verify_enemy_table_signature(*rom, error_out)) {
+        return false;
+    }
+
+    const DosSeedPreset preset = dos_seed_parse_preset(preset_str);
+    const char* preset_cstr = dos_seed_preset_name(preset);
+    const PresetRanges r = preset_ranges(preset);
+
+    const std::string seed_key = "cdos-seed-mutator-v1|" + seed + "|" + preset_cstr + "|" + base_profile_id;
+    const uint64_t seed_u64 = dos_seed_fnv1a64(
+        reinterpret_cast<const uint8_t*>(seed_key.data()), seed_key.size());
+    Xoshiro256StarStar rng(seed_u64);
+
+    uint8_t* const tbl = rom->data() + kDosEnemyDnaTableRomOffset;
+    const uint64_t hash_before = kDosEnemyDnaTableFnv1a64;
+
+    // 1. Coleta e embaralha (Fisher-Yates) drops comuns e raros NAO-ZERO entre inimigos regulares (0..100).
+    std::vector<size_t> item1_slots;
+    std::vector<uint16_t> item1_vals;
+    std::vector<size_t> item2_slots;
+    std::vector<uint16_t> item2_vals;
+    item1_slots.reserve(kDosEnemyDnaRegularCount);
+    item1_vals.reserve(kDosEnemyDnaRegularCount);
+    item2_slots.reserve(kDosEnemyDnaRegularCount);
+    item2_vals.reserve(kDosEnemyDnaRegularCount);
+
+    struct OrigStats {
+        uint16_t item1, item2, hp, exp;
+        uint8_t soul_ch, atk, def, i1_ch, i2_ch;
+    };
+    std::array<OrigStats, kDosEnemyDnaRegularCount> orig{};
+
+    for (size_t i = 0; i < kDosEnemyDnaRegularCount; ++i) {
+        const uint8_t* e = tbl + i * kDosEnemyDnaEntryStride;
+        orig[i].item1 = read_u16_le(e + 0x08);
+        orig[i].item2 = read_u16_le(e + 0x0A);
+        orig[i].hp = read_u16_le(e + 0x0E);
+        orig[i].exp = read_u16_le(e + 0x12);
+        orig[i].soul_ch = e[0x14];
+        orig[i].atk = e[0x15];
+        orig[i].def = e[0x16];
+        orig[i].i1_ch = e[0x17];
+        orig[i].i2_ch = e[0x18];
+
+        if (orig[i].item1 != 0) {
+            item1_slots.push_back(i);
+            item1_vals.push_back(orig[i].item1);
+        }
+        if (orig[i].item2 != 0) {
+            item2_slots.push_back(i);
+            item2_vals.push_back(orig[i].item2);
+        }
+    }
+
+    for (size_t i = item1_vals.size(); i > 1; --i) {
+        const size_t j = rng.next_bounded(i);
+        std::swap(item1_vals[i - 1], item1_vals[j]);
+    }
+    for (size_t i = item2_vals.size(); i > 1; --i) {
+        const size_t j = rng.next_bounded(i);
+        std::swap(item2_vals[i - 1], item2_vals[j]);
+    }
+
+    size_t item1_swaps = 0;
+    for (size_t k = 0; k < item1_slots.size(); ++k) {
+        const size_t idx = item1_slots[k];
+        if (item1_vals[k] != orig[idx].item1) ++item1_swaps;
+        write_u16_le(tbl + idx * kDosEnemyDnaEntryStride + 0x08, item1_vals[k]);
+    }
+    size_t item2_swaps = 0;
+    for (size_t k = 0; k < item2_slots.size(); ++k) {
+        const size_t idx = item2_slots[k];
+        if (item2_vals[k] != orig[idx].item2) ++item2_swaps;
+        write_u16_le(tbl + idx * kDosEnemyDnaEntryStride + 0x0A, item2_vals[k]);
+    }
+
+    // 2. Escala deterministica de HP, EXP, ATK, DEF, soul_chance e item_drop_chances apenas para 0..100.
+    // Chefes (101..117), code pointers (+0x00..+0x07), soul_id (+0x1A) e flags nao sao alterados.
+    std::ostringstream spoiler;
+    spoiler << "# CDOS Recomp Native C++ Seed Mutator Spoiler Log\n";
+    spoiler << "seed=" << seed << "\n";
+    spoiler << "preset=" << preset_cstr << "\n";
+    spoiler << "base_profile=" << base_profile_id << "\n";
+    spoiler << "prng=xoshiro256ss(splitmix64(0x" << hex64(seed_u64) << "))\n";
+    spoiler << "scope=regular_enemies_0_to_100_non_progression_only\n";
+    spoiler << "untouched=bosses_101_to_117,soul_ids,code_pointers,progression_flags\n";
+    spoiler << "disclaimer=Non-progression enemy/drop mutator only. For full room/soul/item logic use DSVania Randomizer (dsvrandom) importer.\n\n";
+
+    size_t mutated_count = 0;
+    for (size_t i = 0; i < kDosEnemyDnaRegularCount; ++i) {
+        uint8_t* e = tbl + i * kDosEnemyDnaEntryStride;
+        const uint16_t new_hp = scale_u16(orig[i].hp, rng.next_range(r.hp_lo, r.hp_hi), 1u, 9999u);
+        const uint16_t new_exp = scale_u16(orig[i].exp, rng.next_range(r.exp_lo, r.exp_hi), 1u, 9999u);
+        const uint8_t new_atk = scale_u8(orig[i].atk, rng.next_range(r.atk_lo, r.atk_hi), 1u, 250u);
+        const uint8_t new_def = scale_u8(orig[i].def, rng.next_range(r.def_lo, r.def_hi), 1u, 200u);
+        const uint8_t new_sc = scale_u8(orig[i].soul_ch, rng.next_range(r.soul_lo, r.soul_hi), 1u, 255u);
+        const uint8_t new_i1c = scale_u8(orig[i].i1_ch, rng.next_range(r.drop_lo, r.drop_hi), 1u, 255u);
+        const uint8_t new_i2c = scale_u8(orig[i].i2_ch, rng.next_range(r.drop_lo, r.drop_hi), 1u, 255u);
+
+        write_u16_le(e + 0x0E, new_hp);
+        write_u16_le(e + 0x12, new_exp);
+        e[0x14] = new_sc;
+        e[0x15] = new_atk;
+        e[0x16] = new_def;
+        e[0x17] = new_i1c;
+        e[0x18] = new_i2c;
+
+        const uint16_t new_item1 = read_u16_le(e + 0x08);
+        const uint16_t new_item2 = read_u16_le(e + 0x0A);
+        if (new_hp != orig[i].hp || new_exp != orig[i].exp || new_atk != orig[i].atk ||
+            new_def != orig[i].def || new_sc != orig[i].soul_ch || new_i1c != orig[i].i1_ch ||
+            new_i2c != orig[i].i2_ch || new_item1 != orig[i].item1 || new_item2 != orig[i].item2) {
+            ++mutated_count;
+        }
+
+        spoiler << "enemy#" << std::setw(3) << std::setfill('0') << i
+                << " HP:" << orig[i].hp << "->" << new_hp
+                << " EXP:" << orig[i].exp << "->" << new_exp
+                << " ATK:" << static_cast<unsigned>(orig[i].atk) << "->" << static_cast<unsigned>(new_atk)
+                << " DEF:" << static_cast<unsigned>(orig[i].def) << "->" << static_cast<unsigned>(new_def)
+                << " SOUL_CH:" << static_cast<unsigned>(orig[i].soul_ch) << "->" << static_cast<unsigned>(new_sc)
+                << " ITEM1:0x" << std::hex << orig[i].item1 << "->0x" << new_item1
+                << " ITEM2:0x" << orig[i].item2 << "->0x" << new_item2 << std::dec << "\n";
+    }
+
+    const uint64_t hash_after = dos_seed_fnv1a64(tbl, kDosEnemyDnaTableBytes);
+    spoiler << "\ntable_fnv1a64_before=0x" << hex64(hash_before) << "\n";
+    spoiler << "table_fnv1a64_after=0x" << hex64(hash_after) << "\n";
+    spoiler << "enemies_mutated=" << mutated_count << "/" << kDosEnemyDnaRegularCount << "\n";
+    spoiler << "item1_swaps=" << item1_swaps << " item2_swaps=" << item2_swaps << "\n";
+
+    const std::string spoiler_str = spoiler.str();
+    std::string spoiler_path;
+    if (!data_mods_dir.empty()) {
+        const std::string fname = "seed-" + lower_ascii_str(seed) + "-" + preset_cstr + "-spoiler.txt";
+        spoiler_path = (fs::path(data_mods_dir) / "cache" / fname).string();
+        if (!dos_write_text_atomic(spoiler_path, spoiler_str)) {
+            spoiler_path.clear();
+        }
+    }
+
+    if (result_out) {
+        result_out->sanitized_seed = seed;
+        result_out->preset_name = preset_cstr;
+        result_out->seed_u64 = seed_u64;
+        result_out->table_hash_before = hash_before;
+        result_out->table_hash_after = hash_after;
+        result_out->enemies_mutated = mutated_count;
+        result_out->item1_swaps = item1_swaps;
+        result_out->item2_swaps = item2_swaps;
+        result_out->spoiler_text = spoiler_str;
+        result_out->spoiler_path = spoiler_path;
+    }
+    return true;
+}
