+    const int want_vsync =
+        (vsync_env && vsync_env[0] != '\0')
+            ? (std::strcmp(vsync_env, "1") == 0 ? 1 : 0)
+            : (options.dos.vsync ? 1 : 0);
+    for (int s = 0; s < 2; ++s) {
+        if (presentation.renderers[s] && (s == 0 || presentation.separate)) {
+            SDL_SetRenderVSync(presentation.renderers[s], want_vsync);
+        }
+    }
+#endif
+    if (!presentation.separate && !presentation.gl_top) {
+        if (options.screen_layout != NdsScreenLayout::Separate) {
+            presentation.layout = options.screen_layout;
+        }
+        presentation.pip =
+            presentation.layout == NdsScreenLayout::PictureInPicture;
+        const auto placement = nds_screen_placement(
+            presentation.layout, presentation.screen_widths[0],
+            presentation.screen_widths[1], presentation.pip_corner,
+            presentation.pip_main, presentation.pip_size_pct);
+        presentation.canvas_width = placement.width;
+        presentation.canvas_height = placement.height;
+        set_render_logical_size(presentation.renderers[0],
+                                presentation.canvas_width,
+                                presentation.canvas_height,
+                                presentation.aspect_mode,
+                                presentation.pip);
+        if (options.fullscreen == NdsFullscreenMode::Off &&
+            presentation.windows[0]) {
+            const int win_scale = options.window_scale ? options.window_scale : kWindowScale;
+            SDL_SetWindowSize(presentation.windows[0],
+                              presentation.canvas_width * win_scale,
+                              presentation.canvas_height * win_scale);
+        }
+    } else if (presentation.separate && !presentation.gl_top) {
+        for (int s = 0; s < 2; ++s) {
+            if (presentation.renderers[s]) {
+                set_render_logical_size(presentation.renderers[s],
+                                        presentation.screen_widths[s],
+                                        kScreenHeight,
+                                        presentation.aspect_mode, false);
+            }
+        }
+    }
+    if (!presentation.gl_top) {
+        for (int s = 0; s < 2; ++s) {
+            if (presentation.renderers[s]) {
+                int tw = 0, th = 0;
+                bool linear = false;
+                screen_texture_params(presentation, options, s, &tw, &th, &linear);
+                ensure_screen_texture(presentation, s, tw, th, linear);
