+#ifdef _MSC_VER /* MSVC6 has no long long */
+typedef unsigned __int64 stb_vorbis_uint64;
+typedef   signed __int64  stb_vorbis_int64;
+#else
+#include <stdint.h>
+typedef uint64_t   stb_vorbis_uint64;
