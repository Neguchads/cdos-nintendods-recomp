+SDL_Rect runtime_menu_overlay_rect(const FrontendPresentation& presentation) {
+    if (presentation.separate) {
+        return {0, 0, presentation.screen_widths[0], kScreenHeight};
+    }
+    const int cw = std::max(presentation.canvas_width, 1);
+    const int ch = std::max(presentation.canvas_height, 1);
+    int draw_h = std::min(ch, kScreenHeight);
+    int draw_w = std::min(cw, draw_h * 4 / 3);
+    if (draw_w < 128) draw_w = cw;
+    if (draw_h < 96) draw_h = ch;
+    return {(cw - draw_w) / 2, (ch - draw_h) / 2, draw_w, draw_h};
