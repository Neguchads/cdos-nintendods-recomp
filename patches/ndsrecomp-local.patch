+        g_dos_wide_enabled && preflight_ok && live_gameplay &&
+        multi_screen_room && nds_gpu3d_output_width() == kDosWideWidth;
+
+    if (preflight_ok) {
+        for (size_t i = 0; i < kSiteCount; ++i) {
+            const uint32_t target =
+                want_wide ? kDosWideSites[i].wide_word : kDosWideSites[i].native_word;
+            if (cur_words[i] != target) {
+                bus_write_u32_slow(kDosWideSites[i].addr, target);
+            }
+        }
+    } else if (g_dos_wide_enabled && state_ok && !g_logged_dos_wide_preflight_fail) {
+        std::fprintf(stderr,
+                     "[dos-wide] ARM9 preflight mismatch; keeping native 256x192 safely\n");
+        g_logged_dos_wide_preflight_fail = true;
+    }
+
+    bool bg2_wrap_256 = false;
+    if (multi_screen_room) {
+        int16_t cur_max_x = 0;
+        if (read_main_ram16(kDosCamMaxXAddr, &cur_max_x)) {
+            const int16_t native_max_x =
+                static_cast<int16_t>((static_cast<int>(width_screens) - 1) * 256);
+            const int16_t wide_max_x =
+                static_cast<int16_t>(static_cast<int>(width_screens) * 256 -
+                                     static_cast<int>(kDosWideWidth));
+            if (want_wide && cur_max_x == native_max_x) {
+                bus_write_u16_slow(kDosCamMaxXAddr,
+                                   static_cast<uint16_t>(wide_max_x));
