+        DosVsyncMode::Off, DosVsyncMode::On, DosVsyncMode::Adaptive};
+    static constexpr std::array<DosStrId, 3> kVsyncNames = {
+        DosStrId::VsyncOff, DosStrId::VsyncOn, DosStrId::VsyncAdaptive};
+    if (combo_enum(dos_tr(lang, DosStrId::LblVsync), &opt->dos.vsync_mode,
+                   kVsyncModes, kVsyncNames, lang)) {
+        opt->dos.vsync = (opt->dos.vsync_mode != DosVsyncMode::Off);
+        mark_dirty(ctx, true);
+    }
+
+    begin_section(dos_tr(lang, DosStrId::SecFilters), heading_font);
+    // Lista curada de filtros 2D sem distorcao/derretimento de pixel art.
+    static constexpr std::array<DosHdFilter, 5> kFilters = {
+        DosHdFilter::Pixellate, DosHdFilter::PixelAa,
+        DosHdFilter::BandlimitedPixel, DosHdFilter::Nearest,
+        DosHdFilter::Bilinear};
+    static constexpr std::array<DosStrId, 5> kFilterNames = {
+        DosStrId::FilterPixellate, DosStrId::FilterPixelAa,
+        DosStrId::FilterBandlimitedPixel, DosStrId::FilterNearest,
+        DosStrId::FilterBilinear};
+    const char* filter_preview = dos_tr(lang, DosStrId::FilterPixellate);
+    int curated_filter_idx = -1;
+    if (opt->dos.hd_filter == DosHdFilter::SharpBilinear) {
+        curated_filter_idx = 0;
+        filter_preview = dos_tr(lang, DosStrId::FilterPixellate);
+    } else if (opt->dos.hd_filter == DosHdFilter::Xbr2x) {
+        filter_preview = dos_tr(lang, DosStrId::FilterXbr2x);
+    } else if (opt->dos.hd_filter == DosHdFilter::Scale2x) {
+        filter_preview = dos_tr(lang, DosStrId::FilterScale2x);
+    } else {
+        for (size_t i = 0; i < kFilters.size(); ++i) {
+            if (kFilters[i] == opt->dos.hd_filter) {
+                curated_filter_idx = static_cast<int>(i);
+                filter_preview = dos_tr(lang, kFilterNames[i]);
+                break;
+            }
+        }
+    }
+    if (ImGui::BeginCombo(dos_tr(lang, DosStrId::LblHdFilter), filter_preview)) {
+        for (size_t i = 0; i < kFilters.size(); ++i) {
+            const bool selected = (curated_filter_idx == static_cast<int>(i));
+            if (ImGui::Selectable(dos_tr(lang, kFilterNames[i]), selected)) {
+                opt->dos.hd_filter = kFilters[i];
+                mark_dirty(ctx, true);
+            }
+            if (selected) ImGui::SetItemDefaultFocus();
+        }
+        ImGui::EndCombo();
+    }
+
+    static constexpr std::array<DosColorMode, 3> kColors = {
+        DosColorMode::VividHd, DosColorMode::Native, DosColorMode::DsAuthentic};
+    static constexpr std::array<DosStrId, 3> kColorNames = {
+        DosStrId::ColorVivid, DosStrId::ColorNative, DosStrId::ColorDsAuthentic};
+    if (combo_enum(dos_tr(lang, DosStrId::LblColorMode), &opt->dos.color_mode,
+                   kColors, kColorNames, lang)) {
+        mark_dirty(ctx, false);
+    }
+
+    static constexpr std::array<DosPostFx, 4> kPostFx = {
+        DosPostFx::Off, DosPostFx::ScanlinesLight, DosPostFx::Crt, DosPostFx::LcdGrid};
+    static constexpr std::array<DosStrId, 4> kPostFxNames = {
+        DosStrId::FxOff, DosStrId::FxScanlines, DosStrId::FxCrt, DosStrId::FxLcdGrid};
+    if (combo_enum(dos_tr(lang, DosStrId::LblPostFx), &opt->dos.post_fx,
+                   kPostFx, kPostFxNames, lang)) {
+        if (opt->dos.post_fx != DosPostFx::Crt) {
+            opt->dos.crt_curvature_pct = 0;
+        }
+        mark_dirty(ctx, false);
+    }
+    if (opt->dos.post_fx == DosPostFx::Off) ImGui::BeginDisabled();
+    int fx_int = opt->dos.post_fx_intensity_pct;
+    if (ImGui::SliderInt(dos_tr(lang, DosStrId::LblPostFxIntensity), &fx_int, 0, 100, "%d%%")) {
+        opt->dos.post_fx_intensity_pct = static_cast<uint8_t>(fx_int);
+        mark_dirty(ctx, false);
+    }
+    if (opt->dos.post_fx == DosPostFx::Off) ImGui::EndDisabled();
+    const bool crt_active = (opt->dos.post_fx == DosPostFx::Crt);
+    if (!crt_active) ImGui::BeginDisabled();
+    int curv = opt->dos.crt_curvature_pct;
+    if (ImGui::SliderInt(dos_tr(lang, DosStrId::LblCrtCurvature), &curv, 0, 30, "%d%%")) {
+        opt->dos.crt_curvature_pct = static_cast<uint8_t>(curv);
+        mark_dirty(ctx, false);
+    }
+    if (!crt_active) ImGui::EndDisabled();
+
+    begin_section(dos_tr(lang, DosStrId::Sec3dEngine), heading_font);
+    static constexpr const char* kIntResLabels[] = {"1x Native", "2x HD", "3x HD", "4x Ultra HD"};
+    int int_res_idx = std::clamp(static_cast<int>(opt->internal_resolution) - 1, 0, 3);
+    if (ImGui::Combo(dos_tr(lang, DosStrId::LblInternalRes), &int_res_idx, kIntResLabels, 4)) {
+        opt->internal_resolution = static_cast<uint8_t>(int_res_idx + 1);
+        mark_dirty(ctx, false);
+    }
+    static constexpr const char* kTexLabels[] = {"1x Off", "2x", "4x"};
+    int tex_idx = (opt->texture_upscale >= 4) ? 2 : (opt->texture_upscale >= 2 ? 1 : 0);
+    if (ImGui::Combo(dos_tr(lang, DosStrId::LblTextureUpscale), &tex_idx, kTexLabels, 3)) {
+        opt->texture_upscale = (tex_idx == 2) ? 4 : (tex_idx == 1 ? 2 : 1);
+        mark_dirty(ctx, false);
+    }
+    static constexpr const char* kMsaaLabels[] = {"Off (1x)", "2x MSAA", "4x MSAA", "8x MSAA"};
+    static constexpr uint8_t kMsaaVals[] = {0, 2, 4, 8};
+    int msaa_idx = (opt->antialiasing >= 8) ? 3 : (opt->antialiasing >= 4 ? 2 : (opt->antialiasing >= 2 ? 1 : 0));
+    if (ImGui::Combo(dos_tr(lang, DosStrId::LblMsaa), &msaa_idx, kMsaaLabels, 4)) {
+        opt->antialiasing = kMsaaVals[msaa_idx];
+        opt->dos.antialiasing = opt->antialiasing;
+        mark_dirty(ctx, false);
+        self.push_toast(dos_tr(lang, DosStrId::LblMsaa),
+                        dos_tr(lang, DosStrId::ToastDriverNote), 2.5);
+    }
+
+    ImGui::Spacing();
+    if (ImGui::CollapsingHeader(dos_tr(lang, DosStrId::SecColorTuning))) {
+        int br = opt->dos.brightness_pct;
+        int co = opt->dos.contrast_pct;
+        int sa = opt->dos.saturation_pct;
+        int ga = opt->dos.gamma_pct;
+        int ct = opt->dos.color_temp;
+        int bl = opt->dos.bloom_pct;
+        int vi = opt->dos.vignette_pct;
+        if (ImGui::SliderInt(dos_tr(lang, DosStrId::LblBrightness), &br, 80, 130, "%d%%")) {
+            opt->dos.brightness_pct = static_cast<uint8_t>(br);
+            mark_dirty(ctx, false);
+        }
+        if (ImGui::SliderInt(dos_tr(lang, DosStrId::LblContrast), &co, 80, 130, "%d%%")) {
+            opt->dos.contrast_pct = static_cast<uint8_t>(co);
+            mark_dirty(ctx, false);
+        }
+        if (ImGui::SliderInt(dos_tr(lang, DosStrId::LblSaturation), &sa, 70, 140, "%d%%")) {
+            opt->dos.saturation_pct = static_cast<uint8_t>(sa);
+            mark_dirty(ctx, false);
+        }
+        if (ImGui::SliderInt(dos_tr(lang, DosStrId::LblGamma), &ga, 70, 150, "%d%%")) {
+            opt->dos.gamma_pct = static_cast<uint8_t>(ga);
+            mark_dirty(ctx, false);
+        }
+        if (ImGui::SliderInt(dos_tr(lang, DosStrId::LblColorTemp), &ct, -30, 30, "%+d")) {
+            opt->dos.color_temp = static_cast<int8_t>(ct);
+            mark_dirty(ctx, false);
+        }
+        if (ImGui::SliderInt(dos_tr(lang, DosStrId::LblBloom), &bl, 0, 50, "%d%%")) {
+            opt->dos.bloom_pct = static_cast<uint8_t>(bl);
+            mark_dirty(ctx, false);
+        }
+        if (ImGui::SliderInt(dos_tr(lang, DosStrId::LblVignette), &vi, 0, 50, "%d%%")) {
+            opt->dos.vignette_pct = static_cast<uint8_t>(vi);
+            mark_dirty(ctx, false);
+        }
+        static constexpr std::array<DosSharpenMode, 3> kSharpen = {
+            DosSharpenMode::Off, DosSharpenMode::Subtle, DosSharpenMode::Strong};
+        static constexpr std::array<DosStrId, 3> kSharpenNames = {
+            DosStrId::SharpenOff, DosStrId::SharpenSubtle, DosStrId::SharpenStrong};
+        if (combo_enum(dos_tr(lang, DosStrId::LblSharpen), &opt->dos.sharpen,
+                       kSharpen, kSharpenNames, lang)) {
+            mark_dirty(ctx, false);
+        }
+        if (ImGui::Button(dos_tr(lang, DosStrId::BtnResetImageTuning))) {
+            opt->dos.brightness_pct = 100;
+            opt->dos.contrast_pct = 100;
+            opt->dos.saturation_pct = 100;
+            opt->dos.gamma_pct = 100;
+            opt->dos.color_temp = 0;
+            opt->dos.bloom_pct = 0;
+            opt->dos.vignette_pct = 0;
+            opt->dos.crt_curvature_pct = 0;
+            opt->dos.post_fx_intensity_pct = 100;
+            opt->dos.sharpen = DosSharpenMode::Off;
+            mark_dirty(ctx, false);
+        }
+    }
+}
