+NdsScreenPlacement compute_effective_placement(const FrontendPresentation& p) {
+    NdsScreenPlacement pl = nds_screen_placement(
+        p.layout,
+        p.separate ? p.screen_widths[1] : p.screen_widths[0],
+        p.screen_widths[1], p.pip_corner, p.pip_main, p.pip_size_pct);
+    if (!p.separate && p.aspect_mode == DosAspectMode::Balanced16x10) {
+        pl.width = (pl.width * 6 + 2) / 5;
+        for (int s = 0; s < 2; ++s) {
+            pl.screens[s].x = (pl.screens[s].x * 6 + 2) / 5;
+            pl.screens[s].w = (pl.screens[s].w * 6 + 2) / 5;
+        }
+    } else if (!p.separate && p.aspect_mode == DosAspectMode::Ultrawide21x9 &&
+               pl.height > 0) {
+        const int uw_w = (pl.height * 21 + 4) / 9;
+        if (uw_w > pl.width && pl.width > 0) {
+            const int old_w = pl.width;
+            pl.width = uw_w;
+            for (int s = 0; s < 2; ++s) {
+                pl.screens[s].x = (pl.screens[s].x * uw_w + old_w / 2) / old_w;
+                pl.screens[s].w = (pl.screens[s].w * uw_w + old_w / 2) / old_w;
+            }
+        }
+    } else if (!p.separate && p.aspect_mode == DosAspectMode::SmartCrop16x9 &&
+               p.widescreen_crop_offset_y != 0) {
+        const int shift = std::clamp<int>(p.widescreen_crop_offset_y, -24, 24);
+        for (int s = 0; s < 2; ++s) {
+            if (pl.screens[s].w > 0 && pl.screens[s].h > 0) {
+                pl.screens[s].y += shift;
+            }
+        }
+    }
+    if (!p.separate && p.safe_zone_pct > 0) {
+        const int pct = std::clamp<int>(p.safe_zone_pct, 0, 10);
+        const int pad_x = (pl.width * pct + 50) / 100;
+        const int pad_y = (pl.height * pct + 50) / 100;
+        pl.width += 2 * pad_x;
+        pl.height += 2 * pad_y;
+        for (int s = 0; s < 2; ++s) {
+            if (pl.screens[s].w > 0 && pl.screens[s].h > 0) {
+                pl.screens[s].x += pad_x;
+                pl.screens[s].y += pad_y;
+            }
+        }
+    }
+    return pl;
+}
