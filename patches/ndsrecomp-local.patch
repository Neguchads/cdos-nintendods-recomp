+void place_window_on_display(SDL_Window* win, int8_t display_index,
+                             NdsFullscreenMode fs, int desired_w, int desired_h,
+                             bool force_move, bool apply_size) {
+    if (!win) return;
+    const SDL_DisplayID current_disp = SDL_GetDisplayForWindow(win);
+    // Preserve current monitor when display_index is Auto (-1) unless an explicit
+    // monitor switch was requested, so secondary-monitor users are never yanked back.
+    const SDL_DisplayID target_disp =
+        (display_index < 0 && !force_move && current_disp != 0)
+            ? current_disp
+            : resolve_display_id(display_index);
+    const bool display_changed = (target_disp != 0 && target_disp != current_disp);
+    if (fs != NdsFullscreenMode::Off) {
+        if (display_changed) {
+            SDL_SetWindowFullscreen(win, false);
+            SDL_Rect bounds{};
+            if (SDL_GetDisplayBounds(target_disp, &bounds)) {
+                SDL_SetWindowPosition(win, bounds.x + 32, bounds.y + 32);
+            }
+        }
+        SDL_SetWindowFullscreen(win, true);
+        return;
+    }
+    SDL_SetWindowFullscreen(win, false);
+    if (!apply_size && !force_move && !display_changed) {
+        return;
+    }
+    SDL_Rect usable{};
+    const SDL_DisplayID disp = target_disp ? target_disp : current_disp;
+    const bool has_usable = disp && SDL_GetDisplayUsableBounds(disp, &usable) && usable.w > 64 && usable.h > 64;
+    int w = desired_w;
+    int h = desired_h;
+    if (!apply_size) {
+        SDL_GetWindowSize(win, &w, &h);
+    } else if (has_usable && (w > usable.w || h > usable.h)) {
+        const double sx = static_cast<double>(usable.w) / static_cast<double>(std::max(w, 1));
+        const double sy = static_cast<double>(usable.h) / static_cast<double>(std::max(h, 1));
+        const double sc = std::min(sx, sy);
+        w = std::max(256, static_cast<int>(std::floor(w * sc)));
+        h = std::max(192, static_cast<int>(std::floor(h * sc)));
+    }
+    if (apply_size && w > 0 && h > 0) {
+        SDL_SetWindowSize(win, w, h);
+    }
+    if (force_move || display_changed) {
+        if (has_usable) {
+            SDL_SetWindowPosition(win,
+                                  usable.x + (usable.w - w) / 2,
+                                  usable.y + (usable.h - h) / 2);
+        } else {
+            SDL_SetWindowPosition(win, SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED);
+        }
+    }
+}
