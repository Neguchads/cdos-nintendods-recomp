+void patch_dos_true_widescreen() {
+    uint32_t state_ptr = 0;
+    uint8_t game_mode = 0;
+    const bool state_ok =
+        read_main_ram_word(kDosStatePtrAddr, &state_ptr) &&
+        state_ptr == kDosExpectedStatePtr &&
+        read_main_ram8(kDosGameModeAddr, &game_mode);
