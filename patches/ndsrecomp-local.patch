+}  // namespace
+
+DosIntroPlayResult dos_play_intro_video(SDL_Window* window,
+                                        SDL_Renderer* renderer,
+                                        const std::string& video_path,
+                                        bool audio_enabled,
+                                        uint8_t audio_volume_pct,
+                                        bool mute_audio) {
+    DosIntroPlayResult result{};
+    if (!window || !renderer) {
+        result.error = "SDL window/renderer unavailable";
+        return result;
+    }
+    if (!dos_intro_validate_mp4_file(video_path, &result.error)) {
+        return result;
+    }
+
+    const char* max_ms_env = std::getenv("NDS_INTRO_MAX_MS");
+    const uint64_t max_ms = (max_ms_env && max_ms_env[0] != '\0')
+                                ? static_cast<uint64_t>(std::strtoull(max_ms_env, nullptr, 10))
+                                : 0ULL;
+
+    HRESULT hr_com = CoInitializeEx(nullptr, COINIT_MULTITHREADED);
+    const bool com_uninit = SUCCEEDED(hr_com);
+    if (FAILED(hr_com) && hr_com != RPC_E_CHANGED_MODE) {
+        result.error = "CoInitializeEx failed";
+        return result;
+    }
+
+    HRESULT hr = MFStartup(MF_VERSION);
+    if (FAILED(hr)) {
+        if (com_uninit) CoUninitialize();
+        result.error = "MFStartup failed";
+        return result;
+    }
+
+    IMFAttributes* attrs = nullptr;
+    IMFSourceReader* reader = nullptr;
+    IMFMediaType* req_video = nullptr;
+    IMFMediaType* cur_video = nullptr;
+    IMFMediaType* req_audio = nullptr;
+    IMFMediaType* cur_audio = nullptr;
+    SDL_Texture* texture = nullptr;
+    SDL_AudioStream* audio_stream = nullptr;
+
+    auto cleanup = [&]() {
+        if (audio_stream) {
+            SDL_DestroyAudioStream(audio_stream);
+            audio_stream = nullptr;
+        }
+        if (texture) {
+            SDL_DestroyTexture(texture);
+            texture = nullptr;
+        }
+        safe_release(cur_audio);
+        safe_release(req_audio);
+        safe_release(cur_video);
+        safe_release(req_video);
+        safe_release(reader);
+        safe_release(attrs);
+        MFShutdown();
+        if (com_uninit) CoUninitialize();
+    };
+
+    hr = MFCreateAttributes(&attrs, 1);
+    if (SUCCEEDED(hr)) {
+        attrs->SetUINT32(MF_SOURCE_READER_ENABLE_VIDEO_PROCESSING, TRUE);
+    }
+
+    const std::wstring wpath = utf8_to_wide_path(video_path);
+    hr = MFCreateSourceReaderFromURL(wpath.c_str(), attrs, &reader);
+    if (FAILED(hr) || !reader) {
+        result.error = "MFCreateSourceReaderFromURL failed";
+        cleanup();
+        return result;
+    }
+
+    // Configura video para RGB32 (BGRX 8-bit por canal)
+    hr = MFCreateMediaType(&req_video);
+    if (SUCCEEDED(hr)) {
+        req_video->SetGUID(MF_MT_MAJOR_TYPE, MFMediaType_Video);
+        req_video->SetGUID(MF_MT_SUBTYPE, MFVideoFormat_RGB32);
+        hr = reader->SetCurrentMediaType(
+            static_cast<DWORD>(MF_SOURCE_READER_FIRST_VIDEO_STREAM), nullptr, req_video);
+    }
+    if (FAILED(hr)) {
+        result.error = "Failed to configure Media Foundation RGB32 video output";
+        cleanup();
+        return result;
+    }
+
+    hr = reader->GetCurrentMediaType(
+        static_cast<DWORD>(MF_SOURCE_READER_FIRST_VIDEO_STREAM), &cur_video);
+    UINT32 vid_w = 0, vid_h = 0;
+    if (FAILED(hr) || !cur_video || FAILED(MFGetAttributeSize(cur_video, MF_MT_FRAME_SIZE, &vid_w, &vid_h)) ||
+        vid_w == 0 || vid_h == 0) {
+        result.error = "Could not query video frame dimensions";
+        cleanup();
+        return result;
+    }
+    LONG src_stride = static_cast<LONG>(vid_w * 4u);
+    UINT32 raw_stride = 0;
+    if (SUCCEEDED(cur_video->GetUINT32(MF_MT_DEFAULT_STRIDE, &raw_stride)) && raw_stride != 0) {
+        src_stride = static_cast<LONG>(raw_stride);
+    }
+
+    result.width = static_cast<int>(vid_w);
+    result.height = static_cast<int>(vid_h);
+
+    // Configura audio PCM 16-bit (opcional: falha de audio nao impede video)
+    bool has_audio = false;
+    if (audio_enabled && !mute_audio && audio_volume_pct > 0) {
+        if (SUCCEEDED(MFCreateMediaType(&req_audio))) {
+            req_audio->SetGUID(MF_MT_MAJOR_TYPE, MFMediaType_Audio);
+            req_audio->SetGUID(MF_MT_SUBTYPE, MFAudioFormat_PCM);
+            req_audio->SetUINT32(MF_MT_AUDIO_BITS_PER_SAMPLE, 16);
+            if (SUCCEEDED(reader->SetCurrentMediaType(
+                    static_cast<DWORD>(MF_SOURCE_READER_FIRST_AUDIO_STREAM), nullptr, req_audio)) &&
+                SUCCEEDED(reader->GetCurrentMediaType(
+                    static_cast<DWORD>(MF_SOURCE_READER_FIRST_AUDIO_STREAM), &cur_audio)) &&
+                cur_audio) {
+                UINT32 channels = 2;
+                UINT32 sample_rate = 44100;
+                cur_audio->GetUINT32(MF_MT_AUDIO_NUM_CHANNELS, &channels);
+                cur_audio->GetUINT32(MF_MT_AUDIO_SAMPLES_PER_SECOND, &sample_rate);
+                SDL_AudioSpec spec{};
+                spec.format = SDL_AUDIO_S16;
+                spec.channels = static_cast<int>(channels ? channels : 2);
+                spec.freq = static_cast<int>(sample_rate ? sample_rate : 44100);
+                audio_stream = SDL_OpenAudioDeviceStream(
+                    SDL_AUDIO_DEVICE_DEFAULT_PLAYBACK, &spec, nullptr, nullptr);
+                if (audio_stream) {
+                    SDL_ResumeAudioStreamDevice(audio_stream);
+                    has_audio = true;
+                }
+            }
+        }
+    }
+
+    texture = SDL_CreateTexture(
+        renderer, SDL_PIXELFORMAT_XRGB8888, SDL_TEXTUREACCESS_STREAMING,
+        static_cast<int>(vid_w), static_cast<int>(vid_h));
+    if (!texture) {
+        result.error = "SDL_CreateTexture failed for intro video";
+        cleanup();
+        return result;
+    }
+    SDL_SetTextureScaleMode(texture, SDL_SCALEMODE_LINEAR);
+
+    // Salva e suspende apresentacao logica do renderer para preencher a janela com nitidez
+    int saved_lw = 0, saved_lh = 0;
+    SDL_RendererLogicalPresentation saved_lmode = SDL_LOGICAL_PRESENTATION_DISABLED;
+    SDL_GetRenderLogicalPresentation(renderer, &saved_lw, &saved_lh, &saved_lmode);
+    if (saved_lmode != SDL_LOGICAL_PRESENTATION_DISABLED) {
+        SDL_SetRenderLogicalPresentation(renderer, 0, 0, SDL_LOGICAL_PRESENTATION_DISABLED);
+    }
+
+    std::fprintf(stderr, "[intro-video] playing %s (%ux%u, audio=%s)\n",
+                 video_path.c_str(), vid_w, vid_h, has_audio ? "on" : "off");
+
+    const float audio_gain = static_cast<float>(std::clamp<int>(audio_volume_pct, 0, 150)) / 100.0f;
+    std::vector<uint8_t> frame_rgb(static_cast<size_t>(vid_w) * static_cast<size_t>(vid_h) * 4u);
+    std::vector<int16_t> audio_scratch;
+
+    const uint64_t start_ticks_ns = SDL_GetTicksNS();
+    bool video_eof = false;
+    bool audio_eof = !has_audio;
+    LONGLONG last_audio_ts = -1;
+
+    auto poll_skip_or_quit = [&]() -> bool {
+        SDL_Event ev{};
+        while (SDL_PollEvent(&ev)) {
+            if (ev.type == SDL_EVENT_QUIT) {
+                result.quit_requested = true;
+                return true;
+            }
+            if ((ev.type == SDL_EVENT_KEY_DOWN && !ev.key.repeat) ||
+                ev.type == SDL_EVENT_MOUSE_BUTTON_DOWN ||
+                ev.type == SDL_EVENT_GAMEPAD_BUTTON_DOWN) {
+                result.skipped = true;
+                return true;
+            }
+        }
+        return false;
+    };
+
+    while (!video_eof) {
+        if (poll_skip_or_quit()) break;
+        if (max_ms > 0) {
+            const uint64_t elapsed_ms = (SDL_GetTicksNS() - start_ticks_ns) / 1000000ULL;
+            if (elapsed_ms >= max_ms) {
+                result.skipped = true;
+                break;
+            }
+        }
+
+        DWORD flags = 0;
+        LONGLONG video_ts = 0;
+        IMFSample* video_sample = nullptr;
+        hr = reader->ReadSample(
+            static_cast<DWORD>(MF_SOURCE_READER_FIRST_VIDEO_STREAM),
+            0, nullptr, &flags, &video_ts, &video_sample);
+        if (FAILED(hr) || (flags & MF_SOURCE_READERF_ENDOFSTREAM)) {
+            safe_release(video_sample);
+            video_eof = true;
+            break;
+        }
+
+        // Alimenta audio adiantado (~250ms a frente do video) para reproducao sem cortes
+        if (has_audio && !audio_eof && audio_stream) {
+            const LONGLONG target_audio_ts = video_ts + 2500000LL;  // +250 ms em unidades de 100ns
+            while (!audio_eof && last_audio_ts < target_audio_ts) {
+                DWORD aflags = 0;
+                LONGLONG ats = 0;
+                IMFSample* audio_sample = nullptr;
+                HRESULT ahr = reader->ReadSample(
+                    static_cast<DWORD>(MF_SOURCE_READER_FIRST_AUDIO_STREAM),
+                    0, nullptr, &aflags, &ats, &audio_sample);
+                if (FAILED(ahr) || (aflags & MF_SOURCE_READERF_ENDOFSTREAM)) {
+                    safe_release(audio_sample);
+                    audio_eof = true;
+                    break;
+                }
+                if (audio_sample) {
+                    last_audio_ts = ats;
+                    IMFMediaBuffer* abuf = nullptr;
+                    if (SUCCEEDED(audio_sample->ConvertToContiguousBuffer(&abuf)) && abuf) {
+                        BYTE* ptr = nullptr;
+                        DWORD max_len = 0, cur_len = 0;
+                        if (SUCCEEDED(abuf->Lock(&ptr, &max_len, &cur_len)) && ptr && cur_len >= 2) {
+                            const size_t scount = cur_len / sizeof(int16_t);
+                            audio_scratch.resize(scount);
+                            std::memcpy(audio_scratch.data(), ptr, scount * sizeof(int16_t));
+                            scale_pcm16_inplace(audio_scratch.data(), scount, audio_gain);
+                            SDL_PutAudioStreamData(
+                                audio_stream, audio_scratch.data(),
+                                static_cast<int>(scount * sizeof(int16_t)));
+                            abuf->Unlock();
+                        }
+                        safe_release(abuf);
+                    }
+                    safe_release(audio_sample);
+                }
+            }
+        }
+
+        if (video_sample) {
+            IMFMediaBuffer* vbuf = nullptr;
+            if (SUCCEEDED(video_sample->ConvertToContiguousBuffer(&vbuf)) && vbuf) {
+                BYTE* ptr = nullptr;
+                DWORD max_len = 0, cur_len = 0;
+                if (SUCCEEDED(vbuf->Lock(&ptr, &max_len, &cur_len)) && ptr) {
+                    const size_t row_bytes = static_cast<size_t>(vid_w) * 4u;
+                    const size_t abs_stride = static_cast<size_t>(std::abs(src_stride));
+                    if (abs_stride >= row_bytes && cur_len >= abs_stride * vid_h) {
+                        for (UINT32 y = 0; y < vid_h; ++y) {
+                            const UINT32 sy = (src_stride < 0) ? (vid_h - 1u - y) : y;
+                            std::memcpy(
+                                frame_rgb.data() + static_cast<size_t>(y) * row_bytes,
+                                ptr + static_cast<size_t>(sy) * abs_stride,
+                                row_bytes);
+                        }
+                        SDL_UpdateTexture(texture, nullptr, frame_rgb.data(), static_cast<int>(row_bytes));
+                    }
+                    vbuf->Unlock();
+                }
+                safe_release(vbuf);
+            }
+            safe_release(video_sample);
+
+            // Sincroniza apresentacao do quadro com o relogio real (100ns -> ns = *100)
+            const uint64_t target_ns = start_ticks_ns + static_cast<uint64_t>(std::max<LONGLONG>(0, video_ts)) * 100ULL;
+            while (true) {
+                if (poll_skip_or_quit()) break;
+                const uint64_t now_ns = SDL_GetTicksNS();
+                if (now_ns >= target_ns) break;
+                const uint64_t wait_ms = (target_ns - now_ns) / 1000000ULL;
+                SDL_Delay(static_cast<Uint32>(std::min<uint64_t>(wait_ms, 8ULL)));
+            }
+            if (result.skipped || result.quit_requested) break;
+
+            int out_w = 0, out_h = 0;
+            SDL_GetCurrentRenderOutputSize(renderer, &out_w, &out_h);
+            SDL_SetRenderDrawColor(renderer, 0, 0, 0, 255);
+            SDL_RenderClear(renderer);
+            if (out_w > 0 && out_h > 0) {
+                const float src_aspect = static_cast<float>(vid_w) / static_cast<float>(vid_h);
+                const float dst_aspect = static_cast<float>(out_w) / static_cast<float>(out_h);
+                SDL_FRect dst{};
+                if (dst_aspect > src_aspect) {
+                    dst.h = static_cast<float>(out_h);
+                    dst.w = dst.h * src_aspect;
+                    dst.x = (static_cast<float>(out_w) - dst.w) * 0.5f;
+                    dst.y = 0.0f;
+                } else {
+                    dst.w = static_cast<float>(out_w);
+                    dst.h = dst.w / src_aspect;
+                    dst.x = 0.0f;
+                    dst.y = (static_cast<float>(out_h) - dst.h) * 0.5f;
+                }
+                SDL_RenderTexture(renderer, texture, nullptr, &dst);
+            }
+            SDL_RenderPresent(renderer);
+            ++result.frames_presented;
+            result.played = true;
+        }
+    }
+
+    if (saved_lmode != SDL_LOGICAL_PRESENTATION_DISABLED) {
+        SDL_SetRenderLogicalPresentation(renderer, saved_lw, saved_lh, saved_lmode);
+    }
+
+    std::fprintf(stderr, "[intro-video] finished (frames=%d, skipped=%d, quit=%d)\n",
+                 result.frames_presented, result.skipped ? 1 : 0, result.quit_requested ? 1 : 0);
+    cleanup();
+    return result;
+}
+
+#else
+
+DosIntroPlayResult dos_play_intro_video(SDL_Window*,
+                                        SDL_Renderer*,
+                                        const std::string& video_path,
+                                        bool,
+                                        uint8_t,
+                                        bool) {
+    DosIntroPlayResult result{};
+    dos_intro_validate_mp4_file(video_path, &result.error);
+    if (result.error.empty()) {
+        result.error = "Native intro video player requires Windows + SDL3";
+    }
+    return result;
+}
+
+#endif
diff --git a/runner/src/dos_intro_player.h b/runner/src/dos_intro_player.h
new file mode 100644
index 0000000..9020ba0
--- /dev/null
+++ b/runner/src/dos_intro_player.h
@@ -0,0 +1,30 @@
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+struct SDL_Window;
+struct SDL_Renderer;
+
+struct DosIntroPlayResult {
+    bool played = false;
+    bool skipped = false;
+    bool quit_requested = false;
+    int frames_presented = 0;
+    int width = 0;
+    int height = 0;
+    std::string error;
+};
+
+// Valida assinatura binaria MP4 (box 'ftyp') do video de abertura antes de decodificar.
+bool dos_intro_validate_mp4_file(const std::string& path, std::string* error_out = nullptr);
+
+// Reproduz o video de abertura nativamente via Windows Media Foundation + SDL3.
+// Qualquer tecla, clique do mouse ou botao do controle pula imediatamente para o jogo.
+// Se o arquivo nao existir ou falhar, retorna played=false sem interromper o boot.
+DosIntroPlayResult dos_play_intro_video(SDL_Window* window,
+                                        SDL_Renderer* renderer,
+                                        const std::string& video_path,
+                                        bool audio_enabled,
+                                        uint8_t audio_volume_pct,
+                                        bool mute_audio);
diff --git a/runner/src/dos_mod_profile.cpp b/runner/src/dos_mod_profile.cpp
new file mode 100644
index 0000000..37ecc25
--- /dev/null
+++ b/runner/src/dos_mod_profile.cpp
@@ -0,0 +1,116 @@
+#include "dos_mod_profile.h"
+
+#include <cstdio>
+#include <filesystem>
+
+#include "dos_rom_patch.h"
+#include "sha1.h"
+
+namespace {
+
+void try_load_one_patch(const std::vector<uint8_t>& rom_base,
+                        const std::string& path,
+                        const char* tag,
+                        std::vector<uint8_t>* dst) {
+    if (!dst) return;
+    dst->clear();
+    if (path.empty() || rom_base.empty()) return;
+    std::error_code ec;
+    if (!std::filesystem::exists(path, ec)) {
+        std::fprintf(stderr, "[%s] file not found (%s); skipping\n", tag, path.c_str());
+        return;
+    }
+    std::string err;
+    if (dos_rom_patch_apply_file(rom_base, path, dst, &err)) {
+        std::fprintf(stderr, "[%s] loaded %s (%zu bytes)\n", tag, path.c_str(), dst->size());
+    } else {
+        dst->clear();
+        std::fprintf(stderr, "[%s] warning (%s): %s; skipping\n", tag, path.c_str(), err.c_str());
+    }
+}
+
+std::string short_sha1(const std::vector<uint8_t>& data) {
+    if (data.empty()) return "empty";
+    const std::string full = gba::sha1(data.data(), data.size()).hex();
+    return full.size() > 12 ? full.substr(0, 12) : full;
+}
+
+}  // namespace
+
+void dos_mod_load_patch_set(const std::vector<uint8_t>& rom_base,
+                            const std::string& original_ptbr_path,
+                            const std::string& definitive_en_path,
+                            const std::string& definitive_ptbr_path,
+                            DosRomPatchSet* out_set) {
+    if (!out_set) return;
+    out_set->rom_base = rom_base;
+    try_load_one_patch(rom_base, original_ptbr_path, "ptbr-patch", &out_set->rom_original_ptbr);
+    try_load_one_patch(rom_base, definitive_en_path, "definitive-en-patch", &out_set->rom_definitive_en);
+    try_load_one_patch(rom_base, definitive_ptbr_path, "definitive-ptbr-patch", &out_set->rom_definitive_ptbr);
+}
+
+bool dos_build_active_rom(const DosRomPatchSet& set,
+                          DosContentProfile requested_profile,
+                          DosLanguage requested_language,
+                          std::vector<uint8_t>* out_rom,
+                          DosActiveRomSelection* selection_out) {
+    if (!out_rom || set.rom_base.empty()) return false;
+
+    const std::vector<uint8_t>* chosen = &set.rom_base;
+    DosContentProfile actual_profile = DosContentProfile::Original;
+    DosLanguage actual_lang = DosLanguage::English;
+    const char* label = "Original USA (English)";
+
+    if (requested_profile == DosContentProfile::Definitive && set.has_definitive()) {
+        if (requested_language == DosLanguage::PtBr && !set.rom_definitive_ptbr.empty()) {
+            chosen = &set.rom_definitive_ptbr;
+            actual_profile = DosContentProfile::Definitive;
+            actual_lang = DosLanguage::PtBr;
+            label = "Definitive Edition (PT-BR)";
+        } else if (!set.rom_definitive_en.empty()) {
+            chosen = &set.rom_definitive_en;
+            actual_profile = DosContentProfile::Definitive;
+            actual_lang = DosLanguage::English;
+            label = "Definitive Edition (English)";
+        } else if (!set.rom_definitive_ptbr.empty()) {
+            chosen = &set.rom_definitive_ptbr;
+            actual_profile = DosContentProfile::Definitive;
+            actual_lang = DosLanguage::PtBr;
+            label = "Definitive Edition (PT-BR)";
+        }
+    } else if (requested_language == DosLanguage::PtBr && !set.rom_original_ptbr.empty()) {
+        chosen = &set.rom_original_ptbr;
+        actual_profile = DosContentProfile::Original;
+        actual_lang = DosLanguage::PtBr;
+        label = "Original USA (PT-BR)";
+    }
+
+    *out_rom = *chosen;
+    if (selection_out) {
+        selection_out->actual_profile = actual_profile;
+        selection_out->actual_language = actual_lang;
+        selection_out->label = label;
+        selection_out->modset_hash = short_sha1(*chosen);
+    }
+    return true;
+}
+
+std::string dos_profile_savestate_dir(const std::string& base_dir, DosContentProfile profile) {
+    if (base_dir.empty() || profile == DosContentProfile::Original) {
+        return base_dir;
+    }
+    return (std::filesystem::path(base_dir) / "definitive").string();
+}
+
+std::string dos_profile_save_path(const std::string& base_save_path, DosContentProfile profile) {
+    if (base_save_path.empty() || profile == DosContentProfile::Original) {
+        return base_save_path;
+    }
+    const std::filesystem::path p(base_save_path);
+    const std::filesystem::path parent = p.parent_path();
+    const std::filesystem::path filename = p.filename();
+    if (parent.empty()) {
+        return (std::filesystem::path("definitive") / filename).string();
+    }
+    return (parent / "definitive" / filename).string();
+}
diff --git a/runner/src/dos_mod_profile.h b/runner/src/dos_mod_profile.h
new file mode 100644
index 0000000..b5a0dc8
--- /dev/null
+++ b/runner/src/dos_mod_profile.h
@@ -0,0 +1,54 @@
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "dos_enhancements.h"
+
+struct DosRomPatchSet {
+    std::vector<uint8_t> rom_base;
+    std::vector<uint8_t> rom_original_ptbr;
+    std::vector<uint8_t> rom_definitive_en;
+    std::vector<uint8_t> rom_definitive_ptbr;
+
+    bool has_definitive() const {
+        return !rom_definitive_en.empty() || !rom_definitive_ptbr.empty();
+    }
+    bool has_ptbr() const {
+        return !rom_original_ptbr.empty() || !rom_definitive_ptbr.empty();
+    }
+    bool has_ptbr_for(DosContentProfile profile) const {
+        if (profile == DosContentProfile::Definitive) {
+            return !rom_definitive_ptbr.empty() || !rom_original_ptbr.empty();
+        }
+        return !rom_original_ptbr.empty();
+    }
+};
+
+struct DosActiveRomSelection {
+    DosContentProfile actual_profile = DosContentProfile::Original;
+    DosLanguage actual_language = DosLanguage::English;
+    std::string label;
+    std::string modset_hash;
+};
+
+// Carrega os deltas DOSPATCH opcionais sobre rom_base em RAM sem alterar o arquivo original.
+void dos_mod_load_patch_set(const std::vector<uint8_t>& rom_base,
+                            const std::string& original_ptbr_path,
+                            const std::string& definitive_en_path,
+                            const std::string& definitive_ptbr_path,
+                            DosRomPatchSet* out_set);
+
+// Seleciona e copia para out_rom o buffer validado para (perfil, idioma) com fallback seguro.
+bool dos_build_active_rom(const DosRomPatchSet& set,
+                          DosContentProfile requested_profile,
+                          DosLanguage requested_language,
+                          std::vector<uint8_t>* out_rom,
+                          DosActiveRomSelection* selection_out = nullptr);
+
+// Isola diretorio de savestates por perfil para evitar incompatibilidade entre ROMs.
+std::string dos_profile_savestate_dir(const std::string& base_dir, DosContentProfile profile);
+
+// Isola caminho de save (.sav) por perfil (Original preserva caminho raiz; Definitive usa subpasta).
+std::string dos_profile_save_path(const std::string& base_save_path, DosContentProfile profile);
diff --git a/runner/src/dos_mod_registry.cpp b/runner/src/dos_mod_registry.cpp
new file mode 100644
index 0000000..beb3088
--- /dev/null
+++ b/runner/src/dos_mod_registry.cpp
@@ -0,0 +1,804 @@
+#include "dos_mod_registry.h"
+
+#include <algorithm>
+#include <cctype>
+#include <cstdio>
+#include <filesystem>
+#include <fstream>
+#include <sstream>
+
+#include "dos_rom_patch.h"
+#include "dos_seed_mutator.h"
+#include "sha1.h"
+
+namespace {
+
+namespace fs = std::filesystem;
+
+// Parser JSON minimo (somente leitura) para mods/registry.json, sem dependencias externas.
+struct JsonVal {
+    enum class Type { Null, Bool, Number, String, Array, Object } type = Type::Null;
+    bool b = false;
+    double n = 0.0;
+    std::string s;
+    std::vector<JsonVal> arr;
+    std::vector<std::pair<std::string, JsonVal>> obj;
+
+    const JsonVal* field(const char* key) const {
+        if (type != Type::Object) return nullptr;
+        for (const auto& kv : obj) {
+            if (kv.first == key) return &kv.second;
+        }
+        return nullptr;
+    }
+    std::string str_or(const char* key, const std::string& def = "") const {
+        const JsonVal* v = field(key);
+        return (v && v->type == Type::String) ? v->s : def;
+    }
+    bool bool_or(const char* key, bool def = false) const {
+        const JsonVal* v = field(key);
+        return (v && v->type == Type::Bool) ? v->b : def;
+    }
+    std::vector<std::string> str_list(const char* key) const {
+        std::vector<std::string> out;
+        const JsonVal* v = field(key);
+        if (!v || v->type != Type::Array) return out;
+        for (const auto& elem : v->arr) {
+            if (elem.type == Type::String) out.push_back(elem.s);
+        }
+        return out;
+    }
+};
+
+class MiniJsonParser {
+public:
+    explicit MiniJsonParser(std::string src) : src_(std::move(src)) {}
+
+    bool parse(JsonVal* out) {
+        skip_ws();
+        if (!parse_value(out)) return false;
+        skip_ws();
+        return pos_ == src_.size();
+    }
+
+private:
+    std::string src_;
+    size_t pos_ = 0;
+
+    void skip_ws() {
+        while (pos_ < src_.size() &&
+               (src_[pos_] == ' ' || src_[pos_] == '\t' || src_[pos_] == '\r' || src_[pos_] == '\n')) {
+            ++pos_;
+        }
+    }
+
+    bool parse_value(JsonVal* out) {
+        skip_ws();
+        if (pos_ >= src_.size()) return false;
+        const char ch = src_[pos_];
+        if (ch == '{') return parse_object(out);
+        if (ch == '[') return parse_array(out);
+        if (ch == '"') {
+            out->type = JsonVal::Type::String;
+            return parse_string(&out->s);
+        }
+        if (ch == 't' && src_.compare(pos_, 4, "true") == 0) {
+            pos_ += 4;
+            out->type = JsonVal::Type::Bool;
+            out->b = true;
+            return true;
+        }
+        if (ch == 'f' && src_.compare(pos_, 5, "false") == 0) {
+            pos_ += 5;
+            out->type = JsonVal::Type::Bool;
+            out->b = false;
+            return true;
+        }
+        if (ch == 'n' && src_.compare(pos_, 4, "null") == 0) {
+            pos_ += 4;
+            out->type = JsonVal::Type::Null;
+            return true;
+        }
+        if (ch == '-' || std::isdigit(static_cast<unsigned char>(ch))) {
+            size_t start = pos_;
+            if (src_[pos_] == '-') ++pos_;
+            while (pos_ < src_.size() &&
+                   (std::isdigit(static_cast<unsigned char>(src_[pos_])) ||
+                    src_[pos_] == '.' || src_[pos_] == 'e' || src_[pos_] == 'E' ||
+                    src_[pos_] == '+' || src_[pos_] == '-')) {
+                ++pos_;
+            }
+            out->type = JsonVal::Type::Number;
+            out->n = std::strtod(src_.substr(start, pos_ - start).c_str(), nullptr);
+            return true;
+        }
+        return false;
+    }
+
+    bool parse_string(std::string* out) {
+        if (pos_ >= src_.size() || src_[pos_] != '"') return false;
+        ++pos_;
+        out->clear();
+        while (pos_ < src_.size()) {
+            const char c = src_[pos_++];
+            if (c == '"') return true;
+            if (c == '\\') {
+                if (pos_ >= src_.size()) return false;
+                const char esc = src_[pos_++];
+                switch (esc) {
+                    case '"': out->push_back('"'); break;
+                    case '\\': out->push_back('\\'); break;
+                    case '/': out->push_back('/'); break;
+                    case 'b': out->push_back('\b'); break;
+                    case 'f': out->push_back('\f'); break;
+                    case 'n': out->push_back('\n'); break;
+                    case 'r': out->push_back('\r'); break;
+                    case 't': out->push_back('\t'); break;
+                    case 'u':
+                        if (pos_ + 4 > src_.size()) return false;
+                        pos_ += 4;
+                        out->push_back('?');
+                        break;
+                    default: out->push_back(esc); break;
+                }
+            } else {
+                out->push_back(c);
+            }
+        }
+        return false;
+    }
+
+    bool parse_array(JsonVal* out) {
+        ++pos_;  // '['
+        out->type = JsonVal::Type::Array;
+        out->arr.clear();
+        skip_ws();
+        if (pos_ < src_.size() && src_[pos_] == ']') {
+            ++pos_;
+            return true;
+        }
+        while (pos_ < src_.size()) {
+            JsonVal item{};
+            if (!parse_value(&item)) return false;
+            out->arr.push_back(std::move(item));
+            skip_ws();
+            if (pos_ < src_.size() && src_[pos_] == ',') {
+                ++pos_;
+                continue;
+            }
+            if (pos_ < src_.size() && src_[pos_] == ']') {
+                ++pos_;
+                return true;
+            }
+            return false;
+        }
+        return false;
+    }
+
+    bool parse_object(JsonVal* out) {
+        ++pos_;  // '{'
+        out->type = JsonVal::Type::Object;
+        out->obj.clear();
+        skip_ws();
+        if (pos_ < src_.size() && src_[pos_] == '}') {
+            ++pos_;
+            return true;
+        }
+        while (pos_ < src_.size()) {
+            skip_ws();
+            std::string key;
+            if (!parse_string(&key)) return false;
+            skip_ws();
+            if (pos_ >= src_.size() || src_[pos_] != ':') return false;
+            ++pos_;
+            JsonVal val{};
+            if (!parse_value(&val)) return false;
+            out->obj.emplace_back(std::move(key), std::move(val));
+            skip_ws();
+            if (pos_ < src_.size() && src_[pos_] == ',') {
+                ++pos_;
+                continue;
+            }
+            if (pos_ < src_.size() && src_[pos_] == '}') {
+                ++pos_;
+                return true;
+            }
+            return false;
+        }
+        return false;
+    }
+};
+
+std::string lower_ascii(std::string s) {
+    for (char& c : s) c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+    return s;
+}
+
+bool is_safe_leaf_filename(const std::string& name) {
+    if (name.empty() || name.size() > 128) return false;
+    if (name.find("..") != std::string::npos) return false;
+    if (name.find('/') != std::string::npos || name.find('\\') != std::string::npos ||
+        name.find(':') != std::string::npos) {
+        return false;
+    }
+    return true;
+}
