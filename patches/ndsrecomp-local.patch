+inline int clamp255(int v) {
+    return v < 0 ? 0 : (v > 255 ? 255 : v);
+}
+
+inline uint32_t pack_argb(int r, int g, int b) {
+    return 0xFF000000u |
+           (static_cast<uint32_t>(clamp255(r)) << 16) |
+           (static_cast<uint32_t>(clamp255(g)) << 8) |
+           static_cast<uint32_t>(clamp255(b));
+}
+
+struct DosColorLuts {
+    std::array<uint8_t, 256> vivid{};
+    std::array<uint8_t, 256> ds_r{};
+    std::array<uint8_t, 256> ds_g{};
+    std::array<uint8_t, 256> ds_b{};
+    DosColorLuts() {
+        for (int c = 0; c < 256; ++c) {
+            const float x = c / 255.0f;
+            const float yv = x * x * (3.0f - 2.0f * x);
+            vivid[static_cast<size_t>(c)] = static_cast<uint8_t>(
+                clamp255(static_cast<int>(std::lround((0.68f * x + 0.32f * yv) * 255.0f))));
+            const float dl = std::pow(x, 1.12f);
+            ds_r[static_cast<size_t>(c)] = static_cast<uint8_t>(
+                clamp255(static_cast<int>(std::lround(dl * 0.99f * 255.0f))));
+            ds_g[static_cast<size_t>(c)] = static_cast<uint8_t>(
+                clamp255(static_cast<int>(std::lround(dl * 0.98f * 255.0f))));
+            ds_b[static_cast<size_t>(c)] = static_cast<uint8_t>(
+                clamp255(static_cast<int>(std::lround(dl * 0.95f * 255.0f))));
+        }
+    }
+};
+
+inline const DosColorLuts& color_luts() {
+    static const DosColorLuts kLuts{};
+    return kLuts;
+}
+
+inline uint32_t apply_color_pixel(uint32_t argb, DosColorMode mode, const DosColorLuts& luts) {
+    if (mode == DosColorMode::Native) return argb;
+    const size_t r = (argb >> 16) & 255u;
+    const size_t g = (argb >> 8) & 255u;
+    const size_t b = argb & 255u;
+    if (mode == DosColorMode::VividHd) {
+        const int cr = luts.vivid[r];
+        const int cg = luts.vivid[g];
+        const int cb = luts.vivid[b];
+        const int luma = (77 * cr + 150 * cg + 29 * cb) >> 8;
+        return pack_argb(luma + (((cr - luma) * 294) >> 8),
+                         luma + (((cg - luma) * 294) >> 8),
+                         luma + (((cb - luma) * 294) >> 8));
+    }
+    const int lr = luts.ds_r[r];
+    const int lg = luts.ds_g[g];
+    const int lb = luts.ds_b[b];
+    const int luma = (77 * lr + 150 * lg + 29 * lb) >> 8;
+    return pack_argb(luma + (((lr - luma) * 232) >> 8),
+                     luma + (((lg - luma) * 232) >> 8),
+                     luma + (((lb - luma) * 232) >> 8));
+}
+
+inline int xbr_df(uint32_t a, uint32_t b) {
+    if (a == b) return 0;
+    const int dr = static_cast<int>((a >> 16) & 255u) - static_cast<int>((b >> 16) & 255u);
+    const int dg = static_cast<int>((a >> 8) & 255u) - static_cast<int>((b >> 8) & 255u);
+    const int db = static_cast<int>(a & 255u) - static_cast<int>(b & 255u);
+    const int dy = std::abs(299 * dr + 587 * dg + 114 * db) >> 10;
+    const int du = std::abs(-169 * dr - 331 * dg + 500 * db) >> 10;
+    const int dv = std::abs(500 * dr - 419 * dg - 81 * db) >> 10;
+    return 48 * dy + 7 * du + 6 * dv;
+}
+
+inline uint32_t mix_half(uint32_t a, uint32_t b) {
+    return (((a ^ b) & 0x00FEFEFEu) >> 1) + (a & b) | 0xFF000000u;
+}
+
+inline uint32_t mix_3_1(uint32_t a, uint32_t b) {
+    return mix_half(a, mix_half(a, b));
+}
+
+inline uint32_t xbr_corner_cached(uint32_t e, uint32_t b, uint32_t c, uint32_t d,
+                                  uint32_t f, uint32_t g, uint32_t h, uint32_t i,
+                                  uint32_t h5, uint32_t f4, uint32_t i4, uint32_t i5,
+                                  int df_ec, int df_eg, int df_hf,
+                                  int df_ef, int df_eh) {
+    if (e == h || e == f) return e;
+    const int ed_e = df_ec + df_eg + xbr_df(i, h5) + xbr_df(i, f4) + 4 * df_hf;
+    const int ed_i = xbr_df(h, d) + xbr_df(h, i5) + xbr_df(f, i4) + xbr_df(f, b) + 4 * xbr_df(e, i);
+    if (ed_e >= ed_i) return e;
+    const uint32_t px = (df_ef <= df_eh) ? f : h;
+    const bool strong_diag = (e != g && e != c) || (f != b && f != c) ||
+                             (h != d && h != g) || (df_hf < 700);
+    return strong_diag ? mix_half(e, px) : mix_3_1(e, px);
+}
+
+inline uint32_t xbr_corner(uint32_t e, uint32_t b, uint32_t c, uint32_t d,
+                           uint32_t f, uint32_t g, uint32_t h, uint32_t i,
+                           uint32_t h5, uint32_t f4, uint32_t i4, uint32_t i5) {
+    if (e == h || e == f) return e;
+    return xbr_corner_cached(e, b, c, d, f, g, h, i, h5, f4, i4, i5,
+                             xbr_df(e, c), xbr_df(e, g), xbr_df(h, f),
+                             xbr_df(e, f), xbr_df(e, h));
+}
+
+void upscale_sharp_bilinear_2x(const uint32_t* src, int w, int h, uint32_t* dst) {
+    const int out_w = w * 2;
+    for (int y = 0; y < h; ++y) {
+        const uint32_t* srow = src + y * w;
+        uint32_t* drow0 = dst + (y * 2) * out_w;
+        uint32_t* drow1 = drow0 + out_w;
+        for (int x = 0; x < w; ++x) {
+            const uint32_t c = srow[x];
+            drow0[x * 2] = c;
+            drow0[x * 2 + 1] = c;
+            drow1[x * 2] = c;
+            drow1[x * 2 + 1] = c;
+        }
+    }
+}
+
+void upscale_scale2x(const uint32_t* src, int w, int h, uint32_t* dst) {
+    const int out_w = w * 2;
+    const auto at = [&](int x, int y) -> uint32_t {
+        const int cx = std::clamp(x, 0, w - 1);
+        const int cy = std::clamp(y, 0, h - 1);
+        return src[cy * w + cx];
+    };
+    for (int y = 0; y < h; ++y) {
+        uint32_t* d0 = dst + (y * 2) * out_w;
+        uint32_t* d1 = d0 + out_w;
+        for (int x = 0; x < w; ++x) {
+            const uint32_t p = at(x, y);
+            const uint32_t b = at(x, y - 1);
+            const uint32_t h_px = at(x, y + 1);
+            const uint32_t d = at(x - 1, y);
+            const uint32_t f = at(x + 1, y);
+            if (b != h_px && d != f) {
+                d0[x * 2] = (d == b) ? d : p;
+                d0[x * 2 + 1] = (b == f) ? f : p;
+                d1[x * 2] = (d == h_px) ? d : p;
+                d1[x * 2 + 1] = (h_px == f) ? f : p;
+            } else {
+                d0[x * 2] = p;
+                d0[x * 2 + 1] = p;
+                d1[x * 2] = p;
+                d1[x * 2 + 1] = p;
+            }
+        }
+    }
+}
+
+void upscale_xbr2x(const uint32_t* src, int w, int h, uint32_t* dst) {
+    const int out_w = w * 2;
+    const auto at = [&](int x, int y) -> uint32_t {
+        const int cx = std::clamp(x, 0, w - 1);
+        const int cy = std::clamp(y, 0, h - 1);
+        return src[cy * w + cx];
+    };
+    const auto emit_safe = [&](int x, int y, uint32_t* d0, uint32_t* d1) {
+        const uint32_t e = at(x, y);
+        const uint32_t b = at(x, y - 1);
+        const uint32_t h_px = at(x, y + 1);
+        const uint32_t d = at(x - 1, y);
+        const uint32_t f = at(x + 1, y);
+        if (b == e && h_px == e && d == e && f == e) {
+            d0[x * 2] = e;
+            d0[x * 2 + 1] = e;
+            d1[x * 2] = e;
+            d1[x * 2 + 1] = e;
+            return;
+        }
+        auto corner = [&](int rx, int ry, int dx, int dy) -> uint32_t {
+            const auto rel = [&](int u, int v) -> uint32_t {
+                return at(x + u * rx + v * dx, y + u * ry + v * dy);
+            };
+            return xbr_corner(e, rel(0, -1), rel(1, -1), rel(-1, 0),
+                              rel(1, 0), rel(-1, 1), rel(0, 1), rel(1, 1),
+                              rel(0, 2), rel(2, 0), rel(2, 1), rel(1, 2));
+        };
+        d0[x * 2]     = corner(-1, 0, 0, -1);
+        d0[x * 2 + 1] = corner(0, -1, 1, 0);
+        d1[x * 2]     = corner(0, 1, -1, 0);
+        d1[x * 2 + 1] = corner(1, 0, 0, 1);
+    };
+    for (int y = 0; y < h; ++y) {
+        uint32_t* d0 = dst + (y * 2) * out_w;
+        uint32_t* d1 = d0 + out_w;
+        if (y < 2 || y >= h - 2 || w < 5) {
+            for (int x = 0; x < w; ++x) emit_safe(x, y, d0, d1);
+            continue;
+        }
+        for (int x = 0; x < 2; ++x) emit_safe(x, y, d0, d1);
+        const uint32_t* rm2 = src + (y - 2) * w;
+        const uint32_t* rm1 = src + (y - 1) * w;
+        const uint32_t* r0  = src + y * w;
+        const uint32_t* rp1 = src + (y + 1) * w;
+        const uint32_t* rp2 = src + (y + 2) * w;
+        for (int x = 2; x < w - 2; ++x) {
+            const uint32_t e = r0[x];
+            const uint32_t b = rm1[x];
+            const uint32_t h_px = rp1[x];
+            const uint32_t d = r0[x - 1];
+            const uint32_t f = r0[x + 1];
+            if (b == e && h_px == e && d == e && f == e) {
+                d0[x * 2] = e;
+                d0[x * 2 + 1] = e;
+                d1[x * 2] = e;
+                d1[x * 2 + 1] = e;
+                continue;
+            }
+            const uint32_t a = rm1[x - 1];
+            const uint32_t c = rm1[x + 1];
+            const uint32_t g = rp1[x - 1];
+            const uint32_t i = rp1[x + 1];
+            const int df_ec = xbr_df(e, c);
+            const int df_eg = xbr_df(e, g);
+            const int df_ea = xbr_df(e, a);
+            const int df_ei = xbr_df(e, i);
+            const int df_eb = xbr_df(e, b);
+            const int df_eh = xbr_df(e, h_px);
+            const int df_ed = xbr_df(e, d);
+            const int df_ef = xbr_df(e, f);
+            const int df_bd = xbr_df(b, d);
+            const int df_bf = xbr_df(b, f);
+            const int df_hd = xbr_df(h_px, d);
+            const int df_hf = xbr_df(h_px, f);
+            d0[x * 2]     = xbr_corner_cached(e, h_px, g, f, d, c, b, a, rm2[x], r0[x - 2], rm1[x - 2], rm2[x - 1], df_eg, df_ec, df_bd, df_ed, df_eb);
+            d0[x * 2 + 1] = xbr_corner_cached(e, d, a, h_px, b, i, f, c, r0[x + 2], rm2[x], rm2[x + 1], rm1[x + 2], df_ea, df_ei, df_bf, df_eb, df_ef);
+            d1[x * 2]     = xbr_corner_cached(e, f, i, b, h_px, a, d, g, r0[x - 2], rp2[x], rp2[x - 1], rp1[x - 2], df_ei, df_ea, df_hd, df_eh, df_ed);
+            d1[x * 2 + 1] = xbr_corner_cached(e, b, c, d, f, g, h_px, i, rp2[x], r0[x + 2], rp1[x + 2], rp2[x + 1], df_ec, df_eg, df_hf, df_ef, df_eh);
+        }
+        for (int x = w - 2; x < w; ++x) emit_safe(x, y, d0, d1);
+    }
+}
+
+void apply_sharpen(const uint32_t* src, int w, int h, DosSharpenMode mode, uint32_t* dst) {
+    const int strength_q8 = (mode == DosSharpenMode::Strong) ? 144 : 68;
+    for (int y = 0; y < h; ++y) {
+        const int ym = std::max(y - 1, 0);
+        const int yp = std::min(y + 1, h - 1);
+        const uint32_t* r_prev = src + ym * w;
+        const uint32_t* r_curr = src + y * w;
+        const uint32_t* r_next = src + yp * w;
+        uint32_t* out = dst + y * w;
+        for (int x = 0; x < w; ++x) {
+            const int xm = std::max(x - 1, 0);
+            const int xp = std::min(x + 1, w - 1);
+            const uint32_t c = r_curr[x];
+            const uint32_t n0 = r_prev[x];
+            const uint32_t n1 = r_next[x];
+            const uint32_t n2 = r_curr[xm];
+            const uint32_t n3 = r_curr[xp];
+            if (c == n0 && c == n1 && c == n2 && c == n3) {
+                out[x] = c;
+                continue;
+            }
+            const int cr = static_cast<int>((c >> 16) & 255u);
+            const int cg = static_cast<int>((c >> 8) & 255u);
+            const int cb = static_cast<int>(c & 255u);
+            const int ar = (static_cast<int>((n0 >> 16) & 255u) + static_cast<int>((n1 >> 16) & 255u) +
+                            static_cast<int>((n2 >> 16) & 255u) + static_cast<int>((n3 >> 16) & 255u)) >> 2;
+            const int ag = (static_cast<int>((n0 >> 8) & 255u) + static_cast<int>((n1 >> 8) & 255u) +
+                            static_cast<int>((n2 >> 8) & 255u) + static_cast<int>((n3 >> 8) & 255u)) >> 2;
+            const int ab = (static_cast<int>(n0 & 255u) + static_cast<int>(n1 & 255u) +
+                            static_cast<int>(n2 & 255u) + static_cast<int>(n3 & 255u)) >> 2;
+            out[x] = pack_argb(cr + (((cr - ar) * strength_q8) >> 8),
+                               cg + (((cg - ag) * strength_q8) >> 8),
+                               cb + (((cb - ab) * strength_q8) >> 8));
+        }
+    }
+}
+
+void apply_post_fx(uint32_t* pixels, int w, int h, DosPostFx fx) {
+    if (fx == DosPostFx::Off) return;
+    for (int y = 0; y < h; ++y) {
+        uint32_t* row = pixels + y * w;
+        const bool odd_row = (y & 1) != 0;
+        if (fx == DosPostFx::ScanlinesLight) {
+            if (!odd_row) continue;
+            for (int x = 0; x < w; ++x) {
+                const uint32_t c = row[x];
+                const int r = (static_cast<int>((c >> 16) & 255u) * 210) >> 8;
+                const int g = (static_cast<int>((c >> 8) & 255u) * 210) >> 8;
+                const int b = (static_cast<int>(c & 255u) * 210) >> 8;
+                row[x] = pack_argb(r, g, b);
+            }
+        } else if (fx == DosPostFx::Crt) {
+            const int row_mul = odd_row ? 186 : 256;
+            for (int x = 0; x < w; ++x) {
+                const uint32_t c = row[x];
+                const int phase = x % 3;
+                const int mr = (phase == 0) ? 256 : 232;
+                const int mg = (phase == 1) ? 256 : 232;
+                const int mb = (phase == 2) ? 256 : 232;
+                const int r = (static_cast<int>((c >> 16) & 255u) * row_mul * mr) >> 16;
+                const int g = (static_cast<int>((c >> 8) & 255u) * row_mul * mg) >> 16;
+                const int b = (static_cast<int>(c & 255u) * row_mul * mb) >> 16;
+                row[x] = pack_argb(r, g, b);
+            }
+        } else if (fx == DosPostFx::LcdGrid) {
+            const int ym = odd_row ? 216 : 252;
+            for (int x = 0; x < w; ++x) {
+                const uint32_t c = row[x];
+                const int mul = ((x & 1) ? 222 : 252) * ym;
+                const int r = (static_cast<int>((c >> 16) & 255u) * mul) >> 16;
+                const int g = (static_cast<int>((c >> 8) & 255u) * mul) >> 16;
+                const int b = (static_cast<int>(c & 255u) * mul) >> 16;
+                row[x] = pack_argb(r, g, b);
+            }
+        }
+    }
+}
