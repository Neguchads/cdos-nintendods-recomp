+void mark_dirty(DosImGuiMenuContext& ctx, bool presentation) {
+    if (ctx.settings_dirty) *ctx.settings_dirty = true;
+    if (presentation && ctx.presentation_dirty) *ctx.presentation_dirty = true;
+}
