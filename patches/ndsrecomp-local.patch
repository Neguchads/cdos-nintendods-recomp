+SDL_DisplayID resolve_display_id(int8_t display_index) {
+    int count = 0;
+    SDL_DisplayID* displays = SDL_GetDisplays(&count);
+    SDL_DisplayID target = 0;
+    if (displays && count > 0) {
+        if (display_index >= 0 && display_index < count) {
+            target = displays[display_index];
+        } else {
+            target = SDL_GetPrimaryDisplay();
+            if (!target) target = displays[0];
+        }
+    }
+    if (displays) SDL_free(displays);
+    return target;
+}
