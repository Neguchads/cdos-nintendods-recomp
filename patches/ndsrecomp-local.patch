+const std::array<DosBgmTrackInfo, kDosBgmTrackCount>& dos_bgm_track_catalog() {
+    return kBgmCatalog;
+}
+
+int dos_bgm_identify_sseq_prefix(const uint8_t data16[16]) {
+    if (!data16) return -1;
+    for (const auto& info : kBgmCatalog) {
+        if (std::memcmp(data16, info.data16.data(), 16) == 0) {
+            return static_cast<int>(info.id);
+        }
+    }
+    return -1;
+}
+
+int dos_bgm_find_track_by_key(const std::string& raw_key) {
+    const std::string lc = lower_ascii(raw_key);
+    if (lc.empty()) return -1;
+    const std::string stripped = trim_underscores(lc);
+
+    // 1. Numero exato ou prefixo "11_..." / "11-..."
+    if (std::isdigit(static_cast<unsigned char>(lc[0]))) {
+        size_t p = 0;
+        while (p < lc.size() && std::isdigit(static_cast<unsigned char>(lc[p]))) ++p;
+        if (p == lc.size() || lc[p] == '_' || lc[p] == '-' || lc[p] == ' ') {
+            const int n = std::atoi(lc.substr(0, p).c_str());
+            if (n >= 0 && n < static_cast<int>(kDosBgmTrackCount)) return n;
+        }
+    }
+
+    // 2. Nome SDAT (com ou sem underscore final) ou slug amigavel
+    for (const auto& info : kBgmCatalog) {
+        const std::string sdat_lc = lower_ascii(info.sdat_name);
+        if (lc == sdat_lc || stripped == trim_underscores(sdat_lc)) {
+            return static_cast<int>(info.id);
+        }
+        if (lc == info.slug || stripped == info.slug) {
+            return static_cast<int>(info.id);
+        }
+    }
+    return -1;
+}
+
+bool dos_custom_music_decode_file(const std::string& path,
+                                  DosDecodedAudio* out,
+                                  std::string* error_out) {
+    if (!out) return false;
+    *out = DosDecodedAudio{};
+    std::ifstream in(path, std::ios::binary);
+    if (!in) {
+        if (error_out) *error_out = "Unable to open audio file.";
+        return false;
+    }
+    in.seekg(0, std::ios::end);
+    const std::streamoff sz = in.tellg();
+    if (sz <= 0 || sz > 128 * 1024 * 1024) {
+        if (error_out) *error_out = "Audio file is empty or exceeds 128 MiB limit.";
+        return false;
+    }
+    in.seekg(0, std::ios::beg);
+    std::vector<uint8_t> raw(static_cast<size_t>(sz));
+    in.read(reinterpret_cast<char*>(raw.data()), sz);
+    if (!in) {
+        if (error_out) *error_out = "Failed to read audio file.";
+        return false;
+    }
+
+    const std::string ext = lower_ascii(fs::path(path).extension().string());
+    if (ext == ".wav" || (raw.size() >= 12 && std::memcmp(raw.data(), "RIFF", 4) == 0)) {
+        return decode_wav_bytes(raw, out, error_out);
+    }
+    if (ext == ".ogg" || (raw.size() >= 4 && std::memcmp(raw.data(), "OggS", 4) == 0)) {
+        return decode_ogg_bytes(raw, out, error_out);
+    }
+    if (ext == ".mp3") {
+        return decode_mp3_bytes(raw, out, error_out);
+    }
+    if (error_out) *error_out = "Unsupported audio format (expected .wav, .mp3, or .ogg).";
+    return false;
+}
