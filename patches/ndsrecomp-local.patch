+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+
+#include "dos_enhancements.h"
+
+struct SDL_Renderer;
+struct SDL_GPUDevice;
+struct SDL_GPUShader;
+struct SDL_GPURenderState;
+
+/**
+ * Returns precompiled signed DXIL (ps_6_0) fragment bytecode embedded from
+ * src/dos_postprocess.frag.hlsl for DirectX 12 GPU post-processing.
+ */
+bool dos_gpu_postprocess_dxil_bytecode(const uint8_t** data_out,
+                                       size_t* size_out);
+
+/**
+ * Returns precompiled SPIR-V (Vulkan 1.1) fragment bytecode embedded from
+ * src/dos_postprocess.frag.hlsl for Vulkan (Windows, Linux, Android).
+ */
+bool dos_gpu_postprocess_spirv_bytecode(const uint8_t** data_out,
+                                        size_t* size_out);
+
+/**
+ * Owns the SDL3 SDL_GPURenderState instances and DXIL/SPIR-V fragment shader
+ * used to run all 2D HD filtering and image controls on the GPU.
+ */
+struct DosGpuShaderState {
+    SDL_GPUDevice* device = nullptr;
+    SDL_GPUShader* fragment_shader = nullptr;
+    SDL_GPURenderState* render_states[2]{nullptr, nullptr};
+    int tex_w = 0;
+    int tex_h = 0;
+    std::string active_format_name;
+
+    bool init(SDL_Renderer* renderer, std::string* error_out = nullptr);
+    void bind(SDL_Renderer* renderer, int slot, int src_w, int src_h,
+              DosHdFilter filter, DosColorMode color,
+              DosSharpenMode sharpen, DosPostFx post_fx,
+              uint8_t brightness_pct = 100, uint8_t contrast_pct = 100,
+              uint8_t saturation_pct = 100, uint8_t vignette_pct = 0);
+    void unbind(SDL_Renderer* renderer);
+    void shutdown();
+};
