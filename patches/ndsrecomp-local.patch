+        presentation.force_upload[1] = true;
+        presentation.frame_proc[0].invalidate_cache();
+        presentation.frame_proc[1].invalidate_cache();
+    }
+    sync_touch_geometry(presentation, touch_placement, bottom_touch_rect,
+                        bottom_logical_width, bottom_content_left,
+                        top_content_left, stacked_top_screen,
+                        stacked_bottom_touch);
 }
 
