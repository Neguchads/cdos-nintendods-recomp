+        !require(options.dos.sharpen == DosSharpenMode::Strong) ||
+        !require(options.dos.dev_hud) ||
+        !require(options.dos.pip_opacity_pct == 80) ||
+        !require(options.dos.audio_enabled &&
+                 options.dos.audio_mode == DosAudioMode::WarmStereoHd &&
+                 options.dos.audio_volume == 120) ||
+        !require(options.keyboard_bindings[5] == 44) ||
+        !require(options.dos.secondary_keyboard_bindings[5] == 44) ||
+        !require(options.custom_gamepad_bindings &&
+                 options.gamepad_bindings[5] == 1)) {
+        return 158;
+    }
+    std::filesystem::remove(path);
     return 0;
 }
