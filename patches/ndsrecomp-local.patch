+std::string lower_ascii(const std::string& s) {
+    std::string out;
+    out.reserve(s.size());
+    for (unsigned char c : s) out.push_back(static_cast<char>(std::tolower(c)));
+    return out;
+}
+
+std::string trim_underscores(const std::string& s) {
+    size_t a = 0;
+    size_t b = s.size();
+    while (a < b && s[a] == '_') ++a;
+    while (b > a && s[b - 1] == '_') --b;
+    return s.substr(a, b - a);
+}
+
+bool is_safe_rel_music_path(const std::string& rel) {
+    if (rel.empty() || rel.size() > 200) return false;
+    if (rel[0] == '/' || rel[0] == '\\') return false;
+    if (rel.find("..") != std::string::npos) return false;
+    if (rel.find(':') != std::string::npos) return false;
+    return true;
+}
+
+bool has_supported_audio_ext(const std::string& path) {
+    const std::string ext = lower_ascii(fs::path(path).extension().string());
+    return ext == ".wav" || ext == ".mp3" || ext == ".ogg";
+}
+
+uint16_t rd_u16(const uint8_t* p) {
+    return static_cast<uint16_t>(p[0]) | (static_cast<uint16_t>(p[1]) << 8);
+}
+
+uint32_t rd_u32(const uint8_t* p) {
+    return static_cast<uint32_t>(p[0]) | (static_cast<uint32_t>(p[1]) << 8) |
+           (static_cast<uint32_t>(p[2]) << 16) | (static_cast<uint32_t>(p[3]) << 24);
+}
+
+void wr_u32(uint8_t* p, uint32_t v) {
+    p[0] = static_cast<uint8_t>(v & 0xFFu);
+    p[1] = static_cast<uint8_t>((v >> 8) & 0xFFu);
+    p[2] = static_cast<uint8_t>((v >> 16) & 0xFFu);
+    p[3] = static_cast<uint8_t>((v >> 24) & 0xFFu);
+}
+
+int16_t clamp_s16(int32_t v) {
+    if (v > 32767) return 32767;
+    if (v < -32768) return -32768;
+    return static_cast<int16_t>(v);
+}
+
+int16_t float_to_s16(float f) {
+    const float clamped = std::clamp(f, -1.0f, 1.0f);
+    return clamp_s16(static_cast<int32_t>(std::lrintf(clamped * 32767.0f)));
+}
+
+constexpr uint32_t kMinAudioSampleRate = 4000u;
+constexpr uint32_t kMaxAudioSampleRate = 384000u;
+constexpr uint32_t kMaxAudioChannels = 8u;
+// Limite defensivo: ~30 min em 32768 Hz estereo (~235 MB no pior caso), evitando OOM em arquivos malformados.
+constexpr size_t kMaxDecodedFrames32k = static_cast<size_t>(kDosSpuSampleRate) * 60u * 30u;
+
+void resample_to_32768_stereo(const float* src,
+                              size_t src_frames,
+                              uint32_t src_channels,
+                              uint32_t src_rate,
+                              size_t src_loop_start,
+                              size_t src_loop_end,
+                              DosDecodedAudio* out) {
+    out->pcm_stereo_32768.clear();
+    out->loop_start_frame = 0;
+    out->loop_end_frame = 0;
+    if (!src || src_frames == 0 ||
+        src_channels == 0 || src_channels > kMaxAudioChannels ||
+        src_rate < kMinAudioSampleRate || src_rate > kMaxAudioSampleRate) {
+        return;
+    }
+
+    const double ratio = static_cast<double>(src_rate) / static_cast<double>(kDosSpuSampleRate);
+    const double dst_frames_d = static_cast<double>(src_frames) / ratio;
+    if (!std::isfinite(dst_frames_d) || dst_frames_d <= 0.0 ||
+        dst_frames_d > static_cast<double>(kMaxDecodedFrames32k)) {
+        return;
+    }
+    const size_t dst_frames = std::max<size_t>(
+        1u, static_cast<size_t>(std::llround(dst_frames_d)));
+    out->pcm_stereo_32768.resize(dst_frames * 2u);
+
+    auto sample_lr = [&](size_t f, float* l, float* r) {
+        const size_t idx = std::min(f, src_frames - 1u) * src_channels;
+        if (src_channels == 1u) {
+            *l = src[idx];
+            *r = src[idx];
+        } else {
+            *l = src[idx];
+            *r = src[idx + 1u];
+        }
+    };
+
+    for (size_t i = 0; i < dst_frames; ++i) {
+        const double pos = static_cast<double>(i) * ratio;
+        const size_t i0 = static_cast<size_t>(pos);
+        const size_t i1 = std::min(i0 + 1u, src_frames - 1u);
+        const float frac = static_cast<float>(pos - static_cast<double>(i0));
+        float l0 = 0.0f, r0 = 0.0f, l1 = 0.0f, r1 = 0.0f;
+        sample_lr(i0, &l0, &r0);
+        sample_lr(i1, &l1, &r1);
+        out->pcm_stereo_32768[i * 2u] = float_to_s16(l0 + (l1 - l0) * frac);
+        out->pcm_stereo_32768[i * 2u + 1u] = float_to_s16(r0 + (r1 - r0) * frac);
+    }
+
+    if (src_loop_end > src_loop_start && src_loop_end <= src_frames) {
+        out->loop_start_frame = static_cast<size_t>(std::llround(static_cast<double>(src_loop_start) / ratio));
+        out->loop_end_frame = std::min(
+            dst_frames, static_cast<size_t>(std::llround(static_cast<double>(src_loop_end) / ratio)));
+        if (out->loop_end_frame <= out->loop_start_frame) {
+            out->loop_start_frame = 0;
+            out->loop_end_frame = 0;
+        }
+    }
+}
+
+bool decode_wav_bytes(const std::vector<uint8_t>& raw, DosDecodedAudio* out, std::string* err) {
+    if (raw.size() < 44 || std::memcmp(raw.data(), "RIFF", 4) != 0 ||
+        std::memcmp(raw.data() + 8, "WAVE", 4) != 0) {
+        if (err) *err = "Invalid RIFF/WAVE header.";
+        return false;
+    }
+    uint16_t audio_fmt = 0;
+    uint16_t channels = 0;
+    uint32_t sample_rate = 0;
+    uint16_t bits_per_sample = 0;
+    bool have_fmt = false;
+    const uint8_t* data_ptr = nullptr;
+    size_t data_size = 0;
+    size_t smpl_loop_start = 0;
+    size_t smpl_loop_end = 0;
+
+    size_t pos = 12;
+    while (pos + 8 <= raw.size()) {
+        const uint8_t* ch = raw.data() + pos;
+        const uint32_t csize = rd_u32(ch + 4);
+        const size_t body = pos + 8;
+        if (body > raw.size()) break;
+        const size_t avail = std::min<size_t>(csize, raw.size() - body);
+
+        if (std::memcmp(ch, "fmt ", 4) == 0 && avail >= 16) {
+            audio_fmt = rd_u16(raw.data() + body);
+            channels = rd_u16(raw.data() + body + 2);
+            sample_rate = rd_u32(raw.data() + body + 4);
+            bits_per_sample = rd_u16(raw.data() + body + 14);
+            if (audio_fmt == 0xFFFEu && avail >= 40) {
+                audio_fmt = rd_u16(raw.data() + body + 24);
+            }
+            have_fmt = true;
+        } else if (std::memcmp(ch, "data", 4) == 0) {
+            data_ptr = raw.data() + body;
+            data_size = avail;
+        } else if (std::memcmp(ch, "smpl", 4) == 0 && avail >= 60) {
+            const uint32_t num_loops = rd_u32(raw.data() + body + 28);
+            if (num_loops >= 1u) {
+                smpl_loop_start = rd_u32(raw.data() + body + 44);
+                smpl_loop_end = rd_u32(raw.data() + body + 48);
+            }
+        }
+        if (csize > raw.size() - body) break;
+        const size_t pad = csize & 1u;
+        if (pad > raw.size() - body - csize) break;
+        pos = body + csize + pad;
+    }
+
+    if (!have_fmt || !data_ptr || data_size == 0 ||
+        channels == 0 || channels > kMaxAudioChannels ||
+        sample_rate < kMinAudioSampleRate || sample_rate > kMaxAudioSampleRate) {
+        if (err) *err = "WAV missing valid fmt/data chunk or unsupported rate/channels.";
+        return false;
+    }
+    if (!((audio_fmt == 1u && (bits_per_sample == 8u || bits_per_sample == 16u ||
+                               bits_per_sample == 24u || bits_per_sample == 32u)) ||
+          (audio_fmt == 3u && bits_per_sample == 32u))) {
+        if (err) *err = "Unsupported WAV format (expected PCM 8/16/24/32-bit or IEEE Float32).";
+        return false;
+    }
+
+    const size_t bps_bytes = bits_per_sample / 8u;
+    const size_t frame_bytes = bps_bytes * channels;
+    const size_t frames = data_size / frame_bytes;
+    if (frames == 0) {
+        if (err) *err = "WAV contains 0 audio frames.";
+        return false;
+    }
+
+    std::vector<float> flt(frames * channels);
+    for (size_t i = 0; i < frames * channels; ++i) {
+        const uint8_t* s = data_ptr + i * bps_bytes;
+        if (audio_fmt == 3u) {
+            float v = 0.0f;
+            std::memcpy(&v, s, 4);
+            flt[i] = std::isfinite(v) ? std::clamp(v, -1.0f, 1.0f) : 0.0f;
+        } else if (bits_per_sample == 8u) {
+            flt[i] = (static_cast<int>(s[0]) - 128) / 128.0f;
+        } else if (bits_per_sample == 16u) {
+            const int16_t v = static_cast<int16_t>(rd_u16(s));
+            flt[i] = static_cast<float>(v) / 32768.0f;
+        } else if (bits_per_sample == 24u) {
+            int32_t v = static_cast<int32_t>(s[0]) | (static_cast<int32_t>(s[1]) << 8) |
+                        (static_cast<int32_t>(s[2]) << 16);
+            if (v & 0x00800000) v |= 0xFF000000;
+            flt[i] = static_cast<float>(v) / 8388608.0f;
+        } else {
+            const int32_t v = static_cast<int32_t>(rd_u32(s));
+            flt[i] = static_cast<float>(v) / 2147483648.0f;
+        }
+    }
+    resample_to_32768_stereo(flt.data(), frames, channels, sample_rate,
+                             smpl_loop_start, smpl_loop_end, out);
+    return !out->pcm_stereo_32768.empty();
+}
+
+bool decode_mp3_bytes(const std::vector<uint8_t>& raw, DosDecodedAudio* out, std::string* err) {
+    drmp3_config cfg{};
+    drmp3_uint64 frame_count = 0;
+    float* pcm = drmp3_open_memory_and_read_pcm_frames_f32(
+        raw.data(), raw.size(), &cfg, &frame_count, nullptr);
+    if (!pcm || frame_count == 0 || cfg.channels == 0 || cfg.sampleRate == 0) {
+        if (pcm) drmp3_free(pcm, nullptr);
+        if (err) *err = "Failed to decode MP3 file.";
+        return false;
+    }
+    resample_to_32768_stereo(pcm, static_cast<size_t>(frame_count),
+                             cfg.channels, cfg.sampleRate, 0, 0, out);
+    drmp3_free(pcm, nullptr);
+    return !out->pcm_stereo_32768.empty();
+}
+
+bool decode_ogg_bytes(const std::vector<uint8_t>& raw, DosDecodedAudio* out, std::string* err) {
+    int channels = 0;
+    int sample_rate = 0;
+    short* pcm16 = nullptr;
+    const int frames = stb_vorbis_decode_memory(
+        raw.data(), static_cast<int>(raw.size()), &channels, &sample_rate, &pcm16);
+    if (frames <= 0 || !pcm16 || channels <= 0 || sample_rate <= 0) {
+        if (pcm16) std::free(pcm16);
+        if (err) *err = "Failed to decode OGG Vorbis file.";
+        return false;
+    }
+    std::vector<float> flt(static_cast<size_t>(frames) * static_cast<size_t>(channels));
+    for (size_t i = 0; i < flt.size(); ++i) {
+        flt[i] = static_cast<float>(pcm16[i]) / 32768.0f;
+    }
+    std::free(pcm16);
+    resample_to_32768_stereo(flt.data(), static_cast<size_t>(frames),
+                             static_cast<uint32_t>(channels),
+                             static_cast<uint32_t>(sample_rate), 0, 0, out);
+    return !out->pcm_stereo_32768.empty();
+}
+
+struct JukeboxManifestConfig {
+    bool present = false;
+    bool enabled = false;
+    bool shuffle = false;
+    std::vector<std::string> playlist;
+};
+
+std::string json_escape(const std::string& s) {
+    std::string out;
+    out.reserve(s.size() + 8u);
+    for (unsigned char c : s) {
+        if (c == '\\') out += "\\\\";
+        else if (c == '"') out += "\\\"";
+        else if (c == '\n') out += "\\n";
+        else if (c == '\r') out += "\\r";
+        else if (c == '\t') out += "\\t";
+        else if (c >= 0x20u) out.push_back(static_cast<char>(c));
+    }
+    return out;
+}
+
+bool atomic_write_text_file(const fs::path& dst, const std::string& content) {
+    std::error_code ec;
+    fs::create_directories(dst.parent_path(), ec);
+    const fs::path tmp = dst.string() + ".tmp";
+    {
+        std::ofstream out(tmp, std::ios::binary | std::ios::trunc);
+        if (!out) return false;
+        out.write(content.data(), static_cast<std::streamsize>(content.size()));
+        out.flush();
+        if (!out) return false;
+    }
+#ifdef _WIN32
+    if (MoveFileExW(tmp.wstring().c_str(), dst.wstring().c_str(),
+                    MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH) != 0) {
+        return true;
+    }
+    fs::remove(tmp, ec);
+    return false;
+#else
+    fs::rename(tmp, dst, ec);
+    if (ec) {
+        fs::remove(tmp, ec);
+        return false;
+    }
+    return true;
+#endif
+}
