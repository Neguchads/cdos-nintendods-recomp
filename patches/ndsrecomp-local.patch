+void draw_tab_controls(DosImGuiMenuContext& ctx, DosLanguage lang, ImFont* heading_font,
+                       int capture_kind_int, int& capture_row_out,
+                       std::function<void(int, int)> begin_capture,
+                       DosImGuiMenu& self) {
+    NdsFrontendOptions* opt = ctx.options;
+    if (!opt) return;
+
+    begin_section(dos_tr(lang, DosStrId::SecInputPresets), heading_font);
+    if (ImGui::Button(dos_tr(lang, DosStrId::BtnPresetWasd))) {
+        dos_apply_control_preset(DosControlPreset::ModernWasd, &opt->keyboard_bindings,
+                                 &opt->dos.secondary_keyboard_bindings,
+                                 &opt->gamepad_bindings, &opt->custom_gamepad_bindings);
+        mark_dirty(ctx, false);
+        self.push_toast(dos_tr(lang, DosStrId::ToastPresetApplied));
+    }
+    ImGui::SameLine();
+    if (ImGui::Button(dos_tr(lang, DosStrId::BtnPresetArrows))) {
+        dos_apply_control_preset(DosControlPreset::ModernArrows, &opt->keyboard_bindings,
+                                 &opt->dos.secondary_keyboard_bindings,
+                                 &opt->gamepad_bindings, &opt->custom_gamepad_bindings);
+        mark_dirty(ctx, false);
+        self.push_toast(dos_tr(lang, DosStrId::ToastPresetApplied));
+    }
+    ImGui::SameLine();
+    if (ImGui::Button(dos_tr(lang, DosStrId::BtnPresetClassic))) {
+        dos_apply_control_preset(DosControlPreset::ClassicNds, &opt->keyboard_bindings,
+                                 &opt->dos.secondary_keyboard_bindings,
+                                 &opt->gamepad_bindings, &opt->custom_gamepad_bindings);
+        mark_dirty(ctx, false);
+        self.push_toast(dos_tr(lang, DosStrId::ToastPresetApplied));
+    }
+
+    if (ImGui::Button(dos_tr(lang, DosStrId::BtnRestoreDefaultControls))) {
+        dos_apply_control_preset(DosControlPreset::ModernWasd, &opt->keyboard_bindings,
+                                 &opt->dos.secondary_keyboard_bindings,
+                                 &opt->gamepad_bindings, &opt->custom_gamepad_bindings);
+        mark_dirty(ctx, false);
+        self.push_toast(dos_tr(lang, DosStrId::ToastDefaultsRestored));
+    }
+    ImGui::SameLine();
+    if (ImGui::Button(dos_tr(lang, DosStrId::BtnClearAllBinds))) {
+        dos_clear_control_bindings(&opt->keyboard_bindings,
+                                   &opt->dos.secondary_keyboard_bindings,
+                                   &opt->gamepad_bindings, &opt->custom_gamepad_bindings);
+        mark_dirty(ctx, false);
+        self.push_toast(dos_tr(lang, DosStrId::ToastControlsCleared));
+    }
+
+    static constexpr std::array<DosButtonPrompts, 5> kPrompts = {
+        DosButtonPrompts::Auto, DosButtonPrompts::Keyboard,
+        DosButtonPrompts::Xbox, DosButtonPrompts::PlayStation,
+        DosButtonPrompts::Nintendo};
+    static constexpr std::array<DosStrId, 5> kPromptNames = {
+        DosStrId::PromptAuto, DosStrId::PromptKeyboard,
+        DosStrId::PromptXbox, DosStrId::PromptPlayStation,
+        DosStrId::PromptNintendo};
+    if (combo_enum(dos_tr(lang, DosStrId::LblButtonPrompts), &opt->dos.button_prompts,
+                   kPrompts, kPromptNames, lang)) {
+        mark_dirty(ctx, false);
+    }
+
+    int dz = opt->dos.stick_deadzone_pct;
+    if (ImGui::SliderInt(dos_tr(lang, DosStrId::LblStickDeadzone), &dz, 5, 45, "%d%%")) {
+        opt->dos.stick_deadzone_pct = static_cast<uint8_t>(dz);
+        mark_dirty(ctx, false);
+    }
+
+    begin_section(dos_tr(lang, DosStrId::SecRemap), heading_font);
+    if (capture_kind_int != 0) {
+        ImGui::TextColored(ImVec4(0.98f, 0.78f, 0.25f, 1.0f), "%s",
+                           dos_tr(lang, DosStrId::PressAnyKeyPrompt));
+    }
+
+    static constexpr std::array<const char*, 12> kActionLabelsEn = {
+        "Up", "Down", "Left", "Right", "A (Special / Confirm)", "B (Jump)",
+        "X (Switch Set)", "Y (Attack)", "L (Dash)", "R (Soul Skill)", "Start", "Select"};
+    static constexpr std::array<const char*, 12> kActionLabelsPt = {
+        "Cima", "Baixo", "Esquerda", "Direita", "A (Especial / Confirmar)", "B (Pular)",
+        "X (Trocar Set)", "Y (Atacar)", "L (Dash / Esquiva)", "R (Alma / Skill)", "Start", "Select"};
+
+    if (ImGui::BeginTable("dos_binds", 4,
+                          ImGuiTableFlags_Borders | ImGuiTableFlags_RowBg |
+                              ImGuiTableFlags_SizingStretchSame)) {
+        ImGui::TableSetupColumn(dos_tr(lang, DosStrId::ColAction));
+        ImGui::TableSetupColumn(dos_tr(lang, DosStrId::ColPrimaryKey));
+        ImGui::TableSetupColumn(dos_tr(lang, DosStrId::ColSecondaryKey));
+        ImGui::TableSetupColumn(dos_tr(lang, DosStrId::ColGamepad));
+        ImGui::TableHeadersRow();
+
+        for (int row = 0; row < 12; ++row) {
+            ImGui::TableNextRow();
+            ImGui::PushID(row);
+            ImGui::TableSetColumnIndex(0);
+            ImGui::AlignTextToFramePadding();
+            ImGui::TextUnformatted(lang == DosLanguage::PtBr
+                                       ? kActionLabelsPt[static_cast<size_t>(row)]
+                                       : kActionLabelsEn[static_cast<size_t>(row)]);
+
+            const int raw_k1 = opt->keyboard_bindings[static_cast<size_t>(row)];
+            const int raw_k2 = opt->dos.secondary_keyboard_bindings[static_cast<size_t>(row)];
+            const int pad_code = opt->custom_gamepad_bindings
+                                     ? opt->gamepad_bindings[static_cast<size_t>(row)]
+                                     : kNdsDefaultPad[static_cast<size_t>(row)];
+            const std::string k1 = raw_k1 > 0 ? dos_scancode_display_name(raw_k1) : std::string();
+            const std::string k2 = raw_k2 > 0 ? dos_scancode_display_name(raw_k2) : std::string();
+            const std::string gp = pad_code > 0 ? dos_gamepad_binding_display_name(pad_code) : std::string();
+
+            auto cell_btn = [&](int kind, int raw_val, const std::string& label, const char* id_sfx) {
+                ImGui::PushID(id_sfx);
+                const bool capturing = (capture_kind_int == kind && capture_row_out == row);
+                if (capturing) {
+                    ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.80f, 0.45f, 0.12f, 1.0f));
+                }
+                const char* shown = capturing
+                                        ? "..."
+                                        : (label.empty() ? dos_tr(lang, DosStrId::LblUnbound)
+                                                         : label.c_str());
+                const float clear_w = 24.0f;
+                const float btn_w = std::max(44.0f, ImGui::GetContentRegionAvail().x - clear_w - 4.0f);
+                if (ImGui::Button(shown, ImVec2(btn_w, 0.0f))) {
+                    begin_capture(kind, row);
+                }
+                if (capturing) ImGui::PopStyleColor();
+                ImGui::SameLine(0.0f, 4.0f);
+                const bool empty_bind = (raw_val <= 0);
+                if (empty_bind) ImGui::BeginDisabled();
+                if (ImGui::Button("X##clr", ImVec2(clear_w, 0.0f))) {
+                    if (kind == 1) {
+                        opt->keyboard_bindings[static_cast<size_t>(row)] = 0;
+                    } else if (kind == 2) {
+                        opt->dos.secondary_keyboard_bindings[static_cast<size_t>(row)] = 0;
+                    } else if (kind == 3) {
+                        if (!opt->custom_gamepad_bindings) {
+                            opt->gamepad_bindings = kNdsDefaultPad;
+                            opt->custom_gamepad_bindings = true;
+                        }
+                        opt->gamepad_bindings[static_cast<size_t>(row)] = 0;
+                    }
+                    mark_dirty(ctx, false);
+                }
+                if (empty_bind) ImGui::EndDisabled();
+                ImGui::PopID();
+            };
+
+            ImGui::TableSetColumnIndex(1);
+            cell_btn(1, raw_k1, k1, "k1");
+            ImGui::TableSetColumnIndex(2);
+            cell_btn(2, raw_k2, k2, "k2");
+            ImGui::TableSetColumnIndex(3);
+            cell_btn(3, pad_code, gp, "gp");
+            ImGui::PopID();
+        }
+        ImGui::EndTable();
+    }
+}
