+void draw_tab_performance(DosImGuiMenuContext& ctx, DosLanguage lang,
+                          ImFont* heading_font, const float* fps_hist, int count,
+                          int offset, double last_emu_ms, double last_present_ms) {
+    NdsFrontendOptions* opt = ctx.options;
+    if (!opt) return;
+
+    begin_section(dos_tr(lang, DosStrId::SecLiveTelemetry), heading_font);
+    static constexpr std::array<DosHudMode, 3> kHudModes = {
+        DosHudMode::Off, DosHudMode::FpsOnly, DosHudMode::Full};
+    static constexpr std::array<DosStrId, 3> kHudNames = {
+        DosStrId::HudOff, DosStrId::HudFpsOnly, DosStrId::HudFull};
+    if (combo_enum(dos_tr(lang, DosStrId::LblHudMode), &opt->dos.hud_mode,
+                   kHudModes, kHudNames, lang)) {
+        opt->dos.dev_hud = (opt->dos.hud_mode != DosHudMode::Off);
+        mark_dirty(ctx, false);
+    }
+
+    const DosHudMetrics* hm = ctx.hud_metrics;
+    const double cur_fps = hm ? hm->fps : 0.0;
+    const double emu_ms = hm ? hm->emu_ms : last_emu_ms;
+    const double pres_ms = hm ? hm->present_ms : last_present_ms;
+    const double tier3 = hm ? hm->tier3_kips : 0.0;
+    ImGui::Text("%s: %.1f FPS    |    %s: %.2f / %.2f ms",
+                dos_tr(lang, DosStrId::MetricFps), cur_fps,
+                dos_tr(lang, DosStrId::MetricFrameTime), emu_ms, pres_ms);
+    ImGui::Text("%s: %.2f kIPS    |    %s: %s (%s)",
+                dos_tr(lang, DosStrId::MetricTier3), tier3,
+                dos_tr(lang, DosStrId::MetricShaderFmt),
+                ctx.active_driver ? ctx.active_driver : "auto",
+                ctx.active_shader_format ? ctx.active_shader_format : "none");
+
+    std::array<float, 120> ordered{};
+    const int n = std::clamp(count, 0, 120);
+    for (int i = 0; i < n; ++i) {
+        const int idx = (offset - n + i + 120) % 120;
+        ordered[static_cast<size_t>(i)] = fps_hist[idx];
+    }
+    char overlay[48]{};
+    std::snprintf(overlay, sizeof(overlay), "%.1f FPS", cur_fps);
+    ImGui::PlotLines("##fps_sparkline", ordered.data(), std::max(n, 1), 0,
+                     overlay, 0.0f, 70.0f, ImVec2(-1.0f, 92.0f));
+
+    begin_section(dos_tr(lang, DosStrId::SecContentMods), heading_font);
+    if (ImGui::Checkbox(dos_tr(lang, DosStrId::LblEnhancedIntro), &opt->dos.enhanced_intro)) {
+        mark_dirty(ctx, false);
+    }
+    ImGui::SameLine();
+    if (!ctx.intro_video_available) ImGui::BeginDisabled();
+    if (ImGui::Button(dos_tr(lang, DosStrId::BtnPlayIntroNow), ImVec2(190.0f, 0.0f))) {
+        if (ctx.play_intro_requested) *ctx.play_intro_requested = true;
+    }
+    if (!ctx.intro_video_available) ImGui::EndDisabled();
+    ImGui::TextDisabled("%s", dos_tr(lang, ctx.intro_video_available
+                                               ? DosStrId::IntroVideoReady
+                                               : DosStrId::IntroVideoMissing));
+
+    begin_section(dos_tr(lang, DosStrId::SecDiagActions), heading_font);
+    if (ImGui::Button(dos_tr(lang, DosStrId::BtnTogglePause), ImVec2(170.0f, 0.0f))) {
+        if (ctx.paused) *ctx.paused = !*ctx.paused;
+    }
+    ImGui::SameLine();
+    const bool is_paused = ctx.paused && *ctx.paused;
+    if (!is_paused) ImGui::BeginDisabled();
+    if (ImGui::Button(dos_tr(lang, DosStrId::BtnStepFrame), ImVec2(170.0f, 0.0f))) {
+        if (ctx.step_frame_requested) *ctx.step_frame_requested = true;
+    }
+    if (!is_paused) ImGui::EndDisabled();
+    ImGui::SameLine();
+    if (ImGui::Button(dos_tr(lang, DosStrId::BtnSoftReset), ImVec2(170.0f, 0.0f))) {
+        if (ctx.soft_reset_requested) *ctx.soft_reset_requested = true;
+    }
+}
