+const DosModEntry* find_entry(const std::vector<DosModEntry>& list, const std::string& id) {
+    for (const auto& e : list) {
+        if (e.id == id) return &e;
+    }
+    return nullptr;
+}
+
+bool contains_str(const std::vector<std::string>& list, const std::string& v) {
+    return std::find(list.begin(), list.end(), v) != list.end();
+}
+
+void parse_entry_list(const JsonVal* arr, const char* kind, std::vector<DosModEntry>* out) {
+    if (!arr || arr->type != JsonVal::Type::Array || !out) return;
+    out->clear();
+    for (const auto& item : arr->arr) {
+        if (item.type != JsonVal::Type::Object) continue;
+        DosModEntry e{};
+        e.id = dos_mod_sanitize_id(item.str_or("id"));
+        if (e.id.empty()) continue;
+        e.name = item.str_or("name", e.id);
+        e.version = item.str_or("version", "1.0");
+        e.kind = kind;
+        e.profile_file = item.str_or("profile_file");
+        e.author = item.str_or("author");
+        e.summary = item.str_or("summary");
+        e.source_url = item.str_or("source_url");
+        e.validation_level = item.str_or("validation_level", "none");
+        e.registry_state = item.str_or("state", "unverified");
+        e.exclusive_group = item.str_or("exclusive_group");
+        e.allowed_character_packs = item.str_list("allowed_character_packs");
+        e.compatible_campaigns = item.str_list("compatible_campaigns");
+        e.builtin = item.bool_or("builtin", false);
+        e.manual_import = item.bool_or("manual_import", false);
+        e.supports_ptbr = item.bool_or("supports_ptbr", false);
+        e.definitive_compatible = item.bool_or("definitive_compatible", false);
+        out->push_back(std::move(e));
+    }
+}
