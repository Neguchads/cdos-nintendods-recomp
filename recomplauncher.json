{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "Castlevania: Dawn of Sorrow: Recompiled",
  "repo": "Neguchads/cdos-nintendods-recomp",
  "inputs": [
    {
      "id": "game",
      "label": "Your copy of Castlevania: Dawn of Sorrow (USA, ACVE) for Nintendo DS: the 64 MiB .nds file (SHA-1 47530ff87e608f88105a314fdf36dc385f8dec94). Optional user-supplied local mods can be placed in {data}/mods/profiles/.",
      "role": "game",
      "formats": [
        {
          "type": "file",
          "extensions": [
            "nds"
          ]
        }
      ],
      "check": {
        "ids": [
          "ACVE"
        ]
      },
      "dumps": [
        {
          "name": "USA (ACVE)",
          "size": 67108864,
          "crc32": "135737f6"
        }
      ]
    }
  ],
  "start": {
    "program": [
      "runtime/nds_runner.exe",
      "runtime/nds_runner",
      "nds_runner.exe",
      "nds_runner"
    ],
    "args": [
      "{data}/run/bios",
      "--interactive",
      "--rom",
      "{input:game}",
      "--ptbr-patch",
      "{data}/mods/ptbr/dos-ptbr.dospatch",
      "--definitive-en-patch",
      "{data}/mods/definitive/dos-definitive-en.dospatch",
      "--definitive-ptbr-patch",
      "{data}/mods/definitive/dos-definitive-ptbr.dospatch",
      "--intro-video",
      "{data}/mods/intro/opening.mp4",
      "--mod-registry",
      "{install}/mods/registry.json",
      "--mod-data-dir",
      "{data}/mods",
      "--config",
      "{install}/game.toml",
      "--freebios",
      "--generated-firmware",
      "--boot",
      "direct",
      "--startup-mode",
      "automatic",
      "--diagnostics",
      "off",
      "--no-coverage-manifest",
      "--runtime-settings-path",
      "{data}/saves/dos-settings.ini",
      "--savestate-dir",
      "{data}/run/savestates",
      "--save-path",
      "{data}/saves/dos.sav",
      "--firmware-state-path",
      "{data}/run/firmware_state.bin"
    ]
  },
  "saves": [
    "{data}/saves/dos.sav",
    "{data}/saves/dos-settings.ini",
    "{data}/run/savestates",
    "{data}/saves/definitive",
    "{data}/saves/profiles"
  ],
  "folders": {
    "saves": [
      {
        "path": "{data}/saves"
      }
    ],
    "logs": [
      {
        "path": "{data}/run/logs"
      }
    ],
    "screenshots": [
      {
        "path": "{data}/screenshots"
      }
    ]
  },
  "config": [
    {
      "id": "main",
      "format": "ini",
      "file": [
        {
          "path": "{data}/saves/dos-settings.ini"
        }
      ],
      "new": {
        "dos_ui_language": "en",
        "dos_game_language": "en",
        "dos_content_profile": "original",
        "dos_enhanced_intro": "true",
        "dos_skip_launcher": "true",
        "dos_fullscreen": "borderless",
        "dos_layout": "pip",
        "dos_pip_main": "bottom",
        "dos_pip_corner": "top-right",
        "dos_pip_size": "37",
        "dos_pip_opacity": "90",
        "dos_aspect_mode": "stretch",
        "dos_widescreen_crop_y": "0",
        "dos_true_widescreen": "false",
        "dos_wide_hud_mode": "edge",
        "dos_display_index": "-1",
        "dos_window_scale": "0",
        "dos_safe_zone": "0",
        "dos_frame_interpolation": "false",
        "dos_render_driver": "direct3d12",
        "dos_vsync": "off",
        "dos_hd_filter": "pixellate",
        "dos_anti_dither": "false",
        "dos_color_mode": "vivid",
        "dos_sharpen": "off",
        "dos_post_fx": "off",
        "dos_post_fx_intensity": "100",
        "dos_crt_curvature": "0",
        "dos_antialiasing": "0",
        "dos_brightness": "100",
        "dos_contrast": "100",
        "dos_saturation": "100",
        "dos_gamma": "100",
        "dos_color_temp": "0",
        "dos_bloom": "0",
        "dos_vignette": "0",
        "dos_hud_mode": "fps",
        "dos_dev_hud": "true",
        "dos_pause_on_menu": "false",
        "dos_pause_unfocused": "false",
        "dos_audio_enabled": "true",
        "dos_audio_mode": "warm-stereo",
        "dos_audio_volume": "100",
        "dos_audio_fx": "100",
        "dos_custom_music": "true",
        "dos_custom_music_volume": "100",
        "dos_mute_unfocused": "false",
        "dos_button_prompts": "auto",
        "dos_stick_deadzone": "20"
      }
    }
  ],
  "settings": [
    {
      "id": "ui_language",
      "label": "Menu Language / Idioma do Menu",
      "group": "Language",
      "choices": [
        {
          "label": "English",
          "set": {
            "dos_ui_language": "en"
          }
        },
        {
          "label": "Portugues (BR)",
          "set": {
            "dos_ui_language": "ptbr"
          }
        }
      ],
      "defaults": {
        "dos_ui_language": "en"
      }
    },
    {
      "id": "game_language",
      "label": "Game Language (ROM) / Idioma do Jogo",
      "group": "Language",
      "help": "Applies an optional user-supplied translation patch ({data}/mods/ptbr/dos-ptbr.dospatch) in memory without modifying your original USA .nds file.",
      "choices": [
        {
          "label": "English (USA Original)",
          "set": {
            "dos_game_language": "en"
          }
        },
        {
          "label": "Portugues (BR) — User-Supplied Patch",
          "set": {
