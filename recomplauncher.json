{
  "$schema": "https://raw.githubusercontent.com/elripalda/RecompLauncher-SDK/main/schema/recomplauncher.json",
  "format": 1,
  "name": "Castlevania: Dawn of Sorrow (ACVE Static Recomp)",
  "repo": "Neguchads/cdos-nintendods-recomp",
  "game": {
    "kind": "rom",
    "label": "Castlevania: Dawn of Sorrow (USA, Rev 0 / ACVE). Supply your legally dumped 64 MiB .nds ROM (SHA-1: 47530ff87e608f88105a314fdf36dc385f8dec94). Optional PT-BR patch applied in memory.",
    "check": {
      "sha1": "47530ff87e608f88105a314fdf36dc385f8dec94"
    }
  },
  "prepare": {
    "program": [
      "runtime/nds_runner.exe",
      "runtime/nds_runner"
    ],
    "args": [
      "run/bios",
      "--interactive",
      "--rom",
      "{game}",
      "--ptbr-patch",
      "mods/ptbr/dos-ptbr.dospatch",
      "--config",
      "game.toml",
      "--freebios",
      "--generated-firmware",
      "--boot",
      "direct",
      "--startup-mode",
      "automatic",
      "--diagnostics",
      "off",
      "--no-coverage-manifest",
      "--runtime-settings-path",
      "{data}/saves/dos-settings.ini",
      "--savestate-dir",
      "{data}/run/savestates",
      "--save-path",
      "{data}/saves/dos.sav",
      "--firmware-state-path",
      "{data}/run/firmware_state.bin"
    ],
    "label": "Verify ROM & initialize runtime folders / Verificar ROM e preparar pastas",
    "timeout": 120,
    "version": "1.0.0",
    "done": [
      "runtime/nds_runner.exe",
      "mods/ptbr/dos-ptbr.dospatch",
      "game.toml"
    ]
  },
  "start": {
    "program": [
      "runtime/nds_runner.exe",
      "runtime/nds_runner"
    ],
    "args": [
      "run/bios",
      "--interactive",
      "--rom",
      "{game}",
      "--ptbr-patch",
      "mods/ptbr/dos-ptbr.dospatch",
      "--config",
      "game.toml",
      "--freebios",
      "--generated-firmware",
      "--boot",
      "direct",
      "--startup-mode",
      "automatic",
      "--diagnostics",
      "off",
      "--no-coverage-manifest",
      "--runtime-settings-path",
      "{data}/saves/dos-settings.ini",
      "--savestate-dir",
      "{data}/run/savestates",
      "--save-path",
      "{data}/saves/dos.sav",
      "--firmware-state-path",
      "{data}/run/firmware_state.bin"
    ]
  },
  "saves": [
    "{data}/saves/dos.sav",
    "{data}/saves/dos-settings.ini",
    "{data}/run/savestates"
  ],
  "folders": {
    "logs": [
      {
        "path": "{data}/run/logs"
      }
    ],
    "screenshots": [
      {
        "path": "{data}/screenshots"
      }
    ]
  },
  "config": [
    {
      "id": "main",
      "format": "ini",
      "file": [
        {
          "path": "{data}/saves/dos-settings.ini"
        }
      ]
    }
  ],
  "settings": [
    {
      "id": "ui_language",
      "label": "Menu Language / Idioma do Menu",
      "group": "Language",
      "choices": [
        {
          "label": "Portugues (BR)",
          "set": {
            "dos_ui_language": "ptbr"
          }
        },
        {
          "label": "English",
          "set": {
            "dos_ui_language": "en"
          }
        }
      ],
      "defaults": {
        "dos_ui_language": "ptbr"
      }
    },
    {
      "id": "game_language",
      "label": "Game Language (ROM) / Idioma do Jogo",
      "group": "Language",
      "help": "Uses dos-ptbr.dospatch in memory without modifying your original USA .nds file.",
      "choices": [
        {
          "label": "Portugues (BR) — romsportugues.com T1.0",
          "set": {
            "dos_game_language": "ptbr"
          }
        },
        {
          "label": "English (USA Original)",
          "set": {
            "dos_game_language": "en"
          }
        }
