      "defaults": {
        "dos_game_language": "en"
      }
    },
    {
      "id": "content_profile",
      "label": "Content Profile / Perfil de Conteudo",
      "group": "Content & Mods",
      "help": "Original USA is the clean default. Optional user-supplied baseline patches placed in {data}/mods/definitive/ can be enabled in memory without modifying your ROM.",
