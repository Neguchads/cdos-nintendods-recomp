#include <winver.h>

1 ICON "../assets/recomplauncher/icon.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,1,2,0
PRODUCTVERSION  1,1,2,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Neguchads\0"
            VALUE "FileDescription",  "Castlevania: Dawn of Sorrow: Recompiled\0"
            VALUE "FileVersion",      "1.1.2.0\0"
            VALUE "InternalName",     "CastlevaniaDawnOfSorrow\0"
            VALUE "OriginalFilename", "CastlevaniaDawnOfSorrow.exe\0"
            VALUE "ProductName",      "Castlevania: Dawn of Sorrow: Recompiled\0"
            VALUE "ProductVersion",   "1.1.2\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
